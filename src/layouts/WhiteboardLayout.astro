---
import '../styles/whiteboard.css';
import { getLang, useTranslations, type Lang } from '../i18n/ui';
import SeoHead from '../components/shared/SeoHead.astro';
import archivoUrl from '../assets/fonts/whiteboard/archivo-latin-var.woff2?url';
import kalamUrl from '../assets/fonts/whiteboard/kalam-700-latin.woff2?url';
import caveatUrl from '../assets/fonts/whiteboard/caveat-latin-var.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** This page in each language (default: the home pages). */
  alternates?: Record<Lang, string>;
  /** Canonical route path (defaults to the localized homepage). */
  canonical?: string;
  /** Add full entity & FAQ structured data to the home pages. */
  homepage?: boolean;
  /** Keep page out of search engines and without language alternates. */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <SeoHead
      title={Astro.props.title}
      description={Astro.props.description}
      alternates={Astro.props.alternates}
      canonical={Astro.props.canonical}
      homepage={Astro.props.homepage}
      noindex={Astro.props.noindex}
      themeColor="#ffffff"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kalamUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={caveatUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-paper focus:px-4 focus:py-2">{t.skip}</a>
    <slot />
  </body>
</html>
