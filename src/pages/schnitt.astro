---
/**
 * Design exploration "Schnitt durch die Schule" (German only, not indexed):
 * the same content as the homepage, told as a walk through a section cut of a school.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import SchnittHero from '../components/schnitt/SchnittHero.astro';
import SchnittJourney from '../components/schnitt/SchnittJourney.astro';
import People from '../components/People.astro';
import VSProducts from '../components/VSProducts.astro';
import ClosingTestimonial from '../components/ClosingTestimonial.astro';
import ProjectPhases from '../components/ProjectPhases.astro';
import Contact from '../components/Contact.astro';
import { asset, homeFor } from '../lib/paths';

const alternates = { de: asset('schnitt/'), it: homeFor('it') };
---

<Layout title="Trias Schule | Variante Schnitt" noindex canonical={asset('schnitt/')} alternates={alternates}>
  <Navbar inPage alternates={alternates} />
  <main id="inhalt">
    <SchnittHero />
    <SchnittJourney />
    <People />
    <VSProducts />
    <ClosingTestimonial />
    <ProjectPhases />
    <Contact />
  </main>
  <Footer inPage />
</Layout>
