---
/** Design variant "Der Raumplaner": the visitor furnishes a classroom on a live plan, and the plan becomes the inquiry. */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import PlanerTable from '../components/planer/PlanerTable.astro';
import PlanerExamples from '../components/planer/PlanerExamples.astro';
import PlanerPeople from '../components/planer/PlanerPeople.astro';
import PlanerContact from '../components/planer/PlanerContact.astro';
import PlanerVS from '../components/planer/PlanerVS.astro';
import { asset, homeFor } from '../lib/paths';

const alternates = { de: asset('leistungsverzeichnis/'), it: homeFor('it') };
---

<Layout title="Trias Schule | Der Raumplaner" noindex canonical={asset('leistungsverzeichnis/')} alternates={alternates} variantSwitcher>
  <Navbar inPage alternates={alternates} />
  <main id="inhalt">
    <PlanerTable />
    <PlanerExamples />
    <PlanerPeople />
    <PlanerVS />
    <PlanerContact />
  </main>
  <Footer inPage />
</Layout>
