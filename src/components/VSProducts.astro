---
import { vs } from '../data/site';
import VSChair from './art/VSChair.astro';

const categories = [
  { name: 'Sitzen', text: 'Stühle und Hocker, auf denen man sich bewegen kann.' },
  { name: 'Tische', text: 'Einzel- und Gruppentische, die sich schnell umstellen lassen.' },
  { name: 'Stauraum', text: 'Schränke und Regale, die auch als Raumteiler dienen.' },
  { name: 'Flexible Lernlandschaften', text: 'Möbel für offene Bereiche, die im Laufe des Tages unterschiedlich genutzt werden.' },
  { name: 'Kindergarten', text: 'Möbel und Stauraum in Kinderhöhe.' },
];
---

<section id="vs-moebel" class="vs py-28 lg:py-40" aria-labelledby="vs-title" data-vs>
  <div class="shell">
    <div class="vs-grid">
      <div class="vs-head">
        <h2 id="vs-title" class="text-[clamp(2.4rem,5vw,4.75rem)] leading-[0.98] tracking-[-0.045em]">Möbel für Lernräume in Bewegung.</h2>
        <p class="mt-7 max-w-[48ch] text-[1.08rem] leading-[1.65] text-muted">
          Wir sind die Exklusivvertretung von VS Möbel in Südtirol. Hier sehen Sie eine Auswahl, das ganze Sortiment finden Sie bei VS.
        </p>
      </div>

      <div class="vs-stage">
        <div class="vs-sticky">
          <div class="vs-chair" data-vs-chair>
            <VSChair id="vs-chair" class="block w-full" />
          </div>
          <p class="mt-4 text-[0.82rem] text-muted">Schulstuhl von VS in Ginstergelb · schematische Darstellung</p>
        </div>
      </div>

      <div class="vs-list">
        <ul class="border-t border-ink">
          {categories.map((c) => (
            <li class="border-b border-line" data-cat>
              <a class="cat group" href={vs.catalogUrl} target="_blank" rel="noopener">
                <span class="cat-dot" aria-hidden="true"></span>
                <span class="min-w-0">
                  <span class="block text-[clamp(1.6rem,2.6vw,2.4rem)] font-semibold leading-[1.05] tracking-[-0.035em]">{c.name}</span>
                  <span class="mt-2 block text-[0.95rem] text-muted">{c.text}</span>
                </span>
                <svg class="cat-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 14L14 6M7 6h7v7" /></svg>
                <span class="sr-only">(öffnet vs.de in neuem Tab)</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <a class="btn btn-ink self-start" href={vs.catalogUrl} target="_blank" rel="noopener">
            Gesamtes VS Sortiment entdecken
            <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
          </a>
          <p class="text-[0.92rem] font-medium">Exklusivvertretung VS Möbel in Südtirol</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vs-grid { display: grid; gap: 56px; }
  .vs-chair { width: min(62vw, 300px); transform: translateX(var(--shift, 0px)); }

  .cat {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) 24px;
    align-items: start;
    gap: 18px;
    padding: 26px 0;
  }
  .cat-dot {
    width: 9px;
    height: 9px;
    margin-top: 0.85em;
    border-radius: 50%;
    border: 1px solid var(--color-ink);
    transition: background-color 250ms var(--ease-draw), border-color 250ms var(--ease-draw);
  }
  .cat-arrow { width: 22px; height: 22px; margin-top: 0.35em; transition: transform 250ms var(--ease-draw); }
  .cat:hover .cat-arrow { transform: translate(3px, -3px); }
  .cat:hover .cat-dot, [data-cat].is-current .cat-dot { background: var(--color-ginster); border-color: var(--color-ginster); }

  @media (min-width: 1024px) {
    .vs-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); row-gap: 88px; }
    .vs-head { grid-column: 1 / 8; }
    .vs-stage { grid-column: 1 / 6; grid-row: 2; }
    .vs-sticky { position: sticky; top: calc(var(--nav-h) + 8vh); }
    .vs-chair { width: min(100%, 360px); margin-left: 8%; }
    .vs-list { grid-column: 7 / 13; grid-row: 2; }
  }
</style>

<script>
  import { addScene, viewProgress } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-vs]');
  const chair = section?.querySelector<HTMLElement>('[data-vs-chair]');
  if (section && chair) {
    addScene({
      el: section,
      media: '(min-width: 1024px)',
      progress: viewProgress(1, -0.6),
      render: (p) => chair.style.setProperty('--shift', `${((p - 0.5) * 36).toFixed(1)}px`),
    });
  }

  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-current', e.isIntersecting)),
      { rootMargin: '-48% 0px -48% 0px' },
    );
    rows.forEach((r) => io.observe(r));
  }
</script>
