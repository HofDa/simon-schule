---
/** VS as the toolkit: the PantoSwing drawn in elevation, rocking with the scroll, and the categories as a schedule. */
import { vs } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';
import VSChair from './art/VSChair.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).vs;
// a category links out only once it has its own deep link into the VS catalogue (open fact)
const categories: { name: string; text: string; url?: string }[] = t.categories;
const catalogUrl = vs.catalogUrl[lang];
---

<section id="vs-moebel" class="vs sheet-paper" aria-labelledby="vs-title" data-vs>
  <div class="shell vs-grid">
    <header class="vs-head">
      <h2 id="vs-title" class="vs-title display">{t.title}</h2>
      <p class="vs-intro">{t.intro}</p>
    </header>

    <figure class="vs-stage m-0">
      <div class="vs-chair" data-vs-chair>
        <VSChair id="vs-chair" class="block w-full" />
      </div>
      <figcaption class="vs-caption">{t.caption}</figcaption>
    </figure>

    <div class="vs-list">
      <ul>
        {categories.map((c) => (
          <li>
            {c.url ? (
              <a class="cat cat-link" href={c.url} target="_blank" rel="noopener">
                <span class="cat-name">{c.name}</span>
                <span class="cat-text">{c.text}</span>
                <svg class="cat-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 14L14 6M7 6h7v7" /></svg>
                <span class="sr-only">{t.newTab}</span>
              </a>
            ) : (
              <div class="cat">
                <span class="cat-name">{c.name}</span>
                <span class="cat-text">{c.text}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn-ink vs-cta" href={catalogUrl} target="_blank" rel="noopener">
        {t.all}
        <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg>
        <span class="sr-only">{t.newTab}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .vs { padding-block: clamp(104px, 12vw, 176px); }
  .vs-grid { display: grid; gap: 56px; }
  .vs-title { font-size: var(--text-headline); max-width: 14ch; }
  .vs-intro { margin-top: 24px; max-width: 46ch; color: var(--color-muted); font-size: var(--text-lead); line-height: 1.5; }

  .vs-chair { width: min(70vw, 340px); }
  .vs-caption { margin-top: 20px; font-size: var(--text-label); color: var(--color-muted); }

  .vs-list ul { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--color-ink); }
  .vs-list li { border-bottom: 1px solid var(--color-line); }
  .cat { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 22px 0; }
  .cat-name { font-size: var(--text-title); font-variation-settings: "wdth" 112; font-weight: 650; letter-spacing: -0.03em; line-height: 1.05; }
  .cat-text { font-size: var(--text-meta); color: var(--color-muted); max-width: 44ch; }
  .cat-link { grid-template-columns: minmax(0, 1fr) 24px; }
  .cat-link .cat-text { grid-column: 1; }
  .cat-arrow { grid-column: 2; grid-row: 1; width: 22px; height: 22px; align-self: center; transition: transform 250ms var(--ease-draw); }
  .cat-link:hover .cat-arrow { transform: translate(3px, -3px); }
  .vs-cta { margin-top: 40px; }

  @media (min-width: 768px) {
    .cat { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; column-gap: 32px; }
    .cat-link { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 24px; }
    .cat-link .cat-text { grid-column: 2; }
    .cat-arrow { grid-column: 3; }
  }

  @media (min-width: 1024px) {
    .vs-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); row-gap: 96px; }
    .vs-head { grid-column: 1 / span 7; }
    .vs-stage { grid-column: 1 / span 4; grid-row: 2; position: sticky; top: calc(var(--nav-h) + 10vh); align-self: start; }
    .vs-chair { width: min(100%, 360px); }
    .vs-list { grid-column: 6 / span 7; grid-row: 2; }
  }
</style>

<script>
  import { addScene } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-vs]');
  const chair = section?.querySelector<HTMLElement>('[data-vs-chair]');
  if (section && chair) {
    // the PantoSwing rocks forward and back once while the section passes, and comes to rest upright
    addScene({
      el: section,
      progress: (rect, vh) => (vh - rect.top) / (rect.height + vh * 0.2),
      render(p) {
        const swing = Math.sin(p * Math.PI * 2.5) * 5 * (1 - p);
        chair.style.setProperty('--swing', swing.toFixed(3));
      },
    });
  }
</script>
