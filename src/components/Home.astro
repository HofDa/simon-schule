---
/** The homepage, shared by the German (/) and Italian (/it/) routes. */
import Layout from '../layouts/Layout.astro';
import Navbar from './shared/Navbar.astro';
import Footer from './shared/Footer.astro';
import Hero from './Hero.astro';
import Chain from './Chain.astro';
import Projects from './Projects.astro';
import People from './People.astro';
import VSProducts from './VSProducts.astro';
import ClosingTestimonial from './ClosingTestimonial.astro';
import ProjectPhases from './ProjectPhases.astro';
import Contact from './Contact.astro';
---

<Layout homepage>
  <Navbar />
  <main id="inhalt">
    <Hero />
    <Chain />
    <Projects />
    <People />
    <VSProducts />
    <ClosingTestimonial />
    <ProjectPhases />
    <Contact />
  </main>
  <Footer />
</Layout>
