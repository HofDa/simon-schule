---
/** The main site, used for the German design variant and the Italian page. */
import Layout from '../layouts/Layout.astro';
import Navbar from './shared/Navbar.astro';
import Footer from './shared/Footer.astro';
import Hero from './Hero.astro';
import Chain from './Chain.astro';
import Projects from './Projects.astro';
import People from './People.astro';
import VSProducts from './VSProducts.astro';
import ClosingTestimonial from './ClosingTestimonial.astro';
import ProjectPhases from './ProjectPhases.astro';
import Contact from './Contact.astro';
import { asset, homeFor } from '../lib/paths';

interface Props {
  variant?: boolean;
}

const variant = Astro.props.variant ?? false;
const alternates = { de: asset('masskette/'), it: homeFor('it') };
---

<Layout
  homepage={!variant}
  title={variant ? 'Trias Schule | Die Maßkette' : undefined}
  canonical={variant ? asset('masskette/') : undefined}
  alternates={variant ? alternates : undefined}
  noindex={variant}
>
  <Navbar inPage={variant} alternates={variant ? alternates : undefined} />
  <main id="inhalt">
    <Hero />
    <Chain />
    <Projects />
    <People />
    <VSProducts />
    <ClosingTestimonial />
    <ProjectPhases />
    <Contact />
  </main>
  <Footer inPage={variant} />
</Layout>
