---
import ServiceChair, { type ChairModel } from './art/ServiceChair.astro';
import { getLang, useTranslations } from '../../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).services;
const chairModels: ChairModel[] = ['pantomove', 'pantoswing', 'jumper-air', 'jumper-ply', 'bambino'];
const services = lang === 'de' ? [
  { title: 'Beratung', text: 'Wir kommen zu Ihnen, hören zu und schauen uns Ihre Räume und den Alltag vor Ort an.' },
  { title: 'Planung', text: 'Gemeinsam entwickeln wir die Raumaufteilung und Einrichtung für Ihre Schule oder Ihren Kindergarten.' },
  { title: 'VS Möbel', text: 'Wir wählen passende Tische, Stühle und Stauraumlösungen aus dem Sortiment von VS.' },
  { title: 'Lieferung & Montage', text: 'Wir kümmern uns um Bestellung, Lieferung und Montage – bis alles an seinem Platz steht.' },
  { title: 'Betreuung', text: 'Auch danach sind wir für Fragen, Ergänzungen und neue Ideen für Sie da. Direkt hier in Südtirol.' },
] : t.items;
---

<section id="leistungen" class="services relative z-20" aria-labelledby="services-title" data-service-chairs>
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.currentScript?.parentElement?.classList.add('has-chair-motion');
    }
  </script>
  <div class="shell services-stage" data-service-stage>
    <h2 id="services-title" class="sr-only">{lang === 'de' ? 'Unsere Leistungen' : 'I nostri servizi'}</h2>
    <ol class="service-chairs">
      {services.map((service, index) => (
        <li class="service" data-service-card>
          <div class="service-chair" aria-hidden="true" data-service-chair>
            <ServiceChair model={chairModels[index]} />
          </div>
          <div class="service-copy" data-service-copy>
            <span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    --services-space: clamp(80px, 9vw, 144px);
    margin-top: calc(-1 * var(--chair-peek));
    padding-bottom: var(--services-space);
    overflow-x: clip;
  }

  .services-stage { position: relative; }
  .services.is-sequence { height: calc(var(--service-stage-h) + var(--service-travel) + var(--services-space)); }
  .services.is-sequence .services-stage { position: sticky; top: calc(var(--nav-h) + 32px); }

  .service-chairs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(20px, 2.8vw, 44px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service { min-width: 0; }

  .service-chair {
    width: min(100%, 200px);
    margin-inline: auto;
  }

  .has-chair-motion .service-chair {
    opacity: var(--chair-opacity, 0);
    transform: translate3d(var(--chair-x, 110vw), 0, 0);
    animation: service-motion-fallback 1ms 8s forwards;
  }
  .has-chair-motion .service:first-child .service-chair { --chair-x: -110vw; }
  .has-chair-motion .service-copy {
    opacity: var(--copy-opacity, 0);
    transform: translate3d(0, var(--copy-y, 16px), 0);
    animation: service-motion-fallback 1ms 8s forwards;
  }
  .has-chair-motion.is-motion-ready .service-chair,
  .has-chair-motion.is-motion-ready .service-copy { animation: none; }
  @keyframes service-motion-fallback { to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .has-chair-motion .service-chair,
    .has-chair-motion .service-copy { opacity: 1; transform: none; animation: none; }
  }

  .service-chair :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .service-copy { margin-top: clamp(24px, 3vw, 40px); }

  .service-number {
    display: block;
    margin-bottom: 12px;
    color: var(--color-muted);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  h3 {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .service-copy p {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    h3 { min-height: 2.24em; }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .service-chairs { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 56px; }
    .service-chair { width: min(100%, 180px); }
  }

  @media (max-width: 639px) {
    .service-chairs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px 24px; }
    .service-chair { width: min(100%, 160px); }
    .service-copy { margin-top: 24px; }
    h3 { font-size: 1.45rem; }
    .service-copy p { margin-top: 12px; font-size: 0.95rem; }
    .service:last-child { grid-column: 1 / -1; width: calc((100% - 24px) / 2); justify-self: center; }
  }
</style>

<script>
  import '../../scripts/service-chairs';
</script>
