---
import { getProjects } from '../../data/projects';
import { getLang, useTranslations } from '../../i18n/ui';
import ProjectPhoto from './ProjectPhoto.astro';
import claims from './art/claim-strokes.json';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const [a, b, c] = getProjects(lang);

// The claim is written by hand (Kalam), letter by letter, as one quick marker gesture: the whole
// line takes about WRITE seconds in any language. Delays are computed here so the pacing is
// slightly uneven (like a hand) but identical on every load.
const headline = t.hero.headline;
const WRITE = 0.48;
const LETTER = 0.08; // each letter's own wipe
const WORD_GAP = 0.035;
const parts = headline.split(' ');
const letterCount = parts.join('').length;
const PER_LETTER = Math.max(0.006, (WRITE - LETTER - (parts.length - 1) * WORD_GAP) / letterCount);
let clock = 0;
const words = parts.map((word, wi) => {
  const letters = [...word].map((char, ci) => {
    const delay = clock;
    clock += PER_LETTER * (1 + (((wi * 7 + ci * 13) % 5) - 2) * 0.18);
    return { char, delay: delay.toFixed(3) };
  });
  clock += WORD_GAP;
  return letters;
});

// Where the claim has pen strokes (tools/handwriting/claim.py), it is written stroke by stroke: each
// Kalam letter is revealed through a marker pen that follows its centreline, dots come after the word.
type Claim = {
  width: number; height: number; pen: number; duration: number;
  underline: { x0: number; x1: number; line: number };
  glyphs: { outline: string; x: number; baseline: number; pen: { d: string; delay: number; dur: number }[] }[];
};
const claim = (claims as Record<string, Claim>)[headline];
// the drawing box, in font units (1000 = 1em), with room for the overhanging strokes and the underline
const box = claim && { x: -120, y: -60, w: claim.width + 240, h: claim.height + 120 };
const underlineD = claim && (() => {
  const { x0, x1, line } = claim.underline;
  const w = x1 - x0;
  const top = (line + 1) * 1000 - 180;
  const pt = (px: number, py: number) => `${(x0 - 0.02 * w + (px / 300) * w).toFixed(1)} ${(top + (py / 16) * 160).toFixed(1)}`;
  return `M${pt(4, 10)} C${pt(60, 5)} ${pt(130, 12)} ${pt(190, 8)} S${pt(270, 6)} ${pt(296, 9)}`;
})();

const writeDuration = claim ? claim.duration : clock - WORD_GAP + LETTER;

// The board is prepared in the order it should be read: the claim is written alone, the offer rises
// under its underline, the prints are pinned up one by one, and the chair (ServicesStory) rolls in last. All in seconds from page load; on :root so the chair shares it.
const T_CLAIM = 0.1;
const T_AFTER = T_CLAIM + writeDuration; // end of the writing: the underline is drawn
const T_OFFER = T_AFTER; // subline and buttons
const T_IMAGES = T_AFTER + 0.25; // first print; the next ones follow PIN_STEP apart
const PIN_STEP = 0.16;
const T_CHAIR = T_IMAGES + 3 * PIN_STEP + 0.2; // the chair starts rolling; it comes into view about half a second later
const timeline = {
  'hero-write': writeDuration,
  't-claim': T_CLAIM,
  't-after': T_AFTER,
  't-offer': T_OFFER,
  't-images': T_IMAGES,
  'pin-step': PIN_STEP,
  't-chair': T_CHAIR,
};
const timelineCss = Object.entries(timeline).map(([k, v]) => `--${k}:${v.toFixed(2)}s`).join(';');
---

<Fragment set:html={`<style>:root{${timelineCss}}</style>`} />
<section id="top" class="hero relative pt-[calc(var(--nav-h)+8px)]" aria-labelledby="hero-title">
  <div class="shell">
    <div class="board relative">
      <div class="board-surface relative h-full">
        <div class="relative grid h-full lg:block">
          <!-- copy -->
          <div class="hero-copy relative z-10 pt-7 pb-6 lg:absolute lg:left-0 lg:top-0 lg:w-[38.2%] lg:pt-[calc(var(--board-h)*0.1)]">
            <h1 id="hero-title" class="hero-title">
              <span class="sr-only">{headline}</span>
              {claim && box ? (
              <span class="handwriting" aria-hidden="true">
                <svg
                  class="claim"
                  viewBox={`${box.x} ${box.y} ${box.w} ${box.h}`}
                  style={`--w: ${box.w / 1000}em; --h: ${box.h / 1000}em; --x: ${box.x / 1000}em; --y: ${box.y / 1000}em`}
                >
                  <defs>
                    {claim.glyphs.map((g, i) => (
                      <mask id={`claim-pen-${i}`} maskUnits="userSpaceOnUse" x={box.x} y={box.y} width={box.w} height={box.h}>
                        {g.pen.map((s) => (
                          <path class="pen" d={s.d} pathLength="1" stroke-width={claim.pen} style={`--pd: ${s.delay}s; --pt: ${s.dur}s`} />
                        ))}
                      </mask>
                    ))}
                  </defs>
                  {claim.glyphs.map((g, i) => (
                    <g mask={`url(#claim-pen-${i})`}>
                      <path d={g.outline} transform={`translate(${g.x} ${g.baseline}) scale(1 -1)`} />
                    </g>
                  ))}
                  <path class="claim-underline" d={underlineD} pathLength="1" />
                </svg>
              </span>
              ) : (
              <span class="handwriting" aria-hidden="true">
                {words.map((letters, wi) => (
                  <>
                    <span class={`word${wi === words.length - 1 ? ' word-last' : ''}`}>
                      {letters.map((l) => <span class="ch" style={`--cd: ${l.delay}s`}>{l.char}</span>)}
                      {wi === words.length - 1 && (
                        <svg class="hand-underline" viewBox="0 0 300 16" preserveAspectRatio="none">
                          <path pathLength="1" d="M4 10 C60 5 130 12 190 8 S270 6 296 9" />
                        </svg>
                      )}
                    </span>{' '}
                  </>
                ))}
              </span>
              )}
            </h1>
            <p class="rise mt-7 max-w-[38ch] text-body leading-[1.6] text-muted sm:text-lead" style="--d: 0s">
              {t.hero.subShort}
            </p>
            <div class="rise mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d: 0.08s">
              <a href="#projekte" class="btn btn-ink">
                {t.hero.primary}
                <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4" /></svg>
              </a>
              <a href="#anfrage" class="link-line text-meta font-semibold" data-open-form>{t.hero.secondary}</a>
            </div>
          </div>

          <!-- pinned photos -->
          <div class="pins relative lg:absolute lg:inset-0 lg:m-0 lg:h-auto">
            <ProjectPhoto project={a} class="pin-a" sizes="(min-width: 1520px) 460px, (min-width: 1024px) 33vw, 62vw" priority />
            <ProjectPhoto project={b} class="pin-b" sizes="(min-width: 1520px) 176px, (min-width: 1024px) 13vw, 48vw" />
            <ProjectPhoto project={c} class="pin-c hidden lg:block" sizes="(min-width: 1520px) 284px, 21vw" />
          </div>
        </div>
      </div>
      <!-- the marker tray, with the pen that wrote the claim -->
      <div class="tray" aria-hidden="true">
        <svg class="pen-marker" viewBox="0 0 96 14">
          <rect x="0" y="2" width="70" height="10" rx="3" fill="var(--color-ginster)" />
          <rect x="66" y="1" width="26" height="12" rx="4" fill="var(--color-ink)" />
          <rect x="91" y="4.5" width="5" height="5" rx="1.5" fill="var(--color-ink)" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .board {
    /* one screen less the nav and room for the marker tray under the board */
    --board-h: clamp(600px, calc(100svh - var(--nav-h) - 60px), 1000px);
  }
  /* The hero is exactly one screen at any size, so only the top of the chair's shell shows at the
     fold and scrolling reveals the rest. Desktop centres the board in it; on phones the picture wall
     takes the height the copy leaves and the prints scale to it (very short screens grow past it). */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  @media (min-width: 1024px) {
    .hero { justify-content: center; }
  }
  @media (max-width: 1023px) {
    .hero > :global(.shell),
    .board,
    .board-surface,
    .board-surface > div {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
    }
    .pins {
      /* a zero basis: with auto, Chrome resolves the container's cqh against its (empty) content */
      flex: 1 1 0;
      /* below this the prints get too small to read; short phones scroll to the chair instead */
      min-height: 236px;
      margin-bottom: calc(var(--chair-peek) + 16px);
      container-type: size;
      /* size containment lets the turned prints widen the page: clip sideways, with room for their edges */
      overflow-x: clip;
      overflow-clip-margin: 16px;
    }
  }
  @media (min-width: 1024px) {
    .board {
      height: var(--board-h);
      /* the prints are composed for a board of about golden proportions: on wide,
         short screens they keep that shape, anchored right, instead of stretching into each other */
      --frame-w: min(100%, calc(var(--board-h) * 1.66));
    }
    .pins { left: auto; right: 0; width: var(--frame-w); }
  }

  /* The whiteboard: a slim aluminium frame around a white enamel surface with a faint sheen, and a
     marker tray along the bottom edge. Nothing else: the claim, the offer and the prints are on it. */
  .board {
    --frame: 7px;
    position: relative;
    padding: var(--frame);
    border-radius: 6px;
    background: linear-gradient(180deg, #eceeef, #d3d6d8);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(0, 0, 0, 0.06),
      0 1px 2px rgba(32, 32, 29, 0.08),
      0 24px 48px -36px rgba(32, 32, 29, 0.4);
  }
  .board-surface {
    padding: 4px 18px 0;
    border-radius: 3px;
    background:
      linear-gradient(112deg, transparent 38%, rgba(255, 255, 255, 0.75) 46%, transparent 56%),
      #f9faf9;
    box-shadow: inset 0 0 0 1px rgba(32, 32, 29, 0.05), inset 0 2px 5px rgba(32, 32, 29, 0.05);
  }
  .tray {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -12px;
    height: 12px;
    border-radius: 0 0 4px 4px;
    background: linear-gradient(180deg, #e2e5e6, #c3c7ca);
    box-shadow: 0 6px 10px -6px rgba(32, 32, 29, 0.35);
  }
  .pen-marker {
    position: absolute;
    right: 9%;
    bottom: 7px;
    width: 84px;
    height: auto;
    transform: rotate(-2deg);
  }
  @media (min-width: 1024px) {
    .board { --frame: 9px; }
    .board-surface { padding: clamp(24px, 2.4vw, 44px) clamp(28px, 3.2vw, 60px); }
  }

  /* pins: mobile */
  .pins :global(.pin-a) { left: 0; top: 10%; width: min(64%, calc((58cqh - 40px) / 0.75)); transform: rotate(-1.5deg); }
  .pins :global(.pin-b) { right: 0; top: 46%; width: min(48%, calc((50cqh - 40px) / 0.75)); transform: rotate(2deg); }
  @media (min-width: 1024px) {
    /* Golden grid (φ ≈ 1.618). The board is close to a golden rectangle.
       A (33%) is centred on the golden point 61.8% / 38.2%; C = A/φ sits on 76.4% / 76.4%;
       B = C/φ sits top right. The text column is 38.2% wide; the chair rests below it on the same left edge. */
    .pins :global(.pin-a) { left: 45.3%; top: 17.7%; width: 33%; transform: rotate(-1.2deg); }
    .pins :global(.pin-b) { left: 81.9%; right: auto; top: 6.8%; width: 12.6%; transform: rotate(2.5deg); }
    .pins :global(.pin-c) { left: 66.2%; top: 63.7%; width: 20.4%; transform: rotate(1.2deg); }
  }

  .hero-title {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(2.9rem, min(5.4vw, 9.4vh), 5.8rem);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }
  .handwriting { display: block; transform: rotate(-1.5deg); transform-origin: 0 100%; }
  .word { display: inline-block; white-space: nowrap; position: relative; }
  .ch { display: inline-block; }
  .claim {
    display: block;
    width: var(--w);
    height: var(--h);
    /* the overhang around the two 1em lines stays outside the layout */
    margin: var(--y) 0 var(--y) var(--x);
    overflow: visible;
    fill: currentColor;
  }
  .claim .pen {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .claim-underline {
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .hand-underline {
    position: absolute;
    left: -2%;
    bottom: 0.02em;
    width: 100%;
    height: 0.16em;
    overflow: visible;
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rise {
      animation: hero-rise 320ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 0s) + var(--t-offer));
    }
    /* each letter is wiped in left to right, like a marker stroke */
    :global(html.js) .ch {
      animation: write-letter 80ms linear both;
      animation-delay: calc(var(--t-claim) + var(--cd));
    }
    /* the marker on the board: each stroke drawn at pen speed, a little slower into the turns */
    :global(html.js) .claim .pen {
      stroke-dasharray: 1 1;
      animation: pen-write var(--pt) cubic-bezier(0.35, 0.1, 0.55, 1) both;
      animation-delay: calc(var(--t-claim) + var(--pd));
    }
    :global(html.js) .claim-underline,
    :global(html.js) .hand-underline path {
      animation: underline 400ms var(--ease-draw) both;
      animation-delay: calc(var(--t-after) - 0.05s);
    }
    .pins :global(.pin-a) { --pin-d: var(--t-images); }
    .pins :global(.pin-b) { --pin-d: calc(var(--t-images) + var(--pin-step)); }
    .pins :global(.pin-c) { --pin-d: calc(var(--t-images) + 2 * var(--pin-step)); }
    :global(html.js) .pins :global(.pin) {
      animation: pin-in 380ms var(--ease-draw) both;
      animation-delay: var(--pin-d, 0.35s);
    }
    :global(html.js) .pins :global(.magnet) {
      animation: magnet-in 220ms var(--ease-draw) both;
      animation-delay: calc(var(--pin-d, 0s) + 0.18s);
    }
  }

  @keyframes write-letter {
    from { clip-path: inset(-0.3em 100% -0.3em -0.2em); }
    to { clip-path: inset(-0.3em -0.2em -0.3em -0.2em); }
  }
  /* hidden before its turn: a round cap would otherwise show as a dot at the stroke's start */
  @keyframes pen-write {
    from { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes underline {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  /* a print laid onto the board: it comes down a little, settles flat, then the magnet holds it */
  @keyframes pin-in {
    from { opacity: 0; translate: 0 -14px; scale: 1.035; }
    40% { opacity: 1; }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }
  @keyframes magnet-in {
    from { opacity: 0; scale: 0.6; }
    to { opacity: 1; scale: 1; }
  }
</style>
