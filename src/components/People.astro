---
/**
 * The two people, on a Ginstergelb sheet: their names at the scale of a title block,
 * what is still open about them said once, and the questions they ask first.
 */
import { contact, fullName, people, type Person } from '../data/site';
import { asset } from '../lib/paths';
import { getLang, useTranslations } from '../i18n/ui';

const ui = useTranslations(getLang(Astro.currentLocale));
const t = ui.people;

const openFacts = (p: Person) =>
  [!p.lastName && ui.pendingFields.lastName, !p.role && ui.pendingFields.role, !p.phone && ui.pendingFields.phone].filter(
    (f): f is string => Boolean(f),
  );
const sharedMail = people.some((p) => !p.email);
---

<section id="menschen" class="people sheet-ginster" aria-labelledby="people-title" data-people>
  <div class="shell">
    <header class="pe-head">
      <h2 id="people-title" class="pe-title display">{t.title}</h2>
      <p class="pe-intro">{t.intro}</p>
    </header>

    <div class="pe-names">
      {people.map((person, i) => {
        const open = openFacts(person);
        return (
          <article class="pe-person" data-person style={`--dir:${i % 2 ? -1 : 1}`}>
            {person.photo && (
              <img
                class="pe-portrait"
                src={asset(`images/team/${person.photo}.webp`)}
                alt={t.portraitAlt(fullName(person))}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            )}
            <h3 class="pe-name display">{fullName(person)}</h3>
            <div class="pe-facts">
              {person.role && <p>{person.role}</p>}
              {open.length > 0 && <p class="open-fact">{ui.pending(open)}</p>}
              {person.phone && <p><a class="link-line" href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a></p>}
              {person.email && <p><a class="link-line" href={`mailto:${person.email}`}>{person.email}</a></p>}
            </div>
          </article>
        );
      })}
    </div>

    <div class="pe-foot">
      {sharedMail && (
        <p class="pe-mail">
          {t.reachBoth} <a class="link-line font-semibold" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      )}
      <div class="pe-questions">
        <h3 class="pe-q-label">{t.questionsLabel}</h3>
        <ul>
          {t.questions.map((q) => <li>{q}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .people { padding-block: clamp(104px, 12vw, 176px); overflow: hidden; }
  .pe-head { display: grid; gap: 24px; }
  .pe-title { font-size: var(--text-headline); max-width: 15ch; }
  .pe-intro { max-width: 44ch; color: var(--color-on-ginster); font-size: var(--text-lead); line-height: 1.5; }

  .pe-names { margin-top: clamp(56px, 7vw, 104px); border-top: 1.5px solid var(--color-ink); }
  .pe-person {
    display: grid;
    gap: 12px;
    padding-block: clamp(20px, 2.6vw, 36px);
    border-bottom: 1.5px solid var(--color-ink);
  }
  .pe-name {
    font-size: clamp(2.6rem, 9.2vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    transform: translateX(calc(var(--dir) * var(--shift, 0) * 1vw));
  }
  @media (min-width: 640px) { .pe-name { white-space: nowrap; } }
  .pe-facts { display: flex; flex-wrap: wrap; gap: 6px 28px; font-size: var(--text-meta); color: var(--color-on-ginster); }
  .pe-portrait { width: 160px; aspect-ratio: 4 / 5; object-fit: cover; }

  .pe-foot { margin-top: clamp(48px, 6vw, 88px); display: grid; gap: 48px; }
  .pe-mail { font-size: var(--text-lead); }
  .pe-q-label { font-size: var(--text-meta); font-weight: 600; letter-spacing: 0; }
  .pe-questions ul { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--color-ink); }
  .pe-questions li {
    padding: 14px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 35%, transparent);
    font-size: var(--text-lead);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (min-width: 1024px) {
    .pe-head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: end; }
    .pe-title { grid-column: 1 / span 8; }
    .pe-intro { grid-column: 9 / span 4; padding-bottom: 0.4em; }
    .pe-person { grid-template-columns: 1fr auto; align-items: end; }
    .pe-facts { flex-direction: column; align-items: flex-end; text-align: right; padding-bottom: 0.9em; }
    .pe-foot { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); }
    .pe-mail { grid-column: 1 / span 5; }
    .pe-questions { grid-column: 7 / span 6; }
  }
</style>

<script>
  import { addScene } from '../scripts/motion';

  const names = document.querySelector<HTMLElement>('[data-people] .pe-names');
  if (names) {
    // the two names slide toward each other into their rows as the sheet passes
    addScene({
      el: names,
      progress: (rect, vh) => (vh - rect.top) / (vh + rect.height * 0.2),
      render(p) {
        names.style.setProperty('--shift', ((1 - p) * 9).toFixed(2));
      },
    });
  }
</script>
