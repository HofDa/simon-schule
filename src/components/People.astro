---
import { contact, fullName, people } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';
import StandingFigure from './art/StandingFigure.astro';

const t = useTranslations(getLang(Astro.currentLocale)).people;
const questions = t.questions;
---

<section id="menschen" class="people relative bg-paper py-28 lg:py-40" aria-labelledby="people-title" data-people>
  <!-- the drawn route arrives from the projects stage above and ends here -->
  <span class="people-route" aria-hidden="true"></span>
  <div class="shell">
    <div class="max-w-[60rem]">
      <h2 id="people-title" class="text-[clamp(2.4rem,5vw,4.75rem)] leading-[0.98] tracking-[-0.045em]">
        {t.title}
      </h2>
      <p class="mt-7 max-w-[52ch] text-[1.08rem] leading-[1.65] text-muted">
        {t.intro}
      </p>
    </div>

    <div class="people-grid mt-20 lg:mt-28">
      {people.map((person, i) => (
        <article class={`person person-${i === 0 ? 'a' : 'b'}`} data-person>
          <div class="portrait">
            <StandingFigure class="figure" label={t.portraitLabel(fullName(person))} />
            <span class="tag-placeholder absolute left-4 top-4">{t.portraitPending}</span>
          </div>
          <div class="mt-6">
            <h3 class="text-[1.6rem] tracking-[-0.03em]">
              {person.firstName} {person.lastName ?? <span class="open-fact text-[0.8em] font-normal tracking-normal">{t.lastNamePending}</span>}
            </h3>
            <p class="mt-1.5 text-muted">{person.role ?? <span class="open-fact">{t.rolePending}</span>}</p>
            <ul class="mt-5 space-y-1.5 text-[0.95rem]">
              <li>{person.phone ? <a class="link-line" href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a> : <span class="open-fact">{t.phonePending}</span>}</li>
              <li>
                {person.email ? (
                  <a class="link-line" href={`mailto:${person.email}`}>{person.email}</a>
                ) : (
                  <a class="link-line" href={`mailto:${contact.email}`}>{contact.email}</a>
                )}
              </li>
            </ul>
          </div>
        </article>
      ))}

      <div class="notes" aria-label={t.questionsLabel}>
        <span class="notes-line" aria-hidden="true"></span>
        <ul>
          {questions.map((q, i) => (
            <li class="note marker" style={`--i: ${i}`} data-note>{q}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .people-route { display: none; }
  /* only when the projects stage above is pinned: continue its line at the same x (see ProjectTransition: endX) */
  :global(.transition.is-scrub) ~ .people .people-route {
    display: block;
    position: absolute;
    top: 0;
    right: calc(var(--gutter) + 40px - var(--leg-w) / 2);
    width: var(--leg-w);
    height: clamp(72px, 10vw, 128px);
    background: var(--color-ginster);
    transform-origin: top;
    transform: scaleY(var(--route, 1));
  }
  :global(.transition.is-scrub) ~ .people .people-route::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--color-ink);
    opacity: var(--route-end, 1);
  }
  .people-grid { display: grid; gap: 64px; }
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    overflow: hidden;
  }
  .portrait :global(.figure) {
    position: absolute;
    left: 50%;
    bottom: 0;
    height: 74%;
    width: auto;
    aspect-ratio: 200 / 520;
    transform: translateX(-50%);
    color: #d3cfc4;
  }

  .notes { position: relative; }
  .notes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .note {
    font-size: clamp(1.55rem, 2.1vw, 2rem);
    color: #2b2b27;
    line-height: 1.1;
  }
  .note:nth-child(odd) { transform: rotate(-1.2deg); }
  .note:nth-child(even) { transform: rotate(0.8deg); padding-left: 1.2em; }
  .notes-line { display: none; }

  @media (min-width: 1024px) {
    .people-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: start; }
    .person-a { grid-column: 1 / 5; grid-row: 1; }
    .person-b { grid-column: 9 / 13; grid-row: 1; margin-top: 140px; }
    .notes { grid-column: 5 / 9; grid-row: 1; padding: 80px 0 0 clamp(20px, 3vw, 48px); align-self: stretch; }
    .notes-line { display: block; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--color-line); }
    .notes ul { gap: 40px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .person {
      opacity: 0;
      translate: var(--from, -18px) 0;
      transition: opacity 900ms var(--ease-draw), translate 900ms var(--ease-draw);
    }
    :global(html.js) .person-b { --from: 18px; transition-delay: 120ms; }
    :global(html.js) .person.is-in { opacity: 1; translate: 0 0; }
    :global(html.js) .note {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transition: opacity 500ms var(--ease-draw), clip-path 700ms var(--ease-draw);
      transition-delay: calc(var(--i) * 260ms + 200ms);
    }
    :global(html.js) .notes.is-in .note { opacity: 1; clip-path: inset(-10% -5% -10% 0); }
  }
</style>

<script>
  import { addScene, range, revealOnce, viewProgress } from '../scripts/motion';
  revealOnce(document.querySelectorAll('[data-person], .notes'));

  // the line coming down from the projects finishes drawing as the section arrives
  const people = document.querySelector<HTMLElement>('[data-people]');
  if (people) {
    addScene({
      el: people,
      progress: viewProgress(1, 0.55),
      render: (p) => {
        people.style.setProperty('--route', String(range(p, 0, 0.8)));
        people.style.setProperty('--route-end', p >= 0.8 ? '1' : '0');
      },
    });
  }
</script>
