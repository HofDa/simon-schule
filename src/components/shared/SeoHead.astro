---
/**
 * Shared technical SEO & GEO `<head>` metadata for all layouts.
 * Centralizes canonicals, reciprocal hreflang (`de-IT`, `de`, `it-IT`, `it`, `x-default`),
 * robots directives, regional geo metadata, Open Graph & Twitter cards, sitemap & llms.txt
 * discovery links, SVG/PNG favicons, web manifest, and JSON-LD structured data.
 */
import { asset, homeFor } from '../../lib/paths';
import { getLang, useTranslations, type Lang } from '../../i18n/ui';
import { buildStructuredData, hreflangEntries } from '../../lib/seo';

interface Props {
  title?: string;
  description?: string;
  alternates?: Record<Lang, string>;
  canonical?: string;
  homepage?: boolean;
  noindex?: boolean;
  themeColor?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title = t.meta.title,
  description = t.meta.description,
  homepage = false,
  noindex = false,
  themeColor = '#ffffff',
} = Astro.props;

const alternates = Astro.props.alternates ?? { de: homeFor('de'), it: homeFor('it') };
const site = Astro.site;
const absolute = (path: string) => (site ? new URL(path, site).href : path);
const canonicalPath = Astro.props.canonical ?? homeFor(lang);
const canonical = site ? absolute(canonicalPath) : undefined;
const socialImage = site ? absolute(asset('images/social-preview.jpg')) : undefined;
const logoImage = site ? absolute(asset('images/trias-schule-logo.png')) : undefined;
const socialImageAlt =
  lang === 'it'
    ? 'Spazio di apprendimento aperto con tavoli, sedie e aree di lavoro'
    : 'Offene Lernlandschaft mit Tischgruppen und verschiedenen Arbeitsbereichen';
const geoPlacename =
  lang === 'it' ? 'Merano, Bressanone, Alto Adige' : 'Meran, Brixen, Südtirol';
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const hreflangs = !noindex ? hreflangEntries(alternates, absolute) : [];
const structuredData = !noindex
  ? buildStructuredData({
      site,
      lang,
      canonicalPath,
      title,
      description,
      socialImage,
      socialImageAlt,
      logoImage,
      homepage,
    })
  : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="author" content="Trias Schule · Trias KG der Anders GmbH" />
<meta name="theme-color" content={themeColor} />
<meta name="geo.region" content="IT-BZ" />
<meta name="geo.placename" content={geoPlacename} />
<meta name="geo.position" content="46.6669;11.1528" />
<meta name="ICBM" content="46.6669, 11.1528" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={t.ogLocale} />
<meta property="og:locale:alternate" content={lang === 'de' ? 'it_IT' : 'de_IT'} />
<meta property="og:site_name" content="Trias Schule" />
<meta property="og:type" content="website" />
{canonical && <link rel="canonical" href={canonical} />}
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:secure_url" content={socialImage} />}
{socialImage && <meta property="og:image:width" content="1200" />}
{socialImage && <meta property="og:image:height" content="630" />}
{socialImage && <meta property="og:image:type" content="image/jpeg" />}
{socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
{socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
{hreflangs.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
{!noindex && site && <link rel="sitemap" type="application/xml" href={absolute(asset('sitemap.xml'))} />}
{!noindex && site && <link rel="alternate" type="text/plain" href={absolute(asset('llms.txt'))} title="LLM Summary (llms.txt)" />}
{!noindex && site && <link rel="alternate" type="text/plain" href={absolute(asset('llms-full.txt'))} title="LLM Full Context (llms-full.txt)" />}
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
<link rel="icon" type="image/png" sizes="48x48" href={asset('favicon-48x48.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
<link rel="manifest" href={asset('site.webmanifest')} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{structuredData && <script type="application/ld+json" set:html={structuredData}></script>}
