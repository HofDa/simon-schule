---
/**
 * The Trias Schule logo, served from a single optimized external SVG sprite:
 * "Trias" in ginstergelb (or currentColor when `mono`), the handwritten chalk "Schule"
 * in currentColor so it reads as ink on paper and light on dark surfaces.
 */
import { asset } from '../../lib/paths';

interface Props {
  class?: string;
  /** Accessible name; omit when the surrounding link or heading already names it. */
  label?: string;
  /** One colour throughout, for ginstergelb backgrounds. */
  mono?: boolean;
}
const { class: className = '', label, mono = false } = Astro.props;
const spriteHref = `${asset('images/trias-schule-logo.svg')}#mark`;
---

<svg
  class:list={['logo', { 'logo--mono': mono }, className]}
  viewBox="-2 88 612 102"
  width="612"
  height="102"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <use href={spriteHref} />
</svg>

<style>
  .logo {
    display: block;
    height: 1em;
    width: auto;
    overflow: visible;
    --logo-trias: var(--color-ginster);
  }
  .logo--mono { --logo-trias: currentColor; }
</style>
