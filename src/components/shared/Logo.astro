---
/**
 * The Trias Schule logo, traced from the header logo on trias-schule.it:
 * "Trias" in ginstergelb, the handwritten chalk "Schule" in the current text colour,
 * so it reads as ink on paper and light on the dark footer.
 */
interface Props {
  class?: string;
  /** Accessible name; omit when the surrounding link or heading already names it. */
  label?: string;
  /** One colour throughout, for ginstergelb backgrounds. */
  mono?: boolean;
}
const { class: className = '', label, mono = false } = Astro.props;
