---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'srcset' | 'sizes'> & {
  src: ImageMetadata;
  alt: string;
  width?: number;
  widths?: number[];
  sizes?: string;
  quality?: number;
  avif?: boolean;
  avifQuality?: number;
  desktopOnly?: boolean;
};

const {
  src, width, widths, sizes, quality = 82, avif = true, avifQuality = 55,
  desktopOnly = false, ...attributes
} = Astro.props;
const [webp, preferred] = await Promise.all([
  getImage({ src, width, widths, format: 'webp', quality }),
  avif ? getImage({ src, width, widths, format: 'avif', quality: avifQuality }) : undefined,
]);
// An inline fallback lets the browser skip every desktop image on a narrow screen,
// including eager images. Matching <source> elements handle viewport changes natively.
const placeholder = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg"/%3E';
const media = desktopOnly ? '(min-width: 1024px)' : undefined;
---

<picture style="display: contents">
  {preferred && <source type="image/avif" media={media} srcset={preferred.srcSet.attribute || preferred.src} sizes={sizes} />}
  <source type="image/webp" media={media} srcset={webp.srcSet.attribute || webp.src} sizes={sizes} />
  <img {...webp.attributes} {...attributes} src={desktopOnly ? placeholder : webp.src} decoding="async" />
</picture>
