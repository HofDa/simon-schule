---
/** "Das Whiteboard": the claim is written on a board, project prints are pinned up, chairs roll in and a ruled line leads through the projects. German-only variant at /whiteboard/. */
import Layout from '../../layouts/WhiteboardLayout.astro';
import Navbar from './shared/Navbar.astro';
import Footer from './shared/Footer.astro';
import WhiteboardHero from './WhiteboardHero.astro';
import ServicesStory from './ServicesStory.astro';
import ProjectTransition from './ProjectTransition.astro';
import Projects from './Projects.astro';
import People from './People.astro';
import VSProducts from './VSProducts.astro';
import ClosingTestimonial from '../ClosingTestimonial.astro';
import ProjectPhases from './ProjectPhases.astro';
import ContactScene from './ContactScene.astro';
import { asset, homeFor } from '../../lib/paths';

const alternates = { de: asset('whiteboard/'), it: homeFor('it') };
---

<Layout title="Trias Schule | Das Whiteboard" canonical={asset('whiteboard/')} alternates={alternates} noindex variantSwitcher>
  <Navbar alternates={alternates} />
  <main id="inhalt">
    <WhiteboardHero />
    <ServicesStory />
    <ProjectTransition>
      <Projects />
    </ProjectTransition>
    <People />
    <VSProducts />
    <ClosingTestimonial />
    <ProjectPhases />
    <ContactScene />
  </main>
  <Footer />
</Layout>
