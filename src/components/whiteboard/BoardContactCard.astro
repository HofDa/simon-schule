---
/**
 * The contact corner of the whiteboard: Simon's business card, pinned to the board by the
 * compact Trias HOUSE70 souvenir fridge magnet (drag by the magnet like every board object).
 * Name, role, e-mail and phone come from src/data/site.ts; a missing phone number or portrait
 * is simply left out (the portrait gives way to a hand-written initials stamp).
 * "Projekt anfragen" opens the same enquiry form as the board's main call to action.
 */
import { getImage } from 'astro:assets';
import ResponsiveImage from './ResponsiveImage.astro';
import house70Magnet from '../../assets/whiteboard/house70-fridge-magnet-natural.webp';
import { contact, people, fullName } from '../../data/site';
import { asset } from '../../lib/paths';
import { getLang } from '../../i18n/ui';
import { lernraumCopy } from '../../i18n/lernraum';

const { responsive = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const B = lernraumCopy(lang).board;
const C = B.card;

const house70Mask = await getImage({ src: house70Magnet, width: 240, format: 'webp' });
const person = people[0];
const name = fullName(person);
const initials = [person.firstName, person.lastName].filter(Boolean).map((n) => n![0]).join('');
const role = person.role?.[lang];
const directPhone = person.phone ?? contact.phone;
const phoneHref = directPhone ? `tel:${directPhone.replace(/[^\d+]/g, '')}` : null;
---

<div class="board-object object-card" data-board-object>
  <div class="card-house70-magnet">
    <span class="magnet-body">
      <ResponsiveImage
        desktopOnly={!responsive}
        avif={false}
        src={house70Magnet}
        alt={B.house.alt}
        width={240}
        widths={[120, 180, 240, 360]}
        sizes="(max-width: 1023px) 84px, (max-height: 800px) 88px, 112px"
        quality={90}
        loading="eager"
        draggable="false"
      />
      <span class="magnet-gloss" style={`--magnet-mask: url(${house70Mask.src})`} aria-hidden="true"></span>
    </span>
    <button
      class="house70-handle"
      type="button"
      data-board-handle
      data-label={C.magnet}
      aria-label={B.house.move}
      aria-describedby="board-drag-hint"
      title={B.house.title}
    ></button>
  </div>
  <span class="card-lead-note" aria-hidden="true">{C.leadNote}</span>
  <svg class="card-lead-arrow" data-card-arrow viewBox="0 0 64 36" fill="none" aria-hidden="true">
    <path data-card-arrow-shaft d="M4 22 Q28 4 56 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    <path data-card-arrow-head d="M46 11 L57 18.5 L47 26" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <div class="business-card" data-path-node="5">
    <p class="card-eyebrow">{C.eyebrow}</p>
    <div class="card-person">
      {person.photo ? (
        <img class="card-photo" src={asset(`images/team/${person.photo}.webp`)} alt={C.portrait(name)} width="80" height="100" loading="eager" draggable="false" />
      ) : (
        <span class="card-stamp" aria-hidden="true">{initials}</span>
      )}
      <div>
        <p class="card-name">{name}</p>
        {role && <p class="card-role">{role}</p>}
        <p class="card-note">{C.note}</p>
      </div>
    </div>
    <div class="card-actions">
      <div class="card-lines">
        {person.email && <a href={`mailto:${person.email}`} draggable="false"><span aria-hidden="true">✉</span> {person.email}</a>}
        {phoneHref && <a href={phoneHref} draggable="false"><span aria-hidden="true">☏</span> {directPhone}</a>}
      </div>
      <a class="card-cta" href="#anfrage" data-open-form draggable="false">{C.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<style>
  .object-card { right: 3.5%; left: auto; top: 53%; width: clamp(268px, min(28.5cqw, 46cqh), 410px); rotate: -0.8deg; }

  /* Compact HOUSE70 fridge magnet pinning the top edge of Simon's card */
  .card-house70-magnet {
    position: absolute;
    top: 0;
    left: 55%;
    z-index: 6;
    width: clamp(82px, min(7.2cqw, 11.5cqh), 112px);
    min-height: 44px;
    translate: -50% -66%;
    rotate: 3.5deg;
  }
  .card-house70-magnet :global(img) {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    user-select: none;
    filter:
      drop-shadow(1.2px 0 0 #fbf7ec) drop-shadow(-1.2px 0 0 #fbf7ec) drop-shadow(0 1.2px 0 #fbf7ec) drop-shadow(0 -1.2px 0 #fbf7ec)
      drop-shadow(0 1.2px 0 #d6cfbd) drop-shadow(.5px 1.4px 0 #34332f)
      drop-shadow(2px 6px 4px #20201d45);
  }
  .card-house70-magnet:has(.house70-handle:is(:hover, :focus-visible)) .magnet-body { translate: 0 -2px; }
  .card-house70-magnet:has(.house70-handle:is(:hover, :focus-visible)) .magnet-gloss { background-position: 0 0; }
  .object-card.is-dragging .card-house70-magnet .magnet-body { translate: 0 -4px; }

  .card-lead-note {
    position: absolute;
    right: calc(100% + 1.2cqw);
    top: 12%;
    font-family: var(--font-marker);
    font-size: clamp(14px, min(1.3cqw, 2.5cqh), 20px);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: #5c5a52;
    rotate: -5deg;
    pointer-events: none;
  }
  .card-lead-arrow {
    position: absolute;
    right: calc(100% + 0.3cqw);
    top: 26%;
    width: clamp(32px, 3.2cqw, 48px);
    height: auto;
    color: var(--color-ginster-deep);
    overflow: visible;
    pointer-events: none;
    rotate: 6deg;
    transform-origin: 8% 60%;
  }

  /* a business card: white card stock, a Ginstergelb edge on the left, a soft shadow */
  .business-card {
    position: relative;
    width: 100%;
    padding: 2.5cqh 1.3cqw 1.7cqh 1.6cqw;
    background: #fffefb;
    box-shadow: inset 5px 0 0 var(--color-ginster), 0 18px 36px -14px rgba(32, 32, 29, 0.34);
    color: var(--color-ink);
    text-align: left;
  }
  .card-eyebrow { font-size: clamp(9px, .72cqw, 11px); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-ginster-deep); }
  .card-person { display: flex; align-items: center; gap: 1cqw; margin-top: 1cqh; }
  .card-stamp {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(46px, 4.4cqw, 66px);
    aspect-ratio: 1;
    border: 2px solid var(--color-ginster);
    border-radius: 50%;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: clamp(20px, 1.9cqw, 30px);
    font-weight: 700;
    rotate: -8deg;
  }
  .card-photo { flex: none; width: clamp(46px, 4.4cqw, 66px); aspect-ratio: 4 / 5; height: auto; object-fit: cover; border-radius: 2px; }
  .card-name { font-size: clamp(16px, min(1.45cqw, 2.9cqh), 23px); font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
  .card-role { margin-top: 3px; font-size: clamp(10px, .78cqw, 12px); line-height: 1.35; color: #6e6c65; }
  .card-note { margin-top: 4px; font-family: var(--font-marker); font-size: clamp(17px, min(1.4cqw, 2.8cqh), 22px); font-weight: 600; line-height: 1; color: #22305f; }

  .card-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin-top: 1.2cqh; padding-top: 1cqh; }
  .card-lines { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .card-lines a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; font-size: clamp(11px, .85cqw, 13px); font-weight: 600; color: var(--color-ink); text-decoration: underline; text-decoration-color: #d9d5c9; text-underline-offset: 3px; overflow-wrap: anywhere; }
  @media (pointer: coarse) {
    .card-lines a { min-height: 44px; }
  }
  .card-lines a:hover { text-decoration-color: var(--color-ginster); }
  .card-lines a span { color: var(--color-ginster-deep); text-decoration: none; }
  .card-cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 3px;
    background: var(--color-ginster);
    color: var(--color-ink);
    font-size: clamp(12px, .95cqw, 14px);
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 8px 18px -8px rgba(184, 132, 0, 0.6);
    transition: background-color 150ms ease, translate 150ms ease, box-shadow 150ms ease;
  }
  .card-cta::after {
    content: '';
    position: absolute;
    inset: -40% -25%;
    background: linear-gradient(110deg, transparent 36%, rgba(255, 255, 255, 0.55) 50%, transparent 64%);
    transform: translateX(-115%);
    pointer-events: none;
  }
  .card-cta span { display: inline-block; color: var(--color-ink); transition: translate 200ms ease; }
  .card-cta:hover { background: var(--color-ginster-light); translate: 0 -2px; box-shadow: 0 12px 22px -8px rgba(184, 132, 0, 0.8); }
  .card-cta:hover span { translate: 4px 0; }
  .card-lines a:focus-visible, .card-cta:focus-visible { outline: 2px dashed var(--color-ginster-deep); outline-offset: 3px; }

  /* Hovering Simon's card beckons attention toward the CTA button */
  @media (hover: hover) and (pointer: fine) {
    .object-card:not(.is-dragging) .business-card:hover .card-cta {
      background: var(--color-ginster-light);
      translate: 0 -1.5px;
      box-shadow: 0 12px 22px -8px rgba(184, 132, 0, 0.8), 0 0 0 3px rgba(226, 163, 0, 0.22);
    }
    .object-card:not(.is-dragging) .business-card:hover .card-cta span {
      translate: 3px 0;
    }
    .object-card:not(.is-dragging) .business-card:hover .card-cta:hover {
      translate: 0 -2.5px;
      box-shadow: 0 14px 24px -8px rgba(184, 132, 0, 0.9), 0 0 0 3px rgba(226, 163, 0, 0.28);
    }
    .object-card:not(.is-dragging) .business-card:hover .card-cta:hover span {
      translate: 5px 0;
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .object-card:not(.is-dragging) .business-card:hover .card-cta {
      animation: card-cta-nudge 640ms cubic-bezier(.22, 1.25, .36, 1) both;
    }
    .object-card:not(.is-dragging) .business-card:hover .card-cta::after {
      animation: card-cta-sheen 720ms cubic-bezier(.22, .8, .2, 1) 60ms both;
    }
    .object-card:not(.is-dragging) .business-card:hover .card-cta span {
      animation: card-cta-arrow 700ms cubic-bezier(.22, 1, .36, 1) 80ms both;
    }
  }
  @keyframes card-cta-nudge {
    0% { transform: scale(1); }
    40% { transform: scale(1.045); }
    72% { transform: scale(0.99); }
    100% { transform: scale(1); }
  }
  @keyframes card-cta-sheen {
    from { transform: translateX(-115%); }
    to { transform: translateX(115%); }
  }
  @keyframes card-cta-arrow {
    0% { transform: translateX(0); }
    38% { transform: translateX(4px); }
    64% { transform: translateX(-1px); }
    100% { transform: translateX(0); }
  }

  /* narrow boards: stay safely anchored to the right edge */
  @container (max-width: 1050px) {
    .object-card { right: 3%; left: auto; top: 54%; width: clamp(256px, 28cqw, 300px); }
    .card-lead-note, .card-lead-arrow { right: calc(100% + 0.5cqw); }
  }

  /* wide boards: keep Simon's card balanced with the rest of the bottom row instead of hugging the right edge */
  @container (min-width: 1450px) {
    .object-card { left: 67.5%; right: auto; top: 58%; }
  }

  @media (max-height: 800px) {
    .object-card { top: 53.5%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-cta, .card-cta span { transition: none; }
  }
</style>
