---
/**
 * The project collages on the whiteboard: one stack of prints held by a round magnet, in the board's
 * upper right corner. The stack shuffles itself: every few seconds the top print slides aside and is
 * tucked underneath, and the magnet's icon follows the kind of building on top (pencil, music note,
 * book). A click on the top print opens the gallery at that project, and the gallery browses all
 * projects. The caption leads to the projects section. Data: src/data/collages.ts; behaviour: src/scripts/board-collages.ts.
 */
import { getImage } from 'astro:assets';
import ResponsiveImage from './ResponsiveImage.astro';
import { collagesFor } from '../../data/collages';
import { getLang } from '../../i18n/ui';
import { lernraumCopy } from '../../i18n/lernraum';

const { responsive = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const copy = lernraumCopy(lang);
const G = copy.board.collages;
const galleryCta = copy.projects.galleryCta;
const collages = collagesFor(lang);

// each print keeps its own slight tilt, so the stack looks handled, not aligned
const tilts = [-2.4, 1.6, -1.1, 2.3, -1.8, 0.9, -2.8, 1.9, -0.6, 2.7];
// three stacks by kind of building, side by side in the board's upper right corner
const groupOf: Record<string, string> = {
  'gs-gais': 'gs', 'gs-deflorian-meran': 'gs', 'gs-sarnthein': 'gs', 'gs-st-jakob': 'gs', 'gs-st-martin-gsies': 'gs', 'gs-riffian': 'gs',
  'ms-lana': 'ms', 'ms-sterzing': 'ms', 'musikschule-brixen': 'ms',
  'kiga-tisens': 'kb', 'bibliothek-terlan': 'kb',
};
const groups = (['gs', 'ms', 'kb'] as const).map((key) => ({ key, name: G.groups[key] })).map((g) => ({ ...g, items: collages.filter((c) => (groupOf[c.slug] ?? 'gs') === g.key) }));
// the gallery runs through the projects group by group
const ordered = groups.flatMap((g) => g.items);
// the stack deals them round-robin, so the kind of building changes from print to print
const dealt = Array.from({ length: Math.max(...groups.map((g) => g.items.length)) }, (_, i) => groups.flatMap((g) => (g.items[i] ? [{ ...g.items[i], group: g.key }] : []))).flat();
const openLabel = (c: (typeof collages)[number]) => G.open(c.name, c.photos.length);
const words = { view: G.view('{n}'), photo: G.photo, photos: G.photos, project: G.project, credit: lang === 'de' ? 'Fotos' : 'Foto', prev: G.prev, next: G.next, prevProject: G.prevProject, nextProject: G.nextProject };

// Defer the gallery's ~150 hidden <picture> nodes out of initial HTML; board-collages.ts builds
// each project's slides and thumbnails on demand when the dialog opens.
const useAvif = !import.meta.env.DEV;
const galleryData = await Promise.all(
  ordered.map(async (c) => {
    const [projThumb, photos] = await Promise.all([
      getImage({ src: c.collage, width: 320, widths: [160, 320], format: 'webp', quality: 70 }),
      Promise.all(
        c.photos.map(async (p) => {
          const [webp, avif, thumb] = await Promise.all([
            getImage({ src: p.image, widths: [640, 960, 1280, 1600, 2000], format: 'webp', quality: 82 }),
            useAvif ? getImage({ src: p.image, widths: [640, 960, 1280, 1600, 2000], format: 'avif', quality: 55 }) : undefined,
            getImage({ src: p.image, width: 240, widths: [120, 240], format: 'webp', quality: 70 }),
          ]);
          return {
            alt: p.alt,
            ...(p.vs?.length ? { vs: p.vs } : {}),
            src: webp.src,
            w: webp.attributes.width,
            h: webp.attributes.height,
            webp: webp.srcSet.attribute || webp.src,
            ...(avif ? { avif: avif.srcSet.attribute || avif.src } : {}),
            thumb: thumb.src,
            thumbSet: thumb.srcSet.attribute || thumb.src,
          };
        }),
      ),
    ]);
    return {
      slug: c.slug,
      name: c.name,
      credit: c.credit ?? '',
      highlight: copy.projects.referenceHighlights[c.slug] ?? '',
      collage: projThumb.src,
      collageSet: projThumb.srcSet.attribute || projThumb.src,
      photos,
    };
  }),
);
const galleryJson = JSON.stringify(galleryData).replace(/</g, '\\u003c');
---

<div class="board-object object-projects" data-board-object data-collages data-path-node="2" data-top-group={dealt[0].group}>
  <button class="stack-magnet" type="button" data-board-handle data-label={G.projects} aria-label={G.move(G.projects)} aria-describedby="board-drag-hint" title={G.moveTitle}>
    <svg viewBox="0 0 60 60" aria-hidden="true">
      <defs>
        <radialGradient id="sm-face" cx=".4" cy=".35" r=".7">
          <stop offset="0" stop-color="#f8d362" />
          <stop offset="1" stop-color="#e2a300" />
        </radialGradient>
        <linearGradient id="sm-gloss" x1="0" y1="0" x2="1" y2="1">
          <stop offset=".25" stop-color="#fff" stop-opacity="0" />
          <stop offset=".4" stop-color="#fff" stop-opacity=".55" />
          <stop offset=".5" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <clipPath id="sm-clip"><circle cx="30" cy="30" r="26" /></clipPath>
      </defs>
      <!-- the magnet's thickness: dark magnetic backing, then the ivory edge -->
      <circle cx="30.6" cy="33.2" r="27.6" fill="#34332f" />
      <circle cx="30" cy="31.6" r="27.6" fill="#d6cfbd" />
      <!-- the face with its ivory rim -->
      <circle cx="30" cy="30" r="26" fill="url(#sm-face)" stroke="#fbf7ec" stroke-width="3.2" />
      <g class="sm-icon" fill="none" stroke="#2c2b28" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <!-- a pencil -->
        <g data-icon="gs">
          <path d="M19 41L21 34L37 18L42 23L26 39Z" fill="#fbf7ec" />
          <path d="M33 22L38 27M19 41L21 34L26 39Z" />
          <path d="M19 41L21 34L26 39Z" fill="#2c2b28" />
        </g>
        <!-- two joined music notes -->
        <g data-icon="ms">
          <path d="M25 39V19L40 16V36" />
          <ellipse cx="21.5" cy="39.5" rx="4.2" ry="3.2" fill="#2c2b28" transform="rotate(-18 21.5 39.5)" />
          <ellipse cx="36.5" cy="36.5" rx="4.2" ry="3.2" fill="#2c2b28" transform="rotate(-18 36.5 36.5)" />
          <path d="M25 24L40 21" />
        </g>
        <!-- an open book -->
        <g data-icon="kb">
          <path d="M30 22Q24 18 16 19V39Q24 38 30 42Q36 38 44 39V19Q36 18 30 22Z" fill="#fbf7ec" />
          <path d="M30 22V42M20 25Q24 25 27 27M20 30Q24 30 27 32M33 27Q36 25 40 25M33 32Q36 30 40 30" stroke-width="1.6" />
        </g>
      </g>
      <g clip-path="url(#sm-clip)">
        <rect class="sm-gloss" x="-60" y="0" width="120" height="60" fill="url(#sm-gloss)" />
      </g>
    </svg>
  </button>
  <div class="collage-stack" data-collage-stack>
    {dealt.map((c, i) => (
      <figure class="print" data-collage-print data-slug={c.slug} data-name={c.name} data-group={c.group} data-open-label={openLabel(c)} data-depth={i < 3 ? String(i) : 'deep'} style={`--pos: ${i}; --tilt: ${tilts[i % tilts.length]}deg`} aria-hidden={i === 0 ? undefined : 'true'}>
        <template data-collage-image>
          <ResponsiveImage desktopOnly={!responsive} src={c.collage} alt={c.alt} width={960} widths={[360, 540, 720, 960]} sizes="(max-width: 1023px) 80vw, (max-height: 800px) 360px, 30vw" loading="eager" draggable="false" />
        </template>
        {i === 0 && <noscript><ResponsiveImage desktopOnly={!responsive} src={c.collage} alt={c.alt} width={960} widths={[360, 540, 720, 960]} sizes="(max-width: 1023px) 80vw, (max-height: 800px) 360px, 30vw" loading="eager" draggable="false" /></noscript>}
        <figcaption><span>{c.name}</span><span class="print-group">{G.groups[c.group]}</span></figcaption>
      </figure>
    ))}
    <button type="button" class="collage-open" data-collage-open aria-haspopup="dialog" aria-label={openLabel(dealt[0])}>
      <span class="collage-open-hint" aria-hidden="true" data-collage-open-hint>{G.view(dealt[0].photos.length)}</span>
    </button>
  </div>
  <div class="collage-actions">
    <a class="board-object-link collage-link" href="#projekte" data-board-topic="projekte" draggable="false">
      <span class="object-caption">{G.all} <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</div>

<dialog class="gallery" aria-labelledby="gallery-title" data-gallery data-words={JSON.stringify(words)}>
  <header class="gallery-header">
    <p id="gallery-title" class="gallery-title" data-gallery-title></p>
    <span class="gallery-count" data-gallery-count aria-live="polite"></span>
    <span class="gallery-highlight" data-gallery-highlight></span>
    <span class="gallery-credit" data-gallery-credit></span>
    <div class="gallery-header-actions">
      <a href="#anfrage" class="gallery-inquire" data-gallery-inquire data-open-form data-topic="">
        <span>{galleryCta}</span>
        <span class="gallery-inquire-arrow" aria-hidden="true">→</span>
      </a>
      <button type="button" class="gallery-close" data-gallery-close aria-label={G.close}>×</button>
    </div>
  </header>
  <div class="gallery-stage" data-gallery-stage>
    <div class="gallery-sets" data-gallery-sets></div>
    <button type="button" class="gallery-step gallery-prev" data-gallery-step="-1" aria-label={G.prev}><span class="step-arrow" aria-hidden="true">‹</span><span class="step-project" data-step-project aria-hidden="true"></span></button>
    <button type="button" class="gallery-step gallery-next" data-gallery-step="1" aria-label={G.next}><span class="step-project" data-step-project aria-hidden="true"></span><span class="step-arrow" aria-hidden="true">›</span></button>
  </div>
  <footer class="gallery-footer">
    <div class="gallery-thumbs-wrap" data-gallery-thumbs-wrap></div>
    <nav class="gallery-projects" data-gallery-projects aria-label={G.projects}></nav>
  </footer>
  <script type="application/json" data-gallery-data set:html={galleryJson}></script>
</dialog>

<style>
  /* one stack in the upper right of the board */
  .object-projects { --print-h: min(29cqh, 17cqw); left: 55%; top: 6%; width: auto; rotate: -1.5deg; }
  @container (max-width: 1120px) {
    .object-projects { --print-h: min(25cqh, 15.5cqw); left: 52%; }
  }
  /* the magnet holds the whole stack, so it sits above every print */
  /* a round button magnet holds each stack; its icon names the kind of building. It is the drag handle. */
  .stack-magnet {
    position: absolute;
    top: -24px;
    left: calc(50% - 23px);
    z-index: 300;
    width: 46px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: none;
    filter: drop-shadow(1px 5px 4px #20201d40);
    transition: translate 160ms ease, filter 160ms ease;
  }
  .stack-magnet { rotate: -6deg; }
  /* the magnet's icon names the kind of building on top of the stack */
  .sm-icon [data-icon] { opacity: 0; transition: opacity 260ms ease; }
  .object-projects[data-top-group='gs'] .sm-icon [data-icon='gs'],
  .object-projects[data-top-group='ms'] .sm-icon [data-icon='ms'],
  .object-projects[data-top-group='kb'] .sm-icon [data-icon='kb'] { opacity: 1; }
  .stack-magnet svg { display: block; width: 100%; height: auto; overflow: visible; }
  .sm-gloss { transition: transform 700ms cubic-bezier(.2, .8, .2, 1); }
  .stack-magnet:hover, .stack-magnet:focus-visible { translate: 0 -2px; filter: drop-shadow(2px 8px 5px #20201d4d); }
  .stack-magnet:hover .sm-gloss, .stack-magnet:focus-visible .sm-gloss { transform: translateX(60px); }
  .stack-magnet:focus-visible { outline: 2px dashed var(--color-ginster-deep); outline-offset: 4px; }
  .object-projects.is-dragging .stack-magnet { translate: 0 -4px; }

  .collage-stack {
    position: relative;
    height: calc(var(--print-h) + 34px);
    width: calc(var(--print-h) * 1.5 + 14px);
  }

  /* one print: the collage on white photo paper with a strip for the hand-written label */
  .print {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 5px 5px 0;
    background: #fff;
    box-shadow: 0 3px 6px #20201d0a, 2px 12px 18px -12px #20201d70;
    z-index: calc(100 - var(--pos));
    transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--tilt)) scale(var(--lift, 1));
    transition: transform 380ms cubic-bezier(.2, .8, .2, 1), opacity 300ms ease, box-shadow 300ms ease;
  }
  .print :global(img) { display: block; width: 100%; height: var(--print-h); object-fit: cover; -webkit-user-drag: none; user-select: none; }
  .print figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 2px 0;
    font-family: var(--font-marker);
    font-size: clamp(13px, min(1.05cqw, 2.2cqh), 17px);
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }
  .print figcaption span:first-child { overflow: hidden; text-overflow: ellipsis; }
  /* only the top print's label is read; the ones underneath would overlap it */
  .print figcaption { transition: opacity 200ms ease; }
  .collage-stack :global(.print:not([data-depth='0'])) figcaption { opacity: 0; }
  .print-group { flex: none; font-family: var(--font-sans); font-size: .62em; font-weight: 600; color: var(--color-muted); }

  /* the stack: the two prints under the top one peek out, everything further down hides under them */
  .collage-stack :global(.print[data-depth='1']) { --dx: 2.5%; --dy: 2.5%; }
  .collage-stack :global(.print[data-depth='2']) { --dx: -2%; --dy: 4.5%; }
  .collage-stack :global(.print[data-depth='deep']) { --dx: -2%; --dy: 4.5%; box-shadow: none; opacity: 0; }
  /* the shuffle: the top print slides out to the side, then goes under the others */
  .collage-stack :global(.print.is-leaving) { --dx: 62%; --dy: -6%; --lift: 1.02; --tilt: 8deg; z-index: 150; transition-duration: 520ms; }

  /* hover on the top print: it lifts towards the viewer, ready to be picked up */
  .collage-stack:has(.collage-open:hover) :global(.print[data-depth='0']),
  .collage-stack:has(.collage-open:focus-visible) :global(.print[data-depth='0']) { --dy: -2%; --lift: 1.025; box-shadow: 0 3px 6px #20201d10, 4px 22px 26px -14px #20201d80; }

  /* hover / focus: the prints underneath fan out a little, showing there is more to see */
  .collage-stack:has(.collage-open:hover) :global(.print[data-depth='1']),
  .collage-stack:has(.collage-open:focus-visible) :global(.print[data-depth='1']) { --dx: 6%; --dy: 3%; }
  .collage-stack:has(.collage-open:hover) :global(.print[data-depth='2']),
  .collage-stack:has(.collage-open:focus-visible) :global(.print[data-depth='2']) { --dx: -5%; --dy: 6%; }


  .collage-open {
    position: absolute;
    inset: 0;
    z-index: 200;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .collage-open:focus-visible { outline: 3px solid var(--color-ginster-deep); outline-offset: 10px; }
  .collage-open-hint {
    position: absolute;
    right: 10px;
    top: calc(5px + var(--print-h) - 8px);
    translate: 0 -100%;
    padding: 5px 10px;
    border-radius: 2px;
    background: #1d1d1bd9;
    color: #fff;
    font-size: clamp(10px, .85cqw, 12px);
    font-weight: 600;
    white-space: nowrap;
    opacity: .92;
    transition: opacity 200ms ease, translate 200ms ease, background-color 200ms ease;
    pointer-events: none;
  }
  .collage-open:hover .collage-open-hint, .collage-open:focus-visible .collage-open-hint {
    opacity: 1;
    background: var(--color-ink);
    translate: 0 calc(-100% - 3px);
  }

  .collage-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    margin-top: calc(1.4cqh + 6px);
  }
  .collage-link { width: auto; }
  .collage-link .object-caption { font-family: var(--font-sans); font-size: clamp(11px, 1cqw, 15px); font-weight: 500; }

  /* the gallery: the photos on a dark wall, framed like the board */
  .gallery {
    position: fixed;
    inset: calc(var(--nav-h, 72px) + 8px) 28px 28px;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 8px solid #d5d9d7;
    border-radius: 7px;
    background: #1b1b19;
    color: #f4f3ee;
    overflow: hidden;
  }
  .gallery[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .gallery::backdrop { background: #f3f2edf2; }
  .gallery-header { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; min-height: 64px; padding: 10px 12px 10px 24px; }
  .gallery-title { font-family: var(--font-marker); font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; line-height: 1; color: #fff; }
  .gallery-count { font-size: 13px; font-weight: 600; letter-spacing: .06em; color: #a9a79e; font-variant-numeric: tabular-nums; }
  .gallery-highlight {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ginster-light);
    background: #ffffff14;
    padding: 3px 10px;
    border-radius: 3px;
  }
  .gallery-highlight:empty { display: none; }
  .gallery-header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .gallery-inquire {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 2px;
    background: var(--color-ginster);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 160ms ease;
  }
  .gallery-inquire:hover { background: var(--color-ginster-light); }
  .gallery-inquire-arrow { display: inline-block; transition: translate 180ms ease; }
  .gallery-inquire:hover .gallery-inquire-arrow { translate: 3px 0; }
  .gallery-inquire:focus-visible { outline: 2px solid var(--color-ginster-light); outline-offset: 2px; }
  .gallery-close { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: none; color: #fff; font-size: 30px; line-height: 1; cursor: pointer; }
  .gallery-close:hover { background: #ffffff1a; }

  .gallery-stage { position: relative; min-height: 0; overflow: hidden; touch-action: pan-y; }
  .gallery-sets { position: absolute; inset: 0; }
  .gallery :global(.gallery-set) { position: absolute; inset: 0; }
  .gallery :global(.gallery-set[hidden]), .gallery :global(.slide[hidden]), .gallery :global(.gallery-thumbs[hidden]) { display: none; }
  .gallery :global(.slide) {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: stretch;
    align-items: stretch;
    gap: 12px;
    margin: 0;
    padding: 8px clamp(72px, 10vw, 160px) 0;
  }
  .gallery :global(.slide picture) {
    display: block !important;
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .gallery :global(.slide img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    -webkit-user-drag: none;
    user-select: none;
  }
  /* Match the bright, colorful collage finish in full-size photos and their previews. */
  .gallery :global(.slide img), .gallery :global(.thumb img) { filter: brightness(1.04) contrast(1.02) saturate(1.14); }
  .gallery :global(.slide figcaption) {
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 74ch;
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
    color: #c9c7be;
  }
  .gallery :global(.slide-vs) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery :global(.slide-vs li) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 9px;
    border: 1px solid #ffffff1f;
    border-radius: 2px;
    background: #ffffff0d;
    color: #f4f3ee;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }
  .gallery :global(.slide-vs li::before) {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-ginster);
    flex: none;
  }

  .gallery-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    translate: 0 -50%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff14;
    color: #fff;
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .gallery-step:hover { background: #ffffff2e; }
  .gallery-prev { left: 16px; }
  .gallery-next { right: 16px; }
  .gallery-step span { translate: 0 -2px; }
  .gallery-close:focus-visible, .gallery-step:focus-visible, .gallery :global(.thumb:focus-visible) { outline: 2px solid var(--color-ginster-light); outline-offset: 3px; }

  .gallery-footer { display: flex; flex-direction: column; align-items: center; gap: 12px; min-width: 0; padding: 10px 24px 14px; }
  .gallery-thumbs-wrap { display: flex; justify-content: center; max-width: 100%; min-width: 0; }
  .gallery :global(.gallery-thumbs) { display: flex; gap: 8px; }
  .gallery :global(.thumb) {
    width: 76px;
    height: 54px;
    padding: 0;
    border: 0;
    border-radius: 3px;
    overflow: hidden;
    background: #2a2a27;
    opacity: .5;
    cursor: pointer;
    transition: opacity 150ms ease, translate 150ms ease;
  }
  .gallery :global(.thumb picture) { display: block !important; width: 100%; height: 100%; }
  .gallery :global(.thumb img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gallery :global(.thumb:hover) { opacity: .85; }
  .gallery :global(.thumb[aria-current='true']) { opacity: 1; translate: 0 -3px; box-shadow: 0 0 0 2px var(--color-ginster); }
  .gallery-credit { font-size: 11px; color: #8e8c83; }
  .gallery-credit:empty { display: none; }

  /* all projects: the collages as a strip; the current one is lit */
  .gallery-projects {
    display: flex;
    gap: 10px;
