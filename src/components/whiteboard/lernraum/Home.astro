---
/**
 * "Der Lernraum" – Streamlined, low-cognitive-load landing page:
 * - WhiteboardHero (interactive whiteboard with stroke-by-stroke claim, draggable magnets, photo collages & letters)
 * - AnnotatedProjects (#projekte: 234 South Tyrol proof bar + the real reference collages grouped by whiteboard magnet icons)
 * - InteractiveScenes (#lernformen: whiteboard-framed 3D/SVG room transformation)
 * - Services (#leistungen: 5 compact project steps + 3 pinned decision-maker role cards)
 * - VSFloorplan (#vs-moebel: pinned VS 2026 Catalog & Kitchen Magnet + 5 compact VS system tiles)
 * - FeedbackQuotes (#stimmen: 4 compact lined-paper customer letters with the speech-bubble magnet)
 * - TalkContact (#kontakt / #menschen / #anfrage: Simon's pinned card, HOUSE70 Meran & Brixen, FAQ drawer & low-friction form)
 */
import Layout from '../../../layouts/WhiteboardLayout.astro';
import Navbar from '../shared/Navbar.astro';
import Footer from '../shared/Footer.astro';
import WhiteboardHero from '../WhiteboardHero.astro';
import InteractiveScenes from './InteractiveScenes.astro';
import AnnotatedProjects from './AnnotatedProjects.astro';
import FeedbackQuotes from '../FeedbackQuotes.astro';
import Services from './Services.astro';
import VSFloorplan from './VSFloorplan.astro';
import TalkContact from './TalkContact.astro';
import { homeFor } from '../../../lib/paths';
import { getLang } from '../../../i18n/ui';

const lang = getLang(Astro.currentLocale);
const alternates = { de: homeFor('de'), it: homeFor('it') };
---

<Layout canonical={alternates[lang]} alternates={alternates} homepage>
  <Navbar alternates={alternates} />
  <main id="inhalt">
    <WhiteboardHero responsiveBoard />
    <AnnotatedProjects />
    <InteractiveScenes />
    <Services />
    <VSFloorplan />
    <FeedbackQuotes swipeable />
    <TalkContact />
  </main>
  <Footer />
</Layout>

<style is:global>
  html:root { --chair-peek: 0px; }
</style>
