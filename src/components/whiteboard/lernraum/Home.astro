---
/**
 * "Der Lernraum" – Production landing page:
 * - BoardNavigation (interactive whiteboard with draggable magnets, photo collages, feedback & contact card)
 * - AnnotatedProjects (#projekte: 234 South Tyrol proof bar + real reference collages grouped by category)
 * - InteractiveScenes (#lernformen: 3D/SVG room transformation across 8 arrangements)
 * - Services (#leistungen: 5-step process strip with custom symbols)
 * - VSFloorplan (#vs-moebel: pinned VS 2026 Catalog, JUMPER & 5 VS system zones)
 * - FeedbackQuotes (#stimmen: lined-paper customer & partner letters)
 * - TalkContact (#kontakt / #menschen / #anfrage: Simon's direct line, HOUSE70 Meran & Brixen, FAQ drawer)
 */
import Layout from '../../../layouts/WhiteboardLayout.astro';
import Navbar from '../shared/Navbar.astro';
import Footer from '../shared/Footer.astro';
import BoardNavigation from '../BoardNavigation.astro';
import InteractiveScenes from './InteractiveScenes.astro';
import AnnotatedProjects from './AnnotatedProjects.astro';
import FeedbackQuotes from '../FeedbackQuotes.astro';
import Services from './Services.astro';
import VSFloorplan from './VSFloorplan.astro';
import TalkContact from './TalkContact.astro';
import { homeFor } from '../../../lib/paths';
import { getLang } from '../../../i18n/ui';

const lang = getLang(Astro.currentLocale);
const alternates = { de: homeFor('de'), it: homeFor('it') };
---

<Layout canonical={alternates[lang]} alternates={alternates} homepage>
  <Navbar alternates={alternates} />
  <main id="inhalt">
    <script is:inline>
      // Arriving at a place further down the page (a link with an anchor): no intro to wait for.
      if (location.hash && location.hash !== '#top') document.documentElement.classList.add('hero-skip');
    </script>
    <div id="top"></div>
    <BoardNavigation responsive />
    <AnnotatedProjects />
    <InteractiveScenes />
    <Services />
    <VSFloorplan />
    <FeedbackQuotes swipeable />
    <TalkContact />
  </main>
  <Footer />
</Layout>

<style is:global>
  html:root { --chair-peek: 0px; }
</style>
