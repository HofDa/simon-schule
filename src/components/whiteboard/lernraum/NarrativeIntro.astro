---
/**
 * "Der Lernraum" – Narrative Opening Bridge directly below the Whiteboard Hero.
 * Reuses the whiteboard's physical artifacts (3 category magnets, HOUSE70 fridge magnet + plaque,
 * VS logo kitchen magnet + Exklusivvertretung badge, and pinned role cards with sticky-note
 * deliverables) to tie the below-the-fold story directly to the interactive board above.
 */
import { experience } from '../../../data/experience';
import { getLang, useTranslations } from '../../../i18n/ui';
import { lernraumCopy } from '../../../i18n/lernraum';
import Magnet from '../Magnet.astro';
import CategoryMagnetIcon from '../shared/CategoryMagnetIcon.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import house70Magnet from '../../../assets/whiteboard/house70-fridge-magnet-natural.webp';
import vsLogoMagnet from '../../../assets/whiteboard/vs-logo-kitchen-magnet.webp';

const lang = getLang(Astro.currentLocale);
const L = lernraumCopy(lang);
const N = L.narrative;
const { roles, rolesEyebrow, rolesNote } = L.services;
const phases = useTranslations(lang).form.phases;
const totalFacilities = experience.categories.reduce((sum, category) => sum + category.count, 0);
---

<section id="einstieg" class="lr-narrative" aria-labelledby="narrative-title">
  <div class="shell">
    <div class="thesis-grid">
      <div class="thesis-head">
        <p class="thesis-eyebrow marker" aria-hidden="true">{N.eyebrow}</p>
        <h2 id="narrative-title" class="thesis-title">{N.title}</h2>
      </div>

      <div class="thesis-arc">
        <article class="arc-step arc-tension">
          <p class="arc-label">{N.tensionLabel}</p>
          <p class="arc-text">{N.tensionText}</p>
        </article>
        <article class="arc-step arc-answer">
          <p class="arc-label">{N.answerLabel}</p>
          <p class="arc-text">{N.answerText}</p>
        </article>
      </div>
    </div>

    <div class="proof-strip">
      <article class="proof-item">
        <div class="proof-artifact proof-cluster" aria-hidden="true">
          <CategoryMagnetIcon kind="gs" size={34} uid="narr-gs" class="cluster-a" />
          <CategoryMagnetIcon kind="ms" size={34} uid="narr-ms" class="cluster-b" />
          <CategoryMagnetIcon kind="kb" size={34} uid="narr-kb" class="cluster-c" />
        </div>
        <div class="proof-body">
          <p class="proof-figure">
            <span class="proof-num">{totalFacilities}</span>
            <span class="proof-period">{experience.period}</span>
          </p>
          <p class="proof-desc">{N.proof.countLabel}</p>
          <a href="#projekte" class="proof-action link-line">{N.proof.projectsCta} <span aria-hidden="true">↓</span></a>
        </div>
      </article>

      <article class="proof-item">
        <div class="proof-artifact proof-house" aria-hidden="true">
          <div class="house-cutout">
            <ResponsiveImage src={house70Magnet} alt="" width={96} widths={[96, 160]} sizes="64px" quality={88} loading="lazy" draggable="false" />
          </div>
          <span class="mini-plaque">
            <strong>Trias</strong>
            <span>{N.proof.localBadge}</span>
          </span>
        </div>
        <div class="proof-body">
          <p class="proof-figure">{N.proof.localTitle}</p>
          <p class="proof-desc">{N.proof.localText}</p>
          <a href="#menschen" class="proof-action link-line">{L.board.topics.menschen} <span aria-hidden="true">↓</span></a>
        </div>
      </article>

      <article class="proof-item">
        <div class="proof-artifact proof-vs" aria-hidden="true">
          <div class="vs-cutout">
            <ResponsiveImage src={vsLogoMagnet} alt="" width={96} widths={[96, 160]} sizes="58px" quality={88} loading="lazy" draggable="false" />
          </div>
          <span class="mini-plaque mini-plaque-vs">
            <strong>{L.board.catalog.plaqueStrong}</strong>
            <span>{L.board.catalog.plaqueRest}</span>
          </span>
        </div>
        <div class="proof-body">
          <p class="proof-figure">{N.proof.vsTitle}</p>
          <p class="proof-desc">{N.proof.vsText}</p>
          <a href="#vs-moebel" class="proof-action link-line">{N.proof.vsCta} <span aria-hidden="true">↓</span></a>
        </div>
      </article>
    </div>

    <div class="roles" aria-labelledby="roles-heading">
      <div class="roles-head">
        <p id="roles-heading" class="roles-eyebrow">{rolesEyebrow}</p>
        <p class="roles-note marker" aria-hidden="true">{rolesNote}</p>
      </div>
      <div class="roles-grid">
        {roles.map((r, i) => (
          <article class="role-card" style={`--card-tilt: ${i === 0 ? '-0.6deg' : i === 1 ? '0.4deg' : '-0.4deg'}`}>
            <Magnet />
            <p class="role-audience">{r.audience}</p>
            <h3 class="role-title">{r.title}</h3>
            <p class="role-text">{r.text}</p>
            <p class="role-deliverable">{r.deliverable}</p>
            <a
              href="#anfrage"
              class="role-cta"
              data-open-form
              data-phase={phases[r.phase]}
              data-topic={r.topic}
            >
              <span>{r.cta}</span>
              <span class="role-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="bridge">
      <p class="bridge-lead">{N.bridgeLead}</p>
      <div class="bridge-actions">
        <a href="#lernformen" class="bridge-next link-line">
          {N.bridgeCta}
          <span aria-hidden="true">↓</span>
        </a>
        <a href="#anfrage" class="btn btn-ink" data-open-form>
          {N.bridgeInquiry}
          <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .lr-narrative {
    background: var(--color-warm);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(56px, 7vw, 108px);
  }

  .thesis-grid {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .thesis-eyebrow {
    position: relative;
    z-index: 0;
    display: inline-block;
    font-size: var(--text-marker);
    color: var(--color-ink);
    transform: rotate(-1.2deg);
    margin-bottom: 14px;
  }
  .thesis-eyebrow::after {
    content: '';
    position: absolute;
    left: -1%;
    right: -3%;
    bottom: 0.04em;
    height: 0.2em;
    border-radius: 99px;
    background: var(--color-ginster);
    opacity: 0.55;
    z-index: -1;
  }
  .thesis-title {
    max-width: 18ch;
    font-size: clamp(2.1rem, 3.8vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .thesis-arc {
    display: grid;
    gap: 24px;
  }
  .arc-step {
    padding-left: 20px;
    border-left: 2px solid var(--color-line);
  }
  .arc-answer {
    border-left-width: 3px;
    border-left-color: var(--color-ginster-deep);
  }
  .arc-label {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #57554e;
    margin-bottom: 8px;
  }
  .arc-answer .arc-label {
    color: var(--color-ink);
  }
  .arc-text {
    max-width: 54ch;
    color: var(--color-ink);
    font-size: var(--text-body);
    line-height: 1.65;
  }
  .arc-tension .arc-text {
    color: #4f4e48;
  }

  /* Proof anchor strip with whiteboard artifacts */
  .proof-strip {
    margin-top: clamp(44px, 5vw, 72px);
    padding-block: clamp(26px, 3vw, 40px);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 28px;
  }
  .proof-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .proof-artifact {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2px;
  }
  .proof-cluster {
    flex-direction: row;
    align-items: center;
    width: 82px;
    padding-top: 4px;
  }
  .proof-cluster :global(.cluster-a) { rotate: -8deg; z-index: 3; }
  .proof-cluster :global(.cluster-b) { margin-left: -12px; rotate: 5deg; z-index: 2; }
  .proof-cluster :global(.cluster-c) { margin-left: -12px; rotate: -4deg; z-index: 1; }

  .proof-house,
  .proof-vs {
    width: 82px;
  }
  .house-cutout img {
    display: block;
    width: 60px;
    height: auto;
    rotate: -3deg;
    filter:
      drop-shadow(1.5px 0 0 #fbf7ec)
      drop-shadow(-1.5px 0 0 #fbf7ec)
      drop-shadow(0 1.5px 0 #fbf7ec)
      drop-shadow(0 -1.5px 0 #fbf7ec)
      drop-shadow(1px 5px 4px rgba(32, 32, 29, 0.25));
  }
  .vs-cutout img {
    display: block;
    width: 54px;
    height: auto;
    rotate: 4deg;
    filter: drop-shadow(0 2px 0 rgba(41, 37, 29, 0.35)) drop-shadow(1px 4px 3px rgba(32, 32, 29, 0.24));
  }
  .mini-plaque {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: -6px;
    padding: 3px 6px 4px;
    border-radius: 4px;
    background: linear-gradient(#fffdf6, #f3eedf);
    box-shadow: 0 0 0 1px #fbf7ec, 0 1.5px 0 1px #d6cfbd, 1px 4px 6px -1px rgba(32, 32, 29, 0.22);
    color: var(--color-ink);
    font-size: 0.62rem;
    line-height: 1.15;
    text-align: center;
    rotate: 3deg;
  }
  .mini-plaque strong {
    font-weight: 800;
    color: var(--color-ginster-deep);
    letter-spacing: -0.02em;
  }
  .mini-plaque span {
    font-size: 0.56rem;
    font-weight: 600;
    color: #5c5a52;
    letter-spacing: 0.03em;
  }
  .mini-plaque-vs {
    margin-top: 4px;
    rotate: -2deg;
  }
  .mini-plaque-vs strong {
    color: var(--color-ink);
  }

  .proof-body {
    min-width: 0;
  }
  .proof-figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .proof-period {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #57554e;
    padding: 2px 8px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  .proof-desc {
    margin-top: 8px;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.55;
  }
  .proof-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-ink);
  }

  /* 3 decision-maker perspectives as pinned whiteboard cards */
  .roles {
    margin-top: clamp(36px, 4.5vw, 56px);
  }
  .roles-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid var(--color-ink);
  }
  .roles-eyebrow {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #57554e;
  }
  .roles-note {
    font-size: var(--text-marker);
    color: var(--color-ink);
    transform: rotate(-1.5deg);
  }
  .roles-grid {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }
  .role-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 24px 22px;
    background: #fffefb;
    border: 1px solid #e3dfd3;
    box-shadow: inset 4px 0 0 var(--color-ginster), 0 1px 0 #e3dfd3, 2px 12px 20px -14px rgba(32, 32, 29, 0.28);
    transform: rotate(var(--card-tilt, 0deg));
    transition: transform 220ms var(--ease-draw), box-shadow 220ms var(--ease-draw);
  }
  .role-card:hover {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: inset 4px 0 0 var(--color-ginster), 0 1px 0 #e3dfd3, 4px 18px 26px -14px rgba(32, 32, 29, 0.34);
  }
  .role-audience {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ginster-deep);
  }
  .role-title {
    margin-top: 10px;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .role-text {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.6;
  }
  .role-deliverable {
    margin-top: 16px;
    margin-bottom: 18px;
    padding: 5px 10px;
    background: #f6dc78;
    color: var(--color-ink);
    font-family: var(--font-marker);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.1;
    rotate: -1deg;
    box-shadow: 1px 3px 6px -3px rgba(32, 32, 29, 0.28);
  }
  .role-cta {
    margin-top: auto;
    padding-top: 16px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 44px;
    border-top: 1px dashed #d9d5c9;
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-ink);
  }
  .role-arrow {
    color: var(--color-ginster-deep);
    transition: transform 200ms var(--ease-draw);
  }
  .role-cta:hover .role-arrow {
    transform: translateX(4px);
  }

  /* Story bridge into the room transformation */
  .bridge {
    margin-top: clamp(32px, 4vw, 48px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .bridge-lead {
    color: var(--color-ink);
    font-size: var(--text-lead);
    font-weight: 500;
    letter-spacing: -0.02em;
    max-width: 46ch;
  }
  .bridge-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .bridge-next {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-meta);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .proof-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(20px, 2.5vw, 36px);
    }
    .proof-item + .proof-item {
      border-left: 1px solid var(--color-line);
      padding-left: clamp(18px, 2vw, 32px);
    }
    .roles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(20px, 2.4vw, 32px);
    }
  }

  @media (min-width: 1024px) {
    .thesis-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .thesis-head {
      grid-column: 1 / 6;
    }
    .thesis-arc {
      grid-column: 7 / 13;
    }
  }
</style>
