---
/**
 * "Der Lernraum" – Section 4: Simon Brugger & Trias Meran/Brixen in the Sitzkreis.
 * Reuses Simon's pinned business card (with circular SB stamp) and the HOUSE70 fridge magnet
 * from the whiteboard, paired with the interactive 10-chair Sitzkreis planning questions.
 */
import { contact, fullName, locations, people, roleFor } from '../../../data/site';
import { asset } from '../../../lib/paths';
import { getLang, useTranslations } from '../../../i18n/ui';
import Lesson from '../klassenzimmer/Lesson.astro';
import Magnet from '../Magnet.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import house70Magnet from '../../../assets/whiteboard/house70-fridge-magnet-natural.webp';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const t = ui.people;
const [simon] = people;
const simonName = fullName(simon);
const simonInitials = [simon.firstName, simon.lastName].filter(Boolean).map((n) => n![0]).join('');
const simonRole = roleFor(simon, lang);
const directPhone = simon.phone ?? contact.phone;
const phoneHref = directPhone ? `tel:${directPhone.replace(/[^\d+]/g, '')}` : null;

const L = lernraumCopy(lang);
const C = L.board.card;
const questionAnswers = L.people.why;

type Seat = { kind: 'empty' } | { kind: 'person'; label: string } | { kind: 'question'; q: number } | { kind: 'you' };
const seats: Seat[] = [
  { kind: 'empty' },
  { kind: 'question', q: 1 },
  { kind: 'empty' },
  { kind: 'person', label: simon.firstName },
  { kind: 'question', q: 2 },
  { kind: 'you' },
  { kind: 'question', q: 3 },
  { kind: 'person', label: 'Trias' },
  { kind: 'empty' },
  { kind: 'question', q: 0 },
];

const placed = seats.map((seat, i) => {
  const a = -90 + i * (360 / seats.length);
  const rad = (a * Math.PI) / 180;
  return {
    seat,
    x: (50 + 40 * Math.cos(rad)).toFixed(2),
    y: (50 + 40 * Math.sin(rad)).toFixed(2),
    r: a - 90,
    ox: Math.cos(rad).toFixed(3),
    oy: Math.sin(rad).toFixed(3),
  };
});
---

<section id="menschen" class="lr-people" aria-labelledby="people-title">
  <div class="shell grid-wrap">
    <div class="copy">
      <Lesson n="03" name={L.lesson.people.name} note={L.lesson.people.note} layout="circle" from="frontal" />
      <h2 id="people-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="mt-6 max-w-[46ch] text-body leading-[1.65] text-muted lg:text-lead">{t.intro}</p>

      <div class="pinned-cards">
        <!-- Simon Brugger's pinned whiteboard business card -->
        <article class="simon-card">
          <Magnet />
          <p class="card-eyebrow">{C.eyebrow}</p>
          <div class="card-person">
            {simon.photo ? (
              <img
                class="card-photo"
                src={asset(`images/team/${simon.photo}.webp`)}
                alt={t.portraitAlt(simonName)}
                width="80"
                height="100"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="card-stamp" aria-hidden="true">{simonInitials}</span>
            )}
            <div class="min-w-0">
              <h3 class="card-name">{simonName}</h3>
              {simonRole && <p class="card-role">{simonRole}</p>}
              <p class="card-note">{C.note}</p>
            </div>
          </div>
          <div class="card-actions">
            <div class="card-lines">
              {simon.email && (
                <a href={`mailto:${simon.email}`}>
                  <span aria-hidden="true">✉</span> {simon.email}
                </a>
              )}
              {phoneHref && (
                <a href={phoneHref}>
                  <span aria-hidden="true">☏</span> {directPhone}
                </a>
              )}
            </div>
            <a class="card-cta" href="#anfrage" data-open-form>
              {C.cta} <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Pinned HOUSE70 Meran & Brixen card -->
        <article class="house-card">
          <Magnet />
          <div class="house-card-head">
            <div class="house-thumb" aria-hidden="true">
              <ResponsiveImage src={house70Magnet} alt="" width={110} widths={[96, 140]} sizes="56px" quality={88} loading="lazy" draggable="false" />
            </div>
            <div>
              <p class="card-eyebrow">{L.board.house.place}</p>
              <h3 class="house-title">{t.teamTitle}</h3>
              <p class="house-role">{t.teamRole}</p>
            </div>
          </div>
          <ul class="house-locations">
            {locations.map((loc) => (
              <li>
                <strong>{loc.city[lang]}</strong>
                <span>{loc.street[lang]}</span>
              </li>
            ))}
          </ul>
          <p class="house-mail">
            <a class="link-line font-semibold" href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </article>
      </div>

      <!-- Interactive list of the 4 planning questions synced with the circle -->
      <div class="question-picker" aria-label={t.questionsLabel}>
        <p class="picker-label">{t.questionsLabel} {L.people.pick}:</p>
        <div class="picker-list">
          {t.questions.map((q, i) => (
            <button
              type="button"
              class={`picker-btn ${i === 0 ? 'is-asking' : ''}`}
              data-lr-ask={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="picker-q">?</span>
              <span>{q}</span>
            </button>
          ))}
        </div>
        <div class="picker-answer" aria-live="polite">
          <p class="picker-why" data-lr-picker-why>{questionAnswers[0]}</p>
          <a
            href="#anfrage"
            class="picker-cta"
            data-open-form
            data-question={t.questions[0]}
            data-lr-picker-cta
          >
            <span>{L.people.take}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="ring-wrap">
      <div class="kz-ring" data-lr-ring>
        <span class="rug" aria-hidden="true"></span>
        <div class="middle">
          <p class="middle-label">{t.questionsLabel}</p>
          <ul class="questions" id="lr-questions">
            {t.questions.map((q, i) => (
              <li class={`question-card ${i === 0 ? 'is-asked' : ''}`} data-lr-question={i}>
                <p class="question marker">{q}</p>
                <p class="question-why">{questionAnswers[i]}</p>
                <a
                  href="#anfrage"
                  class="question-cta"
                  data-open-form
                  data-question={q}
                >
                  <span>{L.people.take}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        {placed.map(({ seat, x, y, r, ox, oy }) => {
          const style = `left: ${x}%; top: ${y}%; --r: ${r}deg; --ox: ${ox}; --oy: ${oy}`;
          const chair = <svg class="chair" viewBox="-12 -12 24 24" aria-hidden="true"><use href="#kz-chair" x="-12" y="-12" width="24" height="24" /></svg>;
          if (seat.kind === 'person') return (
            <span class="seat seat-person" style={style}>{chair}<span class="seat-label">{seat.label}</span></span>
          );
          if (seat.kind === 'question') return (
            <button
              class={`seat seat-question ${seat.q === 0 ? 'is-asking' : ''}`}
              type="button"
              style={style}
              data-lr-ask={seat.q}
              aria-controls="lr-questions"
              aria-label={t.questions[seat.q]}
              aria-pressed={seat.q === 0 ? 'true' : 'false'}
            >
              {chair}<span class="seat-q" aria-hidden="true">?</span>
            </button>
          );
          if (seat.kind === 'you') return (
            <a class="seat seat-you" href="#anfrage" data-open-form style={style}>{chair}<span class="seat-label">{L.people.you}</span></a>
          );
          return <span class="seat" style={style} aria-hidden="true">{chair}</span>;
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .lr-people {
    padding-block: clamp(80px, 9vw, 144px);
    background: var(--color-warm);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .grid-wrap { display: grid; gap: 56px; }

  /* Pinned business card & HOUSE70 card */
  .pinned-cards {
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }
  .simon-card,
  .house-card {
    position: relative;
    padding: 22px 20px 18px;
    background: #fffefb;
    border: 1px solid #e3dfd3;
    box-shadow: inset 4px 0 0 var(--color-ginster), 0 1px 0 #e3dfd3, 2px 12px 18px -10px rgba(32, 32, 29, 0.25);
  }
  .simon-card { rotate: -0.6deg; }
  .house-card {
    rotate: 0.7deg;
    box-shadow: 0 1px 0 #e3dfd3, 2px 12px 18px -10px rgba(32, 32, 29, 0.25);
  }
  .card-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ginster-deep);
  }
  .card-person {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
  }
  .card-stamp {
    flex: none;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 2px solid var(--color-ginster);
    border-radius: 50%;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 1.55rem;
    font-weight: 700;
    rotate: -8deg;
  }
  .card-photo {
    flex: none;
    width: 58px;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    border-radius: 2px;
  }
  .card-name {
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .card-role {
    margin-top: 3px;
    font-size: var(--text-label);
    line-height: 1.35;
    color: var(--color-muted);
  }
  .card-note {
    margin-top: 4px;
    font-family: var(--font-marker);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1;
    color: #22305f;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 14px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed #d9d5c9;
  }
  .card-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .card-lines a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: #d9d5c9;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .card-lines a:hover { text-decoration-color: var(--color-ginster); }
  .card-lines a span { color: var(--color-ginster-deep); text-decoration: none; }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 2px;
    background: var(--color-ink);
    color: #fff;
    font-size: var(--text-label);
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 150ms ease;
  }
  .card-cta span { display: inline-block; color: var(--color-ginster-light); transition: translate 200ms ease; }
  .card-cta:hover { background: #000; }
  .card-cta:hover span { translate: 3px 0; }

  .house-card-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .house-thumb img {
    display: block;
    width: 50px;
    height: auto;
    rotate: -3deg;
    filter:
      drop-shadow(1.5px 0 0 #fbf7ec)
      drop-shadow(-1.5px 0 0 #fbf7ec)
      drop-shadow(0 1.5px 0 #fbf7ec)
      drop-shadow(0 -1.5px 0 #fbf7ec)
      drop-shadow(1px 5px 4px rgba(32, 32, 29, 0.25));
  }
  .house-title {
    margin-top: 2px;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .house-role {
    margin-top: 2px;
    font-size: var(--text-label);
    color: var(--color-muted);
    line-height: 1.4;
  }
  .house-locations {
    list-style: none;
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px dashed #d9d5c9;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
    font-size: var(--text-label);
  }
  .house-locations li {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .house-locations span {
    color: var(--color-muted);
  }
  .house-mail {
    margin-top: 10px;
    font-size: var(--text-label);
  }

  .question-picker {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
  .picker-label {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 12px;
  }
  .picker-list {
    display: grid;
    gap: 8px;
  }
  .picker-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-meta);
    text-align: left;
    cursor: pointer;
    transition: border-color 180ms var(--ease-draw), background-color 180ms var(--ease-draw);
  }
  .picker-btn:hover { border-color: var(--color-ink); }
  .picker-btn.is-asking {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .picker-q {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-ginster);
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex: none;
  }
  .picker-answer {
    display: none;
    margin-top: 12px;
    padding: 14px 16px;
    background: #fffefb;
    border: 1px solid #e3dfd3;
    border-left: 4px solid var(--color-ginster);
  }
  .picker-why { font-size: var(--text-meta); line-height: 1.55; color: var(--color-muted); }
  .picker-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 6px 12px;
    background: var(--color-ink);
    color: #fff;
    border-radius: 2px;
    font-size: var(--text-label);
    font-weight: 700;
  }

  .ring-wrap { display: grid; place-items: center; }
  .kz-ring {
    --chair: clamp(38px, 9vw, 58px);
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 1;
    margin: calc(var(--chair) * 0.7);
  }
  .rug {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: var(--color-paper);
    border: 1.5px solid var(--color-ink);
  }

  .middle {
    position: absolute;
    inset: 22%;
    display: grid;
    place-content: center;
    text-align: center;
    padding: 12px;
  }
  .middle-label {
    color: var(--color-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .questions { list-style: none; margin: 8px 0 0; padding: 0; }
  :global(html.js) .kz-ring.is-live .questions { display: grid; grid-template-areas: 'q'; }
  :global(html.js) .kz-ring.is-live .question-card {
    grid-area: q;
    opacity: 0;
    pointer-events: none;
    translate: 0 8px;
    transition: opacity 300ms var(--ease-draw), translate 400ms var(--ease-draw);
  }
  :global(html.js) .kz-ring.is-live .question-card.is-asked {
    opacity: 1;
    pointer-events: auto;
    translate: 0 0;
  }
  .question {
    font-size: clamp(1.25rem, 2.2vw, 1.85rem);
    line-height: 1.08;
    color: var(--color-ink);
  }
  .question-why {
    margin-top: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-muted);
    max-width: 28ch;
    margin-inline: auto;
  }
  .question-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 6px 12px;
    background: var(--color-ginster);
    color: var(--color-ink);
    border-radius: 2px;
    font-size: 0.78rem;
    font-weight: 700;
    transition: background-color 180ms var(--ease-draw);
  }
  .question-cta:hover {
    background: var(--color-ginster-light);
  }

  .seat {
    position: absolute;
    width: var(--chair);
    height: var(--chair);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    transform: translate(-50%, -50%);
  }
  .chair {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(var(--r));
    transition: transform 400ms var(--ease-draw);
  }
  .seat-person { --seat: var(--color-ink); --back: var(--color-ink); }
  .seat-you { --seat: var(--color-paper); --seat-line: var(--color-ink); --seat-dash: 3 2.5; --back: var(--color-muted); }
  .seat-you:hover, .seat-you:focus-visible { --seat: var(--color-ginster-light); }

  .seat-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translate(calc(var(--ox) * var(--chair) * 1.05), calc(var(--oy) * var(--chair) * 0.95));
    white-space: nowrap;
    font-size: var(--text-meta);
    font-weight: 600;
  }
  .seat-you .seat-label {
    font-family: var(--font-marker);
    font-size: var(--text-marker);
    font-weight: 600;
  }
  .seat-q {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -58%);
    font-size: 0.95rem;
    font-weight: 700;
    pointer-events: none;
  }
  .seat-question { cursor: pointer; }
  .seat-question:hover .chair,
  .seat-question.is-asking .chair { transform: rotate(var(--r)) scale(1.12); }
  .seat-question.is-asking { --seat: var(--color-ink); }
  .seat-question.is-asking .seat-q { color: var(--color-paper); }

  @media (min-width: 1024px) {
    .grid-wrap {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: center;
    }
    .copy { grid-column: 1 / 6; }
    .ring-wrap { grid-column: 6 / 13; }
  }
  @media (max-width: 539px) {
    .house-locations { grid-template-columns: 1fr; }
    .middle-label, .question-why { display: none; }
    .picker-answer { display: block; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#menschen');
  const ring = section?.querySelector<HTMLElement>('[data-lr-ring]');
  if (section && ring) {
    const questions = Array.from(ring.querySelectorAll<HTMLElement>('[data-lr-question]'));
    const triggers = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-lr-ask]'));
    const picker = section.querySelector<HTMLElement>('.question-picker');
    const pickerWhy = section.querySelector<HTMLElement>('[data-lr-picker-why]');
    const pickerCta = section.querySelector<HTMLAnchorElement>('[data-lr-picker-cta]');
    let current = 0;
    let timer: number | undefined;

    const ask = (q: number) => {
      current = q;
      questions.forEach((el, i) => {
        el.classList.toggle('is-asked', i === q);
        el.setAttribute('aria-hidden', String(i !== q));
      });
      triggers.forEach((btn) => {
        const on = Number(btn.dataset.lrAsk) === q;
        btn.classList.toggle('is-asking', on);
        btn.setAttribute('aria-pressed', String(on));
      });
      const active = questions[q];
      if (pickerWhy && active) pickerWhy.textContent = active.querySelector('.question-why')?.textContent ?? '';
      if (pickerCta && active) pickerCta.dataset.question = active.querySelector('.question')?.textContent ?? '';
    };

    ring.classList.add('is-live');
    ask(0);
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        stop();
        ask(Number(btn.dataset.lrAsk));
      });
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      let stopped = false;
      let paused = false;
      let visible = false;
      const syncTimer = () => {
        stop();
        if (visible && !stopped && !paused) {
          timer = window.setInterval(() => ask((current + 1) % questions.length), 4200);
        }
      };
      triggers.forEach((btn) => btn.addEventListener('click', () => { stopped = true; syncTimer(); }));
      for (const target of [ring, picker].filter((el): el is HTMLElement => Boolean(el))) {
        target.addEventListener('pointerenter', () => { paused = true; syncTimer(); });
        target.addEventListener('pointerleave', () => { paused = false; syncTimer(); });
        target.addEventListener('focusin', () => { paused = true; syncTimer(); });
        target.addEventListener('focusout', () => { paused = false; syncTimer(); });
      }
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          syncTimer();
        },
        { threshold: 0.4 },
      ).observe(ring);
    }
  }
</script>
