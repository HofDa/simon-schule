---
/**
 * "Der Lernraum" – Section 6: Stationenlernen ("Wo stehen Sie gerade?").
 * Combines the five project phases as stations along a dashed floor route with active selection state
 * that pre-fills the open-desk inquiry form right below.
 */
import { getLang, useTranslations } from '../../../i18n/ui';
import Lesson from '../klassenzimmer/Lesson.astro';

const ui = useTranslations(getLang(Astro.currentLocale));
const t = ui.phases;
const phases = ui.form.phases.map((name, i) => ({ name, hint: t.hints[i] }));
---

<section id="phasen" class="lr-stations" aria-labelledby="phases-title">
  <div class="shell">
    <Lesson n="05" name="Stationenlernen" note="dort einsteigen, wo Ihr Projekt gerade steht" layout="stations" from="landscape" />
    <div class="head">
      <h2 id="phases-title" class="max-w-[16ch] text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    <ol class="route">
      {phases.map((p, i) => (
        <li>
          <a class="station" href="#anfrage" data-open-form data-phase={p.name} data-station-card>
            <span class="station-table" aria-hidden="true">
              <svg viewBox="-30 -30 60 60">
                <use href="#kz-chair" x="-30" y="-12" width="24" height="24" transform="rotate(90 -18 0)" />
                <use href="#kz-chair" x="6" y="-12" width="24" height="24" transform="rotate(-90 18 0)" />
              </svg>
              <span class="station-n">{i + 1}</span>
            </span>
            <span class="station-copy">
              <span class="station-label">Phase 0{i + 1}</span>
              <span class="station-name">{p.name}</span>
              <span class="station-hint">{p.hint}</span>
              <span class="station-go">Mit dieser Phase starten →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .lr-stations {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--color-warm);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .head { display: grid; gap: 20px; }
  .lead { max-width: 46ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.65; }

  .route {
    position: relative;
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  .route::before {
    content: '';
    position: absolute;
    left: 44px;
    top: 44px;
    bottom: 44px;
    border-left: 2px dashed var(--color-ginster-deep);
  }

  .station {
    position: relative;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    padding: 14px;
    border: 1px solid transparent;
    transition: background-color 200ms var(--ease-draw), border-color 200ms var(--ease-draw);
  }
  .station:hover,
  .station:focus-visible,
  .station.is-chosen {
    background: var(--color-paper);
    border-color: var(--color-ink);
  }
  .station-table {
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
  }
  .station-table svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .station-n {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: background-color 250ms var(--ease-draw);
  }
  .station:hover .station-n,
  .station:focus-visible .station-n,
  .station.is-chosen .station-n {
    background: var(--color-ginster);
  }
  .station-copy { display: grid; gap: 6px; padding-top: 8px; }
  .station-label { color: var(--color-muted); font-size: var(--text-label); letter-spacing: 0.08em; text-transform: uppercase; }
  .station-name { font-size: var(--text-phi-1); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; }
  .station-hint { max-width: 32ch; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.5; }
  .station-go {
    margin-top: 4px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
    opacity: 0.78;
    transition: opacity 200ms, transform 200ms var(--ease-draw);
  }
  .station:hover .station-go,
  .station:focus-visible .station-go,
  .station.is-chosen .station-go {
    opacity: 1;
    transform: translateX(3px);
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: end;
    }
    .head h2 { grid-column: 1 / 7; }
    .lead { grid-column: 7 / 13; }

    .route { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(12px, 1.6vw, 24px); }
    .route::before { left: 58px; right: 10%; top: 58px; bottom: auto; border-left: 0; border-top: 2px dashed var(--color-ginster-deep); }
    .station { grid-template-columns: 1fr; gap: 12px; height: 100%; }
    .station-copy { padding-top: 0; }
    .station-name { font-size: clamp(var(--text-lead), 1.75vw, var(--text-phi-1)); }
  }
</style>
