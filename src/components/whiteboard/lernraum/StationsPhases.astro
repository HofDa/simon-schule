---
/**
 * "Der Lernraum" – Section 6: Stationenlernen ("Wo stehen Sie gerade?").
 * Combines the five project phases as stations pinned with whiteboard magnets,
 * showing the concrete deliverable at each stage and pre-filling the inquiry desk on click.
 */
import { getLang, useTranslations } from '../../../i18n/ui';
import Lesson from '../klassenzimmer/Lesson.astro';
import Magnet from '../Magnet.astro';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const L = lernraumCopy(lang);
const t = ui.phases;
const phases = ui.form.phases.map((name, i) => ({
  name,
  hint: t.hints[i],
  deliverable: L.stations.deliverables[i],
}));
---

<section id="phasen" class="lr-stations" aria-labelledby="phases-title">
  <div class="shell">
    <Lesson n="05" name={L.lesson.phases.name} note={L.lesson.phases.note} layout="stations" from="landscape" />
    <div class="head">
      <h2 id="phases-title" class="max-w-[16ch] text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    <ol class="route">
      {phases.map((p, i) => (
        <li>
          <a class="station" href="#anfrage" data-open-form data-phase={p.name} data-station-card>
            <Magnet />
            <span class="station-table" aria-hidden="true">
              <svg viewBox="-30 -30 60 60">
                <use href="#kz-chair" x="-30" y="-12" width="24" height="24" transform="rotate(90 -18 0)" />
                <use href="#kz-chair" x="6" y="-12" width="24" height="24" transform="rotate(-90 18 0)" />
              </svg>
              <span class="station-n">{i + 1}</span>
            </span>
            <span class="station-copy">
              <span class="station-label">{L.stations.phase} 0{i + 1}</span>
              <span class="station-name">{p.name}</span>
              <span class="station-hint">{p.hint}</span>
              {p.deliverable && <span class="station-deliverable">{p.deliverable}</span>}
              <span class="station-go">{L.stations.go} →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .lr-stations {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--color-warm);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .head { display: grid; gap: 20px; }
  .lead { max-width: 46ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.65; }

  .route {
    position: relative;
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  .route::before {
    content: '';
    position: absolute;
    left: 44px;
    top: 44px;
    bottom: 44px;
    border-left: 2px dashed var(--color-ginster-deep);
  }

  .station {
    position: relative;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    padding: 20px 16px 16px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--color-line);
    transition: background-color 200ms var(--ease-draw), border-color 200ms var(--ease-draw), transform 200ms var(--ease-draw);
  }
  .station:hover,
  .station:focus-visible,
  .station.is-chosen {
    background: #fffefb;
    border-color: var(--color-ink);
    box-shadow: inset 3px 0 0 var(--color-ginster), 2px 10px 18px -12px rgba(32, 32, 29, 0.25);
    transform: translateY(-2px);
  }
  .station-table {
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
  }
  .station-table svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .station-n {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: background-color 250ms var(--ease-draw);
  }
  .station:hover .station-n,
  .station:focus-visible .station-n,
  .station.is-chosen .station-n {
    background: var(--color-ginster);
  }
  .station-copy { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; min-width: 0; height: 100%; }
  .station-label { color: var(--color-muted); font-size: var(--text-label); letter-spacing: 0.08em; text-transform: uppercase; }
  .station-name { font-size: var(--text-phi-1); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; overflow-wrap: break-word; hyphens: auto; }
  .station-hint { max-width: 32ch; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.5; }
  .station-deliverable {
    display: inline-block;
    align-self: flex-start;
    margin-top: 6px;
    margin-bottom: 10px;
    padding: 3px 9px;
    background: #f6dc78;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
    rotate: -0.8deg;
  }
  .station-go {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed #d9d5c9;
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-ink);
    opacity: 0.85;
    transition: opacity 200ms, transform 200ms var(--ease-draw);
  }
  .station:hover .station-go,
  .station:focus-visible .station-go,
  .station.is-chosen .station-go {
    opacity: 1;
    transform: translateX(3px);
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: end;
    }
    .head h2 { grid-column: 1 / 7; }
    .lead { grid-column: 7 / 13; }

    .route { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(12px, 1.6vw, 24px); }
    .route::before { left: 58px; right: 10%; top: 64px; bottom: auto; border-left: 0; border-top: 2px dashed var(--color-ginster-deep); }
    .station { grid-template-columns: 1fr; gap: 12px; height: 100%; min-width: 0; }
    .station-copy { padding-top: 0; }
    .station-name { font-size: clamp(var(--text-lead), 1.75vw, var(--text-phi-1)); }
  }
</style>
