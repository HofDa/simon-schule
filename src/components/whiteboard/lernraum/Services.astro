---
/**
 * "Der Lernraum" – Section 1: The five project steps drawn as desks facing the board,
 * enriched with concrete deliverables and a 3-role perspective bar for South Tyrol's
 * decision makers (Schule & Kindergarten, Gemeinde & Amt, Architektur & Planung).
 */
import DeskBack, { type DeskItem } from '../art/DeskBack.astro';
import Lesson from '../klassenzimmer/Lesson.astro';
import { getLang, useTranslations } from '../../../i18n/ui';
import { servicesFor } from '../../../data/services';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).services;
const services = servicesFor(lang);
const items: DeskItem[] = ['mug', 'plan', 'catalogue', 'toolbox', 'plant'];

const deliverables = [
  'Vor-Ort-Begehung in Südtirol',
  'Raum- & Möblierungskonzept',
  'Auswahl aus dem VS-System',
  'Bestellung & Terminmontage',
  'Fester Kontakt auch nach Übergabe',
];

const roles = [
  {
    audience: 'Schule & Kindergarten',
    title: 'Räume, die den Alltag mitmachen.',
    text: 'Vom Morgenkreis über konzentrierte Einzelarbeit bis zur Gruppenphase: Wir planen mit Ihrem Kollegium vor Ort, wie sich Räume ohne Kraftakt umstellen lassen.',
    cta: 'Raumidee besprechen',
    phase: 'Erste Idee',
    topic: 'Pädagogisches Raumkonzept',
  },
  {
    audience: 'Gemeinde & Auftraggeber',
    title: 'Verlässlich in Ausschreibung & Montage.',
    text: 'Klare Leistungsverzeichnisse, langlebige VS-Qualität und eine sauber koordinierte Lieferung und Montage – abgestimmt auf Bauzeitpläne und Schulferien.',
    cta: 'Ausschreibung & Ablauf klären',
    phase: 'Ausschreibung',
    topic: 'Ausschreibung / Gemeindeprojekt',
  },
  {
    audience: 'Architektur & Planung',
    title: 'Fachplanung mit dem VS-Systembaukasten.',
    text: 'Wir übersetzen Ihren Grundriss in konkrete Möblierungspläne, Zonierungen und Akustiklösungen – als direkter Südtiroler Partner von VS Möbel.',
    cta: 'Planung abstimmen',
    phase: 'Planung läuft',
    topic: 'Fachplanung / Architektur',
  },
];
---

<section id="leistungen" class="lr-services" aria-labelledby="services-title">
  <div class="shell">
    <Lesson n="01" name="Frontal" note="zuhören, verstehen, den Ablauf überblicken" layout="frontal" from="talk" />

    <div class="head">
      <h2 id="services-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="intro">{t.intro}</p>
    </div>

    <ol class="desks" data-lr-desks>
      {services.map((service, index) => (
        <li class={`desk ${index < 3 ? 'is-front' : 'is-back'}`} style={`--i: ${index}`}>
          <div class="desk-art" aria-hidden="true">
            <DeskBack item={items[index]} />
          </div>
          <div class="desk-card">
            <div class="desk-meta">
              <span class="desk-n" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="desk-tag">{deliverables[index]}</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="roles" aria-labelledby="roles-heading">
      <div class="roles-head">
        <p id="roles-heading" class="roles-eyebrow">Drei Perspektiven · Ein Ansprechpartner</p>
        <p class="roles-note marker" aria-hidden="true">Wer plant mit uns?</p>
      </div>
      <div class="roles-grid">
        {roles.map((r) => (
          <article class="role-card">
            <p class="role-audience">{r.audience}</p>
            <h3 class="role-title">{r.title}</h3>
            <p class="role-text">{r.text}</p>
            <a
              href="#anfrage"
              class="role-link link-line"
              data-open-form
              data-phase={r.phase}
              data-topic={r.topic}
            >
              {r.cta}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lr-services { padding-block: clamp(56px, 7vw, 104px) clamp(80px, 9vw, 144px); }
  .head { display: grid; gap: 20px; margin-bottom: clamp(48px, 6vw, 80px); }
  .intro { max-width: 50ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.65; }

  .desks { list-style: none; margin: 0; padding: 0; display: grid; gap: 44px 24px; }
  .desk { min-width: 0; display: flex; flex-direction: column; }
  .desk-art { width: min(100%, 250px); margin-inline: auto; }
  .desk-card {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1.5px solid var(--color-ink);
  }
  .desk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }
  .desk-n {
    color: var(--color-muted);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .desk-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-warm);
    padding: 2px 8px;
    border: 1px solid var(--color-line);
  }
  .desk-tag::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .desk h3 { font-size: clamp(1.4rem, 2vw, 1.85rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.12; }
  .desk p { margin-top: 10px; max-width: 36ch; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.6; }

  /* 3 decision-maker perspectives */
  .roles {
    margin-top: clamp(64px, 8vw, 112px);
    padding: clamp(24px, 3.2vw, 44px);
    background: var(--color-warm);
    border-top: 1.5px solid var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .roles-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .roles-eyebrow {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .roles-note {
    font-size: var(--text-marker);
    color: var(--color-ink);
    transform: rotate(-1.5deg);
  }
  .roles-grid {
    display: grid;
    gap: 28px;
    margin-top: 24px;
  }
  .role-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .role-audience {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .role-audience::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .role-title {
    margin-top: 10px;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .role-text {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.6;
  }
  .role-link {
    margin-top: auto;
    padding-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (max-width: 639px) {
    .desks { grid-template-columns: 1fr; gap: 36px; }
  }

  @media (min-width: 640px) {
    .desks { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: clamp(24px, 3vw, 48px); row-gap: clamp(48px, 5vw, 76px); }
    .desk { grid-column: span 2; }
    .desk:nth-child(4) { grid-column: 2 / 4; }
    .desk:nth-child(5) { grid-column: 4 / 6; }
    .is-front .desk-art { width: min(86%, 240px); }
    .is-back .desk-art { width: min(100%, 280px); }
  }

  @media (min-width: 768px) {
    .roles-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 44px); }
    .role-card + .role-card {
      border-left: 1px solid var(--color-line);
      padding-left: clamp(20px, 2.4vw, 36px);
    }
  }

  @media (min-width: 1024px) {
    .head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: end; }
    .head h2 { grid-column: 1 / 7; }
    .intro { grid-column: 8 / 13; }
  }
</style>
