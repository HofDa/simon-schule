---
/**
 * "Der Lernraum" – Section 3 below the Whiteboard: the 5-step process, one line per step.
 * Shows the 5 steps in a single horizontal strip on desktop (`repeat(5, 1fr)`), each with its own
 * symbol (pen, plan, VS chair, hammer, telephone) and a numbered step badge.
 */
import StepSymbol, { type StepKind } from '../art/StepSymbol.astro';
import { getLang, useTranslations } from '../../../i18n/ui';
import { servicesFor } from '../../../data/services';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).services;
const services = servicesFor(lang);
// Beratung vor Ort, Planung, VS Möbel, Lieferung & Montage, Betreuung im Land
const symbols: StepKind[] = ['pen', 'plan', 'chair', 'hammer', 'phone'];
---

<section id="leistungen" class="lr-services" aria-labelledby="services-title" data-lr-services>
  <div class="shell">
    <div class="head" data-wb-reveal>
      <h2 id="services-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="intro">{t.intro}</p>
    </div>

    <ol class="desks" data-lr-desks>
      {services.map((service, index) => (
        <li class="desk" style={`--wb-d: ${index * 80}ms`} data-wb-reveal>
          <div class="desk-art" aria-hidden="true">
            <StepSymbol kind={symbols[index]} />
          </div>
          <div class="desk-card">
            <h3><span class="desk-n" aria-hidden="true">{index + 1}</span>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .lr-services { padding-block: clamp(56px, 6.5vw, 96px); }
  .head { display: grid; gap: 16px; margin-bottom: clamp(32px, 4vw, 48px); }
  .intro { max-width: 50ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.6; }

  .desks { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 28px 18px; }
  .desk { position: relative; z-index: 1; min-width: 0; display: flex; flex-direction: column; }
  .desk-art { width: min(100%, 130px); margin-inline: auto; }
  .desk-card {
    position: relative;
    margin-top: 12px;
    padding-top: 4px;
  }
  .desk-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
    background: var(--color-ginster);
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .desk h3 { display: flex; align-items: center; gap: 10px; font-size: clamp(1.18rem, 1.45vw, 1.45rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.12; }
  .desk p { margin-top: 6px; color: var(--color-muted); font-size: 0.88rem; line-height: 1.52; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .desk:not(.is-in) .desk-art {
      opacity: 0;
      translate: 0 12px;
    }
    .desk-art {
      transition:
        opacity 420ms var(--ease-draw) var(--wb-d, 0ms),
        translate 460ms var(--ease-draw) var(--wb-d, 0ms);
    }
    :global(html.js) .desk:not(.is-in) .desk-n {
      opacity: 0;
      scale: 0.4;
    }
    .desk-n {
      transition:
        opacity 260ms var(--ease-draw) calc(var(--wb-d, 0ms) + 140ms),
        scale 320ms cubic-bezier(0.34, 1.55, 0.64, 1) calc(var(--wb-d, 0ms) + 140ms),
        transform 200ms var(--ease-draw);
    }
    .desk:hover .desk-n {
      transform: scale(1.1);
    }

    /* each symbol does its job once when it comes into view: the pen writes, the hammer strikes, the phone rings */
    :global(html.js) .desk:not(.is-in) :global(.scribble) { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .desk.is-in :global(.scribble) {
      stroke-dasharray: 1;
      animation: step-write 900ms var(--ease-draw) calc(var(--wb-d, 0ms) + 350ms) both;
    }
    .desk.is-in :global(.pen) {
      transform-origin: 60px 96px;
      animation: step-pen 900ms ease-in-out calc(var(--wb-d, 0ms) + 350ms) both;
    }
    .desk.is-in :global(.hammer) {
      transform-origin: 34px 104px;
      animation: step-strike 520ms ease-in calc(var(--wb-d, 0ms) + 350ms) 2 both;
    }
    .desk.is-in :global(.handset) {
      transform-origin: 70px 66px;
      animation: step-ring 700ms ease-in-out calc(var(--wb-d, 0ms) + 350ms) 2 both;
    }
    @keyframes step-write { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes step-pen {
      0% { translate: -30px 0; }
      100% { translate: 0 0; }
    }
    @keyframes step-strike {
      0%, 100% { rotate: 0deg; }
      45% { rotate: -16deg; }
    }
    @keyframes step-ring {
      0%, 100% { rotate: 0deg; }
      20%, 60% { rotate: -7deg; }
      40%, 80% { rotate: 7deg; }
    }
  }

  :global(.board-reader-body) .desk-art,
  :global(.board-reader-body) .desk-n {
    opacity: 1 !important;
    translate: none !important;
    scale: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  @media (max-width: 639px) {
    .desks { grid-template-columns: 1fr; gap: 22px; }
    .desk { flex-direction: row; align-items: flex-start; gap: 14px; }
    .desk-art { flex: none; width: 76px; margin: 0; }
    .desk-card { flex: 1; min-width: 0; margin-top: 0; }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .desks { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 20px; row-gap: 32px; }
    .desk { grid-column: span 2; }
    .desk:nth-child(4) { grid-column: 2 / 4; }
    .desk:nth-child(5) { grid-column: 4 / 6; }
  }


  @media (min-width: 1024px) {
    .head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: end; }
    .head h2 { grid-column: 1 / 7; }
    .intro { grid-column: 8 / 13; }
    .desks { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px); }
  }
</style>

<script>
  import { revealOnce } from '../../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-lr-services]');
  if (section) {
    revealOnce(section.querySelectorAll('[data-wb-reveal]'));
  }
</script>
