---
/**
 * "Der Lernraum" – Section 4 below the Whiteboard: Compact VS Möbel System Overview.
 * Moves the pinned VS School Catalog 2026 (held by the VS kitchen magnet & Exklusivvertretung plaque)
 * directly beside the section heading, above a compact 5-zone architectural grid.
 */
import { vs } from '../../../data/site';
import { getLang, useTranslations } from '../../../i18n/ui';
import ResponsiveImage from '../ResponsiveImage.astro';
import vsLogoMagnet from '../../../assets/whiteboard/vs-logo-kitchen-magnet.webp';
import vsCatalogCover from '../../../assets/whiteboard/vs-school-catalog-cover-2026-nomark.webp';
import { lernraumCopy } from '../../../i18n/lernraum';
import JumperChair from '../art/JumperChair.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).vs;
const L = lernraumCopy(lang);
const J = L.vs.jumper;
const categories: { name: string; text: string; url?: string }[] = t.categories;
const catalogUrl = vs.catalogUrl[lang];
const vsSchoolCatalog = 'https://web-media.vs.de/file/p1/pdf/45-057-49_V2026-01_DE_Basics--Der-Katalog-fuer-die-Schule.archiv.pdf';
const areas = ['sit', 'tab', 'store', 'flex', 'kg'];
---

<section id="vs-moebel" class="lr-vs" aria-labelledby="vs-title" data-lr-vs>
  <div class="shell">
    <div class="head">
      <div class="head-copy" data-wb-reveal>
        <p class="exclusive-badge">{t.exclusive}</p>
        <h2 id="vs-title" class="mt-3 text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
        <p class="intro mt-5">{t.intro}</p>
        <div class="head-actions">
          <a href="#anfrage" class="btn btn-ink" data-open-form data-topic={L.vs.sampleTopic}>
            {L.vs.sample}
            <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
          </a>
          <a class="link-line text-meta font-semibold" href={catalogUrl} target="_blank" rel="noopener">
            {t.all} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="head-aside">
      <!-- Pinned VS School Catalog 2026 + VS Kitchen Magnet -->
      <div class="catalog-box" data-wb-reveal style="--wb-d: 80ms">
        <a class="catalog-pin" data-lr-catalog-pin href={vsSchoolCatalog} target="_blank" rel="noopener" aria-label={L.board.catalog.open}>
          <span class="catalog-magnet" aria-hidden="true">
            <ResponsiveImage src={vsLogoMagnet} alt="" width={110} widths={[90, 120]} sizes="56px" quality={88} loading="lazy" draggable="false" />
          </span>
          <span class="catalog-cover">
            <ResponsiveImage src={vsCatalogCover} alt={L.vs.catalogBadge} width={200} widths={[140, 200]} sizes="104px" quality={88} loading="lazy" draggable="false" />
            <span class="catalog-pdf-tag" aria-hidden="true">PDF ↗</span>
          </span>
        </a>
        <div class="catalog-meta">
          <p class="catalog-badge marker">{L.vs.catalogBadge}</p>
          <p class="catalog-sub">{L.vs.catalogSub}</p>
          <a class="link-line text-label font-semibold" href={vsSchoolCatalog} target="_blank" rel="noopener">
            {L.vs.catalogPdf} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- JUMPER by Jean Nouvel: hover makes it itch to jump, a click lets it jump (every third a salto) -->
      <div class="jumper" data-wb-reveal style="--wb-d: 160ms" data-lr-jumper>
        <button class="jumper-btn" type="button" aria-label={J.button} data-jumper-btn data-says={JSON.stringify(J.says)}>
          <span class="jumper-say marker" aria-hidden="true" data-jumper-say></span>
          <JumperChair class="jumper-art" label={J.alt} />
          <span class="jumper-hint marker" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 22 C10 18 8 11 11 3 M11 3 l-5 5 M11 3 l4 6" /></svg>
            {J.hint}
          </span>
        </button>
        <div class="jumper-meta">
          <p class="jumper-kicker">{J.kicker}</p>
          <p class="jumper-title marker">{J.title}</p>
          <p class="jumper-sub">{J.sub}</p>
          <a href="#anfrage" class="link-line text-label font-semibold" data-open-form data-topic={J.topic}>
            {J.cta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      </div>
    </div>

    <ul class="floor">
      {categories.map((c, i) => {
        const area = areas[i] ?? 'flex';
        const body = (
          <>
            <div class="zone-header">
              <span class="zone-name">{c.name}</span>
              {c.url ? (
                <span class="zone-action" aria-hidden="true">VS.de ↗</span>
              ) : (
                <span class="zone-action" aria-hidden="true">{L.vs.direct} →</span>
              )}
            </div>
            <span class="zone-text">{c.text}</span>
          </>
        );
        return (
          <li class={`zone zone-${area}${c.url ? '' : ' zone-direct'}`} data-wb-reveal style={`--wb-d: ${i * 70}ms`}>
            {c.url ? (
              <a class="zone-inner" href={c.url} target="_blank" rel="noopener">
                {body}
                <span class="sr-only">{t.newTab}</span>
              </a>
            ) : (
              <a class="zone-inner" href="#anfrage" data-open-form data-topic={L.vs.kgTopic}>
                {body}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .lr-vs {
    padding-block: clamp(56px, 6.5vw, 96px);
  }
  .head { display: grid; gap: 32px; align-items: center; }
  .exclusive-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .exclusive-badge::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .intro { max-width: 48ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.6; }
  .head-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }

  /* Pinned VS School Catalog 2026 in header */
  .catalog-box {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 0;
    background: transparent;
    border: 0;
  }
  .catalog-pin {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 12px;
    translate: 0 var(--cat-y, 0px);
    rotate: calc(-2deg + var(--cat-r, 0deg));
    transition: transform 220ms var(--ease-draw);
  }
  .catalog-pin:hover {
    transform: rotate(2deg) translateY(-2px);
  }
  .catalog-magnet {
    position: relative;
    z-index: 3;
    margin-bottom: -12px;
    width: 54px;
    rotate: 5deg;
    filter: drop-shadow(0 2px 0 rgba(41, 37, 29, 0.35)) drop-shadow(1px 4px 3px rgba(32, 32, 29, 0.25));
  }
  .catalog-magnet :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .catalog-cover {
    position: relative;
    display: block;
    width: 92px;
    background: #fff;
    box-shadow: 1px 2px 0 #d9d6ca, 2px 3px 0 #fff, 3px 10px 16px -8px rgba(32, 32, 29, 0.38);
  }
  .catalog-pdf-tag {
    position: absolute;
    right: -6px;
    top: 8px;
    padding: 2px 6px;
    border-radius: 2px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    box-shadow: 0 2px 4px rgba(32, 32, 29, 0.25);
    transition: background-color 180ms var(--ease-draw), color 180ms var(--ease-draw);
  }
  .catalog-pin:hover .catalog-pdf-tag,
  .catalog-pin:focus-visible .catalog-pdf-tag {
    background: var(--color-ginster);
    color: var(--color-ink);
  }
  .catalog-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .catalog-meta {
    min-width: 0;
  }
  .catalog-badge {
    font-size: var(--text-marker);
    color: var(--color-ginster-deep);
  }
  .catalog-sub {
    margin: 6px 0 12px;
    font-size: var(--text-label);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* Catalog and JUMPER share the left column */
  .head-aside {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3vw, 40px);
  }

  /* JUMPER: a drawn chair that hops when clicked */
  .jumper {
    display: flex;
    align-items: flex-end;
    gap: 22px;
    padding-bottom: 22px;
  }
  .jumper-btn {
    position: relative;
    flex: none;
    width: 92px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .jumper-btn:focus-visible {
    outline: 2px solid var(--color-ginster);
    outline-offset: 6px;
  }
  .jumper-btn :global(.jumper-art) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .jumper-btn:not(.is-jumping):hover :global(.jp-body) {
      animation: jp-itch 640ms var(--ease-draw) infinite;
    }
    .jumper-btn:not(.is-jumping):hover :global(.jp-shadow) {
      animation: jp-itch-shadow 640ms var(--ease-draw) infinite;
    }
  }
  @keyframes jp-itch {
    0%, 100% { transform: none; }
    30% { transform: scale(1.05, 0.93); }
    55% { transform: translateY(-5px) scale(0.98, 1.03) rotate(-2deg); }
    75% { transform: translateY(-2px) rotate(1.5deg); }
  }
  @keyframes jp-itch-shadow {
    0%, 100% { transform: none; }
    30% { transform: scaleX(1.06); }
    55% { transform: scaleX(0.9); }
  }

  .jumper-say {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 100%;
    padding: 2px 10px 4px;
    background: #f6dc78;
    color: var(--color-ink);
    font-size: 1.35rem;
    line-height: 1;
    white-space: nowrap;
    rotate: -6deg;
    box-shadow: 1px 2px 0 rgba(32, 32, 29, 0.18);
    opacity: 0;
    translate: -50% 0;
    pointer-events: none;
  }
  .jumper-hint {
    position: absolute;
    left: 50%;
    top: calc(100% + 2px);
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    color: var(--color-ginster-deep);
    font-size: 1.05rem;
    line-height: 1;
    white-space: nowrap;
    translate: -30% 0;
    rotate: -4deg;
    transition: opacity 260ms var(--ease-draw);
  }
  .jumper-hint svg {
    width: 18px;
    height: 18px;
    margin-bottom: 4px;
  }
  .jumper-btn.was-jumped .jumper-hint { opacity: 0; }

  .jumper-meta { min-width: 0; padding-top: 18px; }
  .jumper-kicker {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .jumper-title {
    margin-top: 2px;
    font-size: var(--text-marker);
    color: var(--color-ginster-deep);
  }
  .jumper-sub {
    margin: 6px 0 12px;
    max-width: 42ch;
    font-size: var(--text-label);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* Compact 5-zone architectural grid */
  .floor {
    position: relative;
    list-style: none;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(18px, 2vw, 24px);
    border: 0;
    background: transparent;
  }
  .zone-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 0;
    border: 0;
    border-radius: 0;
    transition: transform 220ms var(--ease-draw);
  }
  .zone:hover .zone-inner,
  .zone:focus-within .zone-inner {
    transform: translateY(-2px);
  }

  .zone-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .zone-name { min-width: 0; font-size: clamp(1.15rem, 1.4vw, 1.35rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; }
  .zone-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.74rem;
    font-weight: 600;
    color: #57554e;
    white-space: nowrap;
    transition: color 200ms var(--ease-draw), background-color 200ms var(--ease-draw);
  }
  .zone:hover .zone-action {
    color: var(--color-ink);
  }
  .zone-direct .zone-action {
    background: #f6dc78;
    padding: 2px 8px;
    border-radius: 2px;
    color: var(--color-ink);
  }
  .zone-direct .zone-action::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ink);
  }
  .zone-direct:hover .zone-action {
    background: var(--color-ginster);
  }
  .zone-text { margin-top: 8px; color: var(--color-muted); font-size: 0.85rem; line-height: 1.48; }

  @media (min-width: 640px) {
    .floor {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .zone-kg { grid-column: 1 / -1; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .head {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: 28px;
      align-items: center;
    }
    .head-aside { grid-column: 1; grid-row: 1; }
    .head-copy { grid-column: 2; grid-row: 1; }
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
    }
    .head-aside { grid-column: 1 / 6; grid-row: 1; }
    .head-copy { grid-column: 6 / 13; grid-row: 1; }
    .floor {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .zone-kg { grid-column: auto; }
  }

  /* phones: the catalog becomes a card with the cover beside its text, and the
     five ranges a numbered sheet instead of loose paragraphs */
  @media (max-width: 639px) {
    .head { gap: 28px; }
    .catalog-box {
      align-items: center;
      gap: 16px;
      padding: 12px 16px 16px 14px;
      border: 1px solid var(--color-line);
      border-left: 3px solid var(--color-ginster);
      background: var(--color-warm);
    }
    .catalog-pin { padding-top: 10px; }
    .catalog-magnet { width: 42px; margin-bottom: -10px; }
    .catalog-cover { width: 76px; }
    .catalog-pdf-tag { right: -8px; top: 6px; font-size: 0.56rem; }
    .catalog-badge { font-size: 1.45rem; line-height: 1; }
    .catalog-sub { margin: 6px 0 10px; font-size: 0.8rem; line-height: 1.45; }

    .floor {
      counter-reset: zone;
      margin-top: 28px;
      gap: 0;
      border: 1px solid var(--color-line);
      background: #fff;
      box-shadow: 0 1px 0 #e9e6dc, 2px 10px 18px -14px rgba(32, 32, 29, 0.35);
    }
    .zone { counter-increment: zone; }
    .zone + .zone { border-top: 1px solid var(--color-line); }
    .zone-inner {
      display: grid;
      grid-template-columns: 2.1rem minmax(0, 1fr);
      column-gap: 6px;
      padding: 14px 16px 15px 12px;
    }
    .zone-inner::before {
      content: counter(zone, decimal-leading-zero);
      grid-row: 1 / span 2;
      font-family: var(--font-marker);
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1;
      color: var(--color-ginster-deep);
    }
    .zone:hover .zone-inner, .zone:focus-within .zone-inner { transform: none; }
    .zone:hover, .zone:focus-within { background: var(--color-warm); }
    .zone-header { align-items: center; }
    .zone-name { font-size: 1.05rem; }
    .zone-text { margin-top: 4px; font-size: 0.82rem; line-height: 1.45; }
    .zone-direct { background: #fdf6dc; }
    .zone-direct .zone-action { font-size: 0.7rem; }
  }
</style>

<script>
  import { addScene, isMotionAllowed, revealOnce, viewProgress } from '../../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-lr-vs]');
  if (section) {
    revealOnce(section.querySelectorAll('[data-wb-reveal]'));

    setupJumper(section);

    const pin = section.querySelector<HTMLElement>('[data-lr-catalog-pin]');
    if (pin) {
      addScene({
        el: section,
        media: '(min-width: 1024px)',
        progress: viewProgress(1, 0),
        render: (p) => {
          const offset = isMotionAllowed() ? p - 0.5 : 0;
          pin.style.setProperty('--cat-y', `${(offset * 14).toFixed(1)}px`);
          pin.style.setProperty('--cat-r', `${(offset * 3).toFixed(2)}deg`);
        },
      });
    }
  }

  /** JUMPER hops on click: crouch, launch, land with a squash and a puff of dust.
      Every third click it lands a salto. Reduced motion: only the speech bubble appears. */
  function setupJumper(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>('[data-jumper-btn]');
    const body = btn?.querySelector<SVGGElement>('[data-jp-body]');
    const shadow = btn?.querySelector<SVGElement>('[data-jp-shadow]');
    const dust = btn?.querySelector<SVGGElement>('[data-jp-dust]');
    const spinner = btn?.querySelector<SVGGElement>('[data-jp-spin]');
    const say = btn?.querySelector<HTMLElement>('[data-jumper-say]');
    if (!btn || !body || !spinner || !shadow || !dust || !say) return;
    const lines: string[] = JSON.parse(btn.dataset.says ?? '[]');
    let count = 0;
    let busy = false;

    btn.addEventListener('click', () => {
      if (busy) return;
      const step = count % 3;
      count += 1;
      btn.classList.add('was-jumped');
      say.textContent = lines[step] ?? '';

      if (!isMotionAllowed()) {
        say.animate([{ opacity: 0 }, { opacity: 1, offset: 0.15 }, { opacity: 1, offset: 0.8 }, { opacity: 0 }], { duration: 1200 });
        return;
      }

      busy = true;
      btn.classList.add('is-jumping');
      const height = [-46, -78, -92][step];
      const spin = step === 2 ? -360 : 0;
      const duration = [820, 980, 1180][step];
      const at = (y: number, sx: number, sy: number, r = 0) => `translateY(${y}px) rotate(${r}deg) scale(${sx}, ${sy})`;
      if (spin) {
        spinner.animate(
          [
            { transform: 'rotate(0deg)' },
            { transform: 'rotate(0deg)', offset: 0.22, easing: 'cubic-bezier(0.3, 0, 0.3, 1)' },
            { transform: `rotate(${spin}deg)`, offset: 0.68 },
            { transform: `rotate(${spin}deg)` },
          ],
          { duration },
        );
      }

      const jump = body.animate(
        [
          { transform: at(0, 1, 1), easing: 'ease-out' },
          { transform: at(0, 1.14, 0.8), offset: 0.16, easing: 'cubic-bezier(0.2, 0.8, 0.4, 1)' },
          { transform: at(height * 0.7, 0.9, 1.12, -4), offset: 0.34, easing: 'ease-out' },
          { transform: at(height, 1, 1, 3), offset: 0.5, easing: 'ease-in' },
          { transform: at(0, 0.94, 1.08), offset: 0.7, easing: 'ease-out' },
          { transform: at(0, 1.18, 0.78), offset: 0.78, easing: 'ease-out' },
          { transform: at(0, 0.96, 1.05), offset: 0.9 },
          { transform: at(0, 1, 1) },
        ],
        { duration },
      );
      shadow.animate(
        [
          { transform: 'scaleX(1)', opacity: 0.08 },
          { transform: 'scaleX(1.12)', opacity: 0.1, offset: 0.16 },
          { transform: 'scaleX(0.45)', opacity: 0.04, offset: 0.5 },
          { transform: 'scaleX(1.2)', opacity: 0.1, offset: 0.78 },
          { transform: 'scaleX(1)', opacity: 0.08 },
        ],
        { duration },
      );
      dust.animate(
        [
          { opacity: 0, transform: 'scale(0.6)' },
          { opacity: 0, transform: 'scale(0.6)', offset: 0.74 },
          { opacity: 1, transform: 'scale(1)', offset: 0.8 },
          { opacity: 0, transform: 'scale(1.35) translateY(-4px)' },
        ],
        { duration },
      );
      say.animate(
        [
          { opacity: 0, transform: 'translateY(8px) scale(0.6)' },
          { opacity: 0, transform: 'translateY(8px) scale(0.6)', offset: 0.2 },
          { opacity: 1, transform: `translateY(${height * 0.28}px) scale(1.08)`, offset: 0.4 },
          { opacity: 1, transform: `translateY(${height * 0.34}px) scale(1)`, offset: 0.85 },
          { opacity: 0, transform: `translateY(${height * 0.4}px) scale(0.95)` },
        ],
        { duration: duration + 400 },
      );
      jump.finished.finally(() => {
        busy = false;
        btn.classList.remove('is-jumping');
      });
    });
  }
</script>
