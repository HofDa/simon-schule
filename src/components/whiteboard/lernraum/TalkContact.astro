---
/**
 * "Der Lernraum" – Section 6 below the Whiteboard: People, Locations, FAQ Drawer & Direct Line.
 * No inquiry form (Änderungen 23.11.2026: a form felt old-fashioned). Instead `#anfrage` is Simon
 * Brugger in person, pinned to the board with his direct number and e-mail; every "Projekt anfragen"
 * link on the page ([data-open-form]) leads here, and its `data-topic` becomes the e-mail's subject.
 * Next to it: the HOUSE70 Meran & Brixen card and a compact closed-by-default FAQ accordion.
 */
import { contact, fullName, locations, people, roleFor } from '../../../data/site';
import { getLang, useTranslations } from '../../../i18n/ui';
import Magnet from '../Magnet.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import house70Magnet from '../../../assets/whiteboard/house70-fridge-magnet-natural.webp';
import simonStanding from '../../../assets/whiteboard/simon-standing.webp';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const t = ui.contact;
const pt = ui.people;
const L = lernraumCopy(lang);
const [simon] = people;
const simonName = fullName(simon);
const simonRole = roleFor(simon, lang);
const directPhone = simon.phone ?? contact.phone;
const phoneHref = directPhone ? `tel:${directPhone.replace(/[^\d+]/g, '')}` : null;
const mailHref = (topic?: string) => `mailto:${simon.email}?subject=${encodeURIComponent(L.talk.mailSubject(topic))}`;
// the subject's lead-in for a topic chosen elsewhere on the page ("Anfrage: ")
const subjectPrefix = L.talk.mailSubject('·').slice(0, -1);
---

<section id="kontakt" class="lr-talk" aria-labelledby="contact-title" data-lr-talk>
  <div class="shell grid-wrap">
    <div id="menschen" class="copy">
      <div data-wb-reveal>
        <h2 id="contact-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
        <p class="mt-4 max-w-[42ch] text-body leading-[1.6] text-muted">{t.lead}</p>
      </div>

      <!-- Open HOUSE70 Meran & Brixen Block -->
      <div class="house-row" data-wb-reveal style="--wb-d: 100ms">
        <div class="house-card-head">
          <div class="house-thumb" aria-hidden="true">
            <ResponsiveImage src={house70Magnet} alt="" width={100} widths={[80, 120]} sizes="48px" quality={88} loading="lazy" draggable="false" />
          </div>
          <div class="min-w-0">
            <p class="talk-eyebrow">{L.board.house.place}</p>
            <h3 class="house-title">{pt.teamTitle}</h3>
            <p class="talk-role">{pt.teamRole}</p>
          </div>
        </div>
        <ul class="house-locations">
          {locations.map((loc) => (
            <li>
              <strong>{loc.city[lang]}</strong>
              <span>{loc.street[lang]}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="setting">
      <!-- Simon in person: the page's inquiry point, call or e-mail instead of a form -->
      <article id="anfrage" class="direct" tabindex="-1" aria-labelledby="direct-title" data-direct data-wb-pin style="--wb-d: 140ms">
        <Magnet />
        <div class="direct-person">
          <ResponsiveImage
            class="direct-photo"
            src={simonStanding}
            alt={L.talk.photoAlt(simonName)}
            width={240}
            widths={[160, 240, 360, 480]}
            sizes="(min-width: 1024px) 190px, (min-width: 640px) 170px, 120px"
            quality={86}
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="direct-body">
          <div class="direct-head">
            <p class="talk-eyebrow">{L.talk.directEyebrow}</p>
            <h3 id="direct-title" class="direct-title">{L.talk.directTitle}</h3>
            <p class="direct-who"><strong>{simonName}</strong>{simonRole && <span>{simonRole}</span>}</p>
          </div>
          <div class="direct-actions">
            {phoneHref && (
              <a class="direct-call" href={phoneHref} data-direct-call>
                <span class="direct-icon" aria-hidden="true">☏</span>
                <span><small>{L.talk.call}</small>{directPhone}</span>
              </a>
            )}
            {simon.email && (
              <div class="direct-mail-row">
                <a
                  class="direct-mail"
                  href={mailHref()}
                  data-direct-mail
                  data-mail-base={`mailto:${simon.email}`}
                  data-default-href={mailHref()}
                  data-subject-prefix={subjectPrefix}
                >
                  <span class="direct-icon" aria-hidden="true">✉</span>
                  <span><small>{L.talk.mail}</small>{simon.email}</span>
                </a>
                <button
                  type="button"
                  class="direct-copy"
                  data-copy-mail={simon.email}
                  data-copy-default={L.talk.copyMail}
                  data-copy-done={L.talk.copied}
                  data-copy-failed={L.talk.copyFailed}
                  data-copy-say={L.talk.copiedAnnouncement(simon.email)}
                  aria-label={L.talk.copyMailLabel(simon.email)}
                >
                  <svg class="copy-icon copy-icon-idle" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="5.5" y="5.5" width="8" height="8" rx="1" />
                    <path d="M10.5 5.5V3.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
                  </svg>
                  <svg class="copy-icon copy-icon-done" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span data-copy-label>{L.talk.copyMail}</span>
                </button>
              </div>
            )}
          </div>
          {simon.email && (
            <div class="direct-topics">
              <div class="direct-topic-bar" data-topic-bar hidden>
                <span class="topic-bar-text">
                  <small>{L.talk.subjectLabel}:</small> <strong data-topic-value></strong>
                </span>
                <button type="button" class="topic-bar-clear" data-topic-clear aria-label={L.talk.clearTopic}>×</button>
              </div>
              <div class="direct-quick" role="group" aria-label={L.talk.quickTopicsLabel}>
                {L.talk.quickTopics.map((item) => (
                  <button
                    type="button"
                    class="quick-chip"
                    data-quick-topic={item.topic}
                    aria-pressed="false"
                  >
                    {item.label}
                  </button>
                ))}
              </div>
              <p class="sr-only" role="status" aria-live="polite" data-direct-status></p>
            </div>
          )}
          <p class="talk-promise">{L.talk.responsePromise}</p>
          <p class="direct-steps-head">{L.talk.stepsHeading}</p>
          <ol class="direct-steps">
            {L.talk.steps.map((step) => <li>{step}</li>)}
          </ol>
        </div>
      </article>
    </div>

    <!-- Compact closed-by-default FAQ drawer, below the direct line -->
    <details class="faq-drawer" id="faq" data-wb-reveal style="--wb-d: 140ms">
      <summary class="faq-summary">
        <span>{L.faq.eyebrow}: {L.faq.title}</span>
        <span class="faq-toggle" aria-hidden="true"></span>
      </summary>
      <dl class="faq-list">
        {L.faq.items.map((item) => (
          <div class="faq-item">
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>
    </details>
  </div>
</section>

<style>
  .lr-talk { padding-block: clamp(56px, 7vw, 108px); }
  .grid-wrap { display: grid; gap: 40px; }

  .talk-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ginster-deep);
  }
  .talk-role {
    font-size: var(--text-label);
    color: var(--color-muted);
    line-height: 1.35;
  }
  .talk-promise {
    margin-top: 10px;
    padding: 4px 9px;
    display: inline-block;
    background: #f6dc78;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    rotate: -0.6deg;
  }

  .house-row {
    margin-top: 24px;
  }
  .house-card-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .house-thumb img {
    display: block;
    width: 44px;
    height: auto;
    rotate: -3deg;
    filter:
      drop-shadow(1.5px 0 0 #fbf7ec)
      drop-shadow(-1.5px 0 0 #fbf7ec)
      drop-shadow(0 1.5px 0 #fbf7ec)
      drop-shadow(0 -1.5px 0 #fbf7ec)
      drop-shadow(1px 5px 4px rgba(32, 32, 29, 0.25));
  }
  .house-title {
    margin-top: 2px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .house-locations {
    list-style: none;
    margin: 12px 0 0;
    padding: 6px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 14px;
    font-size: var(--text-label);
  }
  .house-locations li {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .house-locations span {
    color: var(--color-muted);
  }

  /* Compact closed-by-default FAQ accordion */
  .faq-drawer {
    margin-top: 22px;
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding-block: 10px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-toggle::before {
    content: '+';
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-ginster-deep);
  }
  .faq-drawer[open] .faq-toggle::before {
    content: '–';
  }
  .faq-list {
    margin: 0 0 16px;
    display: grid;
    gap: 14px;
  }
  .faq-item {
    padding-top: 10px;
  }
  .faq-item dt {
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.35;
  }
  .faq-item dd {
    margin: 4px 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .setting { display: flex; flex-direction: column; align-items: stretch; }
  .direct {
    position: relative;
    display: grid;
    grid-template-columns: clamp(104px, 26%, 190px) minmax(0, 1fr);
    align-items: end;
    gap: clamp(14px, 2.6vw, 36px);
    width: 100%;
    padding: clamp(22px, 3vw, 40px) clamp(20px, 3vw, 40px) clamp(22px, 3vw, 36px);
    border-top: 4px solid var(--color-ginster);
    border-radius: 3px;
    background: var(--color-paper);
    box-shadow: 0 24px 52px -24px rgba(32, 32, 29, 0.34);
    outline: none;
    transition: box-shadow 350ms var(--ease-draw);
  }
  .direct.is-arriving {
    box-shadow: 0 0 0 3px var(--color-ginster), 0 24px 52px -24px rgba(32, 32, 29, 0.34);
  }
  .direct-person { align-self: end; padding-bottom: 6px; }
  .direct-person :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(6px 10px 10px rgba(32, 32, 29, 0.18));
  }
  .direct-body { min-width: 0; align-self: center; }
  .direct-title {
    margin-top: 6px;
    font-family: var(--font-hand);
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.05;
  }
  .direct-who {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    font-size: var(--text-label);
    line-height: 1.35;
    color: var(--color-muted);
  }
  .direct-who strong { font-size: var(--text-meta); color: var(--color-ink); }
  .direct-actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .direct-call,
  .direct-mail {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 8px 18px 8px 14px;
    border-radius: 3px;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
    transition: transform 200ms var(--ease-draw), box-shadow 200ms var(--ease-draw), background-color 200ms;
  }
  .direct-call { background: var(--color-ink); color: #fff; font-size: clamp(1.1rem, 1.5vw, 1.35rem); font-variant-numeric: tabular-nums; }
  .direct-mail-row { display: flex; align-items: stretch; gap: 8px; min-width: 0; }
  .direct-mail { flex: 1 1 auto; min-width: 0; background: #fff; color: var(--color-ink); box-shadow: inset 0 0 0 1.5px #d9d5c9; font-size: var(--text-meta); }
  .direct-call:hover, .direct-mail:hover { transform: translateY(-2px); }
  .direct-call:hover { box-shadow: 0 10px 18px -10px rgba(32, 32, 29, 0.6); }
  .direct-mail:hover { box-shadow: inset 0 0 0 1.5px var(--color-ginster), 0 10px 18px -12px rgba(32, 32, 29, 0.35); }
  .direct-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 56px;
    min-width: 48px;
    padding: 0 14px;
    border: 0;
    border-radius: 3px;
    background: var(--color-warm);
    box-shadow: inset 0 0 0 1.5px #d9d5c9;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-label);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 200ms var(--ease-draw), box-shadow 200ms var(--ease-draw), background-color 200ms, color 200ms;
  }
  .direct-copy:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1.5px var(--color-ginster); }
  .direct-copy.is-copied { background: var(--color-ink); color: #fff; box-shadow: inset 0 0 0 1.5px var(--color-ink); }
  .copy-icon { flex: none; }
  .copy-icon-done { display: none; color: var(--color-ginster-light); }
  .direct-copy.is-copied .copy-icon-idle { display: none; }
  .direct-copy.is-copied .copy-icon-done { display: block; }
  .direct-topics {
    margin-top: 12px;
    display: grid;
    gap: 8px;
  }
  .direct-topic-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px 6px 12px;
    border-left: 3px solid var(--color-ginster);
    background: var(--color-warm);
    font-size: var(--text-label);
    line-height: 1.35;
    color: var(--color-ink);
  }
  .direct-topic-bar[hidden] { display: none; }
  .topic-bar-text { min-width: 0; overflow-wrap: anywhere; }
  .topic-bar-text small { color: var(--color-muted); font-size: inherit; font-weight: 600; }
  .topic-bar-clear {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .topic-bar-clear:hover { background: rgba(32, 32, 29, 0.08); color: var(--color-ink); }
  .direct-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .quick-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 4px 10px;
    border: 1px solid #d9d5c9;
    border-radius: 2px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }
  .quick-chip:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .quick-chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }
  .quick-chip[aria-pressed='true']::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  @media (pointer: coarse) {
    .quick-chip { min-height: 44px; padding-inline: 12px; }
    .topic-bar-clear { width: 44px; height: 44px; }
  }
  @media (max-width: 420px) {
    .direct-mail-row { flex-direction: column; }
    .direct-copy { min-height: 44px; }
  }
  .direct-call small, .direct-mail small {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .direct-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-ginster);
    color: var(--color-ink);
    font-size: 1.1rem;
  }
  .direct-steps-head {
    margin-top: 20px;
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--color-ink);
  }
  .direct-steps {
    margin: 6px 0 0;
    padding-left: 1.2em;
    list-style: decimal;
    display: grid;
    gap: 4px;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .direct-steps li::marker { color: var(--color-ginster-deep); font-weight: 700; }

  /* phones: Simon stands at the top right, beside the heading, the actions run underneath */
  @media (max-width: 519px) {
    .direct { grid-template-columns: minmax(0, 1fr) 66px; gap: 0 12px; align-items: start; }
    .direct-person { grid-column: 2; grid-row: 1; margin: 0; }
    .direct-body { display: contents; }
    .direct-head { grid-column: 1; grid-row: 1; align-self: center; }
    .direct-actions, .direct-topics, .talk-promise, .direct-steps-head, .direct-steps { grid-column: 1 / -1; }
  }

  @media (min-width: 1024px) {
    .grid-wrap {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .copy { grid-column: 1 / 6; position: sticky; top: 96px; }
    .setting { grid-column: 6 / 13; }
    .faq-drawer { grid-column: 6 / 13; margin-top: 0; }
  }
  @media (max-width: 480px) {
    .house-locations { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { revealOnce } from '../../../scripts/motion';

  const talkSection = document.querySelector<HTMLElement>('[data-lr-talk]');
  if (talkSection) {
    revealOnce(talkSection.querySelectorAll('[data-wb-reveal], [data-wb-pin]'));
  }

  // Every "Projekt anfragen" link leads to Simon's direct line; a topic chosen on the way
  // (a project, an arrangement, a VS sample) becomes the subject of the prepared e-mail.
  const direct = document.getElementById('anfrage');
  const mail = direct?.querySelector<HTMLAnchorElement>('[data-direct-mail]');
  const topicBar = direct?.querySelector<HTMLElement>('[data-topic-bar]');
  const topicValue = direct?.querySelector<HTMLElement>('[data-topic-value]');
  const topicClear = direct?.querySelector<HTMLButtonElement>('[data-topic-clear]');
  const quickChips = Array.from(direct?.querySelectorAll<HTMLButtonElement>('[data-quick-topic]') ?? []);
  const copyButton = direct?.querySelector<HTMLButtonElement>('[data-copy-mail]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-copy-label]');
  const status = direct?.querySelector<HTMLElement>('[data-direct-status]');

  if (direct) {
    let activeTopic = '';
    const applyTopic = (raw?: string) => {
      activeTopic = raw?.trim() ?? '';
      if (mail) {
        if (activeTopic) {
          const subject = `${mail.dataset.subjectPrefix ?? ''}${activeTopic}`;
          mail.href = `${mail.dataset.mailBase}?subject=${encodeURIComponent(subject)}`;
        } else if (mail.dataset.defaultHref) {
          mail.href = mail.dataset.defaultHref;
        }
      }
      if (topicBar && topicValue) {
        topicBar.hidden = !activeTopic;
        topicValue.textContent = activeTopic;
      }
      quickChips.forEach((chip) => {
        chip.setAttribute('aria-pressed', String(Boolean(activeTopic) && chip.dataset.quickTopic === activeTopic));
      });
    };

    topicClear?.addEventListener('click', () => applyTopic(''));
    quickChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const chosen = chip.dataset.quickTopic ?? '';
        applyTopic(activeTopic === chosen ? '' : chosen);
      });
    });

    if (copyButton && copyLabel) {
      let copyTimer: number | undefined;
      copyButton.addEventListener('click', async () => {
        const email = copyButton.dataset.copyMail ?? '';
        if (!email) return;
        let ok = false;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(email);
            ok = true;
          }
        } catch {
          ok = false;
        }
        if (!ok) {
          const area = document.createElement('textarea');
          area.value = email;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.append(area);
          area.select();
          try {
            const legacyCopy = Reflect.get(document, 'execCommand') as ((commandId: string) => boolean) | undefined;
            ok = Boolean(legacyCopy?.call(document, 'copy'));
          } catch {
            ok = false;
          }
          area.remove();
        }
        window.clearTimeout(copyTimer);
        copyButton.classList.toggle('is-copied', ok);
        copyLabel.textContent = ok ? (copyButton.dataset.copyDone ?? '') : (copyButton.dataset.copyFailed ?? '');
        if (status) status.textContent = ok ? (copyButton.dataset.copySay ?? '') : (copyButton.dataset.copyFailed ?? '');
        copyTimer = window.setTimeout(() => {
          copyButton.classList.remove('is-copied');
          copyLabel.textContent = copyButton.dataset.copyDefault ?? '';
        }, 2200);
      });
    }

    let arriveTimer: number | undefined;
    document.querySelectorAll<HTMLElement>('[data-open-form]').forEach((el) =>
      el.addEventListener('click', (event) => {
        event.preventDefault();
        applyTopic(el.dataset.topic);
        const inReader = Boolean(direct.closest('[data-board-reader][open]'));
        if (!inReader) {
          const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          direct.scrollIntoView({ behavior, block: 'center' });
          history.replaceState(null, '', '#anfrage');
        }
        window.clearTimeout(arriveTimer);
        direct.classList.add('is-arriving');
        arriveTimer = window.setTimeout(() => direct.classList.remove('is-arriving'), 900);
        direct.focus({ preventScroll: true });
      }),
    );
  }
</script>
