---
/**
 * "Der Lernraum" – Section 6 below the Whiteboard: Consolidated People, Locations, FAQ Drawer & Low-Friction Form.
 * Houses Simon Brugger's pinned business card (`#menschen`), the HOUSE70 Meran & Brixen card,
 * a compact closed-by-default FAQ accordion, and the clean `#anfrage` inquiry desk (`SmartContactForm`).
 */
import { contact, fullName, locations, people, roleFor } from '../../../data/site';
import { asset } from '../../../lib/paths';
import { getLang, useTranslations } from '../../../i18n/ui';
import SmartContactForm from './SmartContactForm.astro';
import Magnet from '../Magnet.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import house70Magnet from '../../../assets/whiteboard/house70-fridge-magnet-natural.webp';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const t = ui.contact;
const pt = ui.people;
const L = lernraumCopy(lang);
const [simon] = people;
const simonName = fullName(simon);
const simonInitials = [simon.firstName, simon.lastName].filter(Boolean).map((n) => n![0]).join('');
const simonRole = roleFor(simon, lang);
const directPhone = simon.phone ?? contact.phone;
const phoneHref = directPhone ? `tel:${directPhone.replace(/[^\d+]/g, '')}` : null;
---

<section id="kontakt" class="lr-talk" aria-labelledby="contact-title" data-lr-talk>
  <div class="shell grid-wrap">
    <div id="menschen" class="copy">
      <div data-wb-reveal>
        <h2 id="contact-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
        <p class="mt-4 max-w-[42ch] text-body leading-[1.6] text-muted">{t.lead}</p>
      </div>

      <!-- Simon Brugger's pinned whiteboard business card -->
      <article class="talk-card" data-wb-pin style="--wb-d: 0ms">
        <Magnet />
        <div class="talk-card-top">
          {simon.photo ? (
            <img
              class="talk-photo"
              src={asset(`images/team/${simon.photo}.webp`)}
              alt={pt.portraitAlt(simonName)}
              width="64"
              height="80"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="talk-stamp" aria-hidden="true">{simonInitials}</span>
          )}
          <div class="min-w-0">
            <p class="talk-eyebrow">{L.board.card.eyebrow}</p>
            <h3 class="talk-name">{simonName}</h3>
            {simonRole && <p class="talk-role">{simonRole}</p>}
            <p class="talk-note">{L.board.card.note}</p>
          </div>
        </div>
        <div class="talk-card-links">
          {simon.email && (
            <a href={`mailto:${simon.email}`}>
              <span aria-hidden="true">✉</span> {simon.email}
            </a>
          )}
          {phoneHref && (
            <a href={phoneHref}>
              <span aria-hidden="true">☏</span> {directPhone}
            </a>
          )}
        </div>
        <p class="talk-promise">{L.talk.responsePromise}</p>
      </article>

      <!-- Open HOUSE70 Meran & Brixen Block -->
      <div class="house-row" data-wb-reveal style="--wb-d: 100ms">
        <div class="house-card-head">
          <div class="house-thumb" aria-hidden="true">
            <ResponsiveImage src={house70Magnet} alt="" width={100} widths={[80, 120]} sizes="48px" quality={88} loading="lazy" draggable="false" />
          </div>
          <div class="min-w-0">
            <p class="talk-eyebrow">{L.board.house.place}</p>
            <h3 class="house-title">{pt.teamTitle}</h3>
            <p class="talk-role">{pt.teamRole}</p>
          </div>
        </div>
        <ul class="house-locations">
          {locations.map((loc) => (
            <li>
              <strong>{loc.city[lang]}</strong>
              <span>{loc.street[lang]}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Compact closed-by-default FAQ drawer -->
      <details class="faq-drawer" id="faq" data-wb-reveal style="--wb-d: 140ms">
        <summary class="faq-summary">
          <span>{L.faq.eyebrow}: {L.faq.title}</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </summary>
        <dl class="faq-list">
          {L.faq.items.map((item) => (
            <div class="faq-item">
              <dt>{item.question}</dt>
              <dd>{item.answer}</dd>
            </div>
          ))}
        </dl>
      </details>
    </div>

    <div class="setting">
      <div id="anfrage" class="desk" tabindex="-1" data-phase-context={L.talk.phaseContext} data-topic-key={L.form.topicKey} data-wb-pin style="--wb-d: 140ms">
        <Magnet />
        <SmartContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .lr-talk { padding-block: clamp(56px, 7vw, 108px); }
  .grid-wrap { display: grid; gap: 40px; }

  .talk-card {
    position: relative;
    margin-top: 24px;
    padding: 20px 20px 16px;
    background: #fffefb;
    border: 0;
    box-shadow: inset 4px 0 0 var(--color-ginster), 2px 14px 24px -14px rgba(32, 32, 29, 0.24);
    transform: rotate(-0.5deg);
    transition: transform 220ms var(--ease-draw), box-shadow 220ms var(--ease-draw);
  }
  .talk-card:hover {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: inset 4px 0 0 var(--color-ginster), 4px 18px 28px -14px rgba(32, 32, 29, 0.3);
  }
  .talk-card-top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .talk-stamp {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 2px solid var(--color-ginster);
    border-radius: 50%;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 700;
    rotate: -8deg;
  }
  .talk-photo {
    flex: none;
    width: 52px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }
  .talk-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ginster-deep);
  }
  .talk-name {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .talk-role {
    font-size: var(--text-label);
    color: var(--color-muted);
    line-height: 1.35;
  }
  .talk-note {
    margin-top: 3px;
    font-family: var(--font-marker);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1;
    color: #22305f;
  }
  .talk-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 12px;
    padding-top: 10px;
  }
  .talk-card-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: #d9d5c9;
    text-underline-offset: 3px;
  }
  .talk-card-links a:hover { text-decoration-color: var(--color-ginster); }
  .talk-card-links a span { color: var(--color-ginster-deep); text-decoration: none; }
  .talk-promise {
    margin-top: 10px;
    padding: 4px 9px;
    display: inline-block;
    background: #f6dc78;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    rotate: -0.6deg;
  }

  .house-row {
    margin-top: 24px;
  }
  .house-card-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .house-thumb img {
    display: block;
    width: 44px;
    height: auto;
    rotate: -3deg;
    filter:
      drop-shadow(1.5px 0 0 #fbf7ec)
      drop-shadow(-1.5px 0 0 #fbf7ec)
      drop-shadow(0 1.5px 0 #fbf7ec)
      drop-shadow(0 -1.5px 0 #fbf7ec)
      drop-shadow(1px 5px 4px rgba(32, 32, 29, 0.25));
  }
  .house-title {
    margin-top: 2px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .house-locations {
    list-style: none;
    margin: 12px 0 0;
    padding: 6px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 14px;
    font-size: var(--text-label);
  }
  .house-locations li {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .house-locations span {
    color: var(--color-muted);
  }

  /* Compact closed-by-default FAQ accordion */
  .faq-drawer {
    margin-top: 22px;
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding-block: 10px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-toggle::before {
    content: '+';
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-ginster-deep);
  }
  .faq-drawer[open] .faq-toggle::before {
    content: '–';
  }
  .faq-list {
    margin: 0 0 16px;
    display: grid;
    gap: 14px;
  }
  .faq-item {
    padding-top: 10px;
  }
  .faq-item dt {
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.35;
  }
  .faq-item dd {
    margin: 4px 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .setting { display: flex; flex-direction: column; align-items: stretch; }
  .desk {
    position: relative;
    width: 100%;
    padding: clamp(24px, 3vw, 40px);
    border: 0;
    border-top: 4px solid var(--color-ginster);
    border-radius: 3px;
    background: var(--color-paper);
    box-shadow: 0 24px 52px -24px rgba(32, 32, 29, 0.34);
    outline: none;
    transition: box-shadow 350ms var(--ease-draw);
  }
  .desk.is-arriving {
    box-shadow: 0 0 0 3px var(--color-ginster), 0 24px 52px -24px rgba(32, 32, 29, 0.34);
  }

  @media (min-width: 1024px) {
    .grid-wrap {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .copy { grid-column: 1 / 6; position: sticky; top: 96px; }
    .setting { grid-column: 6 / 13; }
  }
  @media (max-width: 480px) {
    .house-locations { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .talk-card:not(.is-in) .talk-stamp {
      opacity: 0;
    }
    .talk-card.is-in .talk-stamp {
      animation: sb-stamp 360ms cubic-bezier(0.22, 1.35, 0.36, 1) 240ms both;
    }
    @keyframes sb-stamp {
      from {
        opacity: 0;
        scale: 1.3;
        rotate: -20deg;
      }
      to {
        opacity: 1;
        scale: 1;
        rotate: -8deg;
      }
    }
  }
  :global(.board-reader-body) .talk-stamp {
    opacity: 1 !important;
    scale: 1 !important;
    rotate: -8deg !important;
    animation: none !important;
  }
</style>

<script>
  import { revealOnce } from '../../../scripts/motion';

  const talkSection = document.querySelector<HTMLElement>('[data-lr-talk]');
  if (talkSection) {
    revealOnce(talkSection.querySelectorAll('[data-wb-reveal], [data-wb-pin]'));
  }

  const desk = document.getElementById('anfrage');
  if (desk) {
    const contextBar = desk.querySelector<HTMLElement>('[data-context-bar]');
    const contextLabel = desk.querySelector<HTMLElement>('[data-context-label]');
    const contextClear = desk.querySelector<HTMLButtonElement>('[data-context-clear]');
    const topicChips = desk.querySelector<HTMLElement>('[data-topic-chips]');
    const textarea = desk.querySelector<HTMLTextAreaElement>('#lr-msg');

    let autoTopicInput: HTMLInputElement | null = null;
    let autoQuestionBlock: string | null = null;
    let arriveTimer: number | undefined;

    const highlightDesk = () => {
      window.clearTimeout(arriveTimer);
      desk.classList.add('is-arriving');
      arriveTimer = window.setTimeout(() => desk.classList.remove('is-arriving'), 900);
    };

    const showContext = (text: string) => {
      if (!contextBar || !contextLabel) return;
      contextLabel.textContent = text;
      contextBar.hidden = false;
      contextBar.classList.remove('is-pulsing');
      void contextBar.offsetWidth;
      contextBar.classList.add('is-pulsing');
    };

    const clearAutoTopic = () => {
      if (!autoTopicInput) return;
      autoTopicInput.checked = false;
      if (autoTopicInput.hasAttribute('data-dynamic-topic')) {
        autoTopicInput.closest('label')?.remove();
      }
      autoTopicInput = null;
    };

    contextClear?.addEventListener('click', () => {
      if (contextBar) contextBar.hidden = true;
      desk.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((radio) => {
        radio.checked = false;
      });
      clearAutoTopic();
      if (autoQuestionBlock && textarea && textarea.value.includes(autoQuestionBlock)) {
        textarea.value = textarea.value.replace(autoQuestionBlock, '').replace(/\n{3,}/g, '\n\n').trim();
      }
      autoQuestionBlock = null;
      desk.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });

    const selectTopicChip = (topic: string) => {
      if (!topicChips) return;
      const inputs = Array.from(topicChips.querySelectorAll<HTMLInputElement>('[data-topic-input]'));
      let matched = inputs.find((input) => input.value.toLowerCase() === topic.toLowerCase());
      if (autoTopicInput && autoTopicInput !== matched) clearAutoTopic();
      if (!matched) {
        // Dynamically add a chip if a specific VS arrangement or reference school was chosen
        const label = document.createElement('label');
        label.className = 'chip';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = desk.dataset.topicKey ?? 'Thema';
        input.value = topic;
        input.className = 'sr-only';
        input.setAttribute('data-topic-input', '');
        input.setAttribute('data-dynamic-topic', '');
        const span = document.createElement('span');
        span.textContent = topic;
        label.append(input, span);
        topicChips.prepend(label);
        matched = input;
      }
      matched.checked = true;
      autoTopicInput = matched;
    };

    document.querySelectorAll<HTMLElement>('[data-open-form]').forEach((el) =>
      el.addEventListener('click', (event) => {
        event.preventDefault();
        const phase = el.dataset.phase;
        const topic = el.dataset.topic;
        const question = el.dataset.question;

        if (phase) {
          desk.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((radio) => {
            radio.checked = radio.value === phase;
          });
        }

        if (topic) {
          selectTopicChip(topic);
        }

        if (phase && topic) {
          showContext(`${phase} · ${topic}`);
        } else if (topic) {
          showContext(topic);
        } else if (phase) {
          showContext(`${desk.dataset.phaseContext}: ${phase}`);
        }

        if (question && textarea) {
          const line = `${question}\n→ `;
          if (!textarea.value.includes(question)) {
            textarea.value = textarea.value ? `${textarea.value.trimEnd()}\n\n${line}` : line;
          }
          autoQuestionBlock = line;
          showContext(question);
        }

        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        desk.scrollIntoView({ behavior, block: 'start' });
        highlightDesk();
        window.setTimeout(() => {
          if (question && textarea) {
            textarea.focus({ preventScroll: true });
            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
          } else {
            const firstEmpty = Array.from(desk.querySelectorAll<HTMLInputElement>('input[required]')).find((input) => !input.value.trim());
            (firstEmpty ?? desk.querySelector<HTMLInputElement>('#lr-name'))?.focus({ preventScroll: true });
          }
        }, behavior === 'smooth' ? 600 : 0);
        history.replaceState(null, '', '#anfrage');
      }),
    );
  }
</script>
