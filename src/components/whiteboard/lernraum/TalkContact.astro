---
/**
 * "Der Lernraum" – Section 7: Einzelgespräch (Always-Open Desk Contact).
 * Simon & Rene sit on one side of the table, "Ihr Platz" is on the other, and the inquiry form
 * lies open on the desk between them. Any link with `data-open-form` (`data-phase`, `data-topic`,
 * `data-question`) pre-fills the form and scrolls smoothly to the desk.
 */
import { contact, fullName, people } from '../../../data/site';
import { getLang, useTranslations } from '../../../i18n/ui';
import SmartContactForm from './SmartContactForm.astro';
import Lesson from '../klassenzimmer/Lesson.astro';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).contact;
const L = lernraumCopy(lang);
const names = people.map((p) => fullName(p)).join(' · ');

const stepsAfterSubmit = L.talk.steps;
---

<section id="kontakt" class="lr-talk" aria-labelledby="contact-title">
  <div class="shell grid-wrap">
    <div class="copy">
      <Lesson n="06" name={L.lesson.contact.name} note={L.lesson.contact.note} layout="talk" from="stations" />
      <h2 id="contact-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="mt-6 max-w-[40ch] text-body leading-[1.65] text-muted lg:text-lead">{t.lead}</p>

      <div class="next-steps">
        <p class="next-heading">{L.talk.stepsHeading}</p>
        <ol class="next-list">
          {stepsAfterSubmit.map((step, i) => (
            <li>
              <span class="next-num" aria-hidden="true">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="direct mt-8 text-meta">
        {L.talk.direct}{' '}
        {contact.phone ? (
          <a class="link-line font-semibold" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{t.call}</a>
        ) : (
          <a class="link-line font-semibold" href={`mailto:${contact.email}`}>{contact.email}</a>
        )}
      </p>
    </div>

    <div class="setting">
      <p class="chair-row" aria-hidden="true">
        <svg class="chair chair-them" viewBox="-12 -12 24 24"><use href="#kz-chair" x="-12" y="-12" width="24" height="24" transform="rotate(180)" /></svg>
        <span class="chair-label">{names} (Trias Schule)</span>
      </p>
      <div id="anfrage" class="desk" tabindex="-1" data-phase-context={L.talk.phaseContext} data-topic-key={L.form.topicKey}>
        <SmartContactForm />
      </div>
      <p class="chair-row" aria-hidden="true">
        <svg class="chair chair-you" viewBox="-12 -12 24 24"><use href="#kz-chair" x="-12" y="-12" width="24" height="24" /></svg>
        <span class="chair-label marker">{L.talk.you}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .lr-talk { padding-block: clamp(88px, 10vw, 160px); }
  .grid-wrap { display: grid; gap: 48px; }

  .next-steps {
    margin-top: 32px;
    padding: 20px 22px;
    background: var(--color-warm);
    border-left: 3px solid var(--color-ginster);
  }
  .next-heading {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .next-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .next-list li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
    font-size: var(--text-meta);
    color: var(--color-muted);
    line-height: 1.5;
  }
  .next-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: 0.74rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    display: grid;
    place-items: center;
  }

  .setting { display: flex; flex-direction: column; align-items: center; }
  .chair-row { display: flex; align-items: center; gap: 14px; }
  .chair { width: 64px; height: 64px; overflow: visible; }
  .chair-them { --seat: var(--color-ink); }
  .chair-row:first-child { margin-bottom: -14px; }
  .chair-row:last-child { margin-top: -14px; }
  .chair-label { font-size: var(--text-meta); font-weight: 600; }
  .chair-label.marker { font-size: var(--text-marker); font-weight: 600; }

  .desk {
    position: relative;
    width: 100%;
    padding: clamp(24px, 3vw, 44px);
    border: 1.5px solid var(--color-ink);
    border-radius: 3px;
    background: var(--color-paper);
    box-shadow: 0 24px 48px -36px rgba(32, 32, 29, 0.55);
    outline: none;
  }

  @media (max-width: 1023px) {
    .grid-wrap { gap: 0; }
    .copy { display: contents; }
    .setting { order: 1; margin-top: 40px; }
    .next-steps { order: 2; margin-top: 48px; }
    .direct { order: 3; }
  }

  @media (min-width: 1024px) {
    .grid-wrap {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .copy {
      grid-column: 1 / 6;
      position: sticky;
      top: calc(var(--nav-h) + 40px);
      max-height: calc(100svh - var(--nav-h) - 48px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
    .setting { grid-column: 6 / 13; }
  }
  @media (min-width: 1024px) and (max-height: 820px) {
    .copy {
      top: calc(var(--nav-h) + 20px);
      max-height: calc(100svh - var(--nav-h) - 28px);
    }
    .next-steps { margin-top: 20px; padding: 14px 18px; }
    .direct { margin-top: 18px; padding-top: 14px; }
  }
</style>

<script>
  const desk = document.getElementById('anfrage');
  if (desk) {
    const contextBar = desk.querySelector<HTMLElement>('[data-context-bar]');
    const contextLabel = desk.querySelector<HTMLElement>('[data-context-label]');
    const contextClear = desk.querySelector<HTMLButtonElement>('[data-context-clear]');
    const topicChips = desk.querySelector<HTMLElement>('[data-topic-chips]');
    const textarea = desk.querySelector<HTMLTextAreaElement>('#lr-msg');
    const stationCards = Array.from(document.querySelectorAll<HTMLElement>('[data-station-card]'));

    let autoTopicInput: HTMLInputElement | null = null;
    let autoQuestionBlock: string | null = null;

    const showContext = (text: string) => {
      if (!contextBar || !contextLabel) return;
      contextLabel.textContent = text;
      contextBar.hidden = false;
    };

    const clearAutoTopic = () => {
      if (!autoTopicInput) return;
      autoTopicInput.checked = false;
      if (autoTopicInput.hasAttribute('data-dynamic-topic')) {
        autoTopicInput.closest('label')?.remove();
      }
      autoTopicInput = null;
    };

    contextClear?.addEventListener('click', () => {
      if (contextBar) contextBar.hidden = true;
      desk.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((radio) => {
        radio.checked = false;
      });
      stationCards.forEach((card) => card.classList.remove('is-chosen'));
      clearAutoTopic();
      if (autoQuestionBlock && textarea && textarea.value.includes(autoQuestionBlock)) {
        textarea.value = textarea.value.replace(autoQuestionBlock, '').replace(/\n{3,}/g, '\n\n').trim();
      }
      autoQuestionBlock = null;
      desk.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });

    const selectTopicChip = (topic: string) => {
      if (!topicChips) return;
      const inputs = Array.from(topicChips.querySelectorAll<HTMLInputElement>('[data-topic-input]'));
      let matched = inputs.find((input) => input.value.toLowerCase() === topic.toLowerCase());
      if (autoTopicInput && autoTopicInput !== matched) clearAutoTopic();
      if (!matched) {
        // Dynamically add a chip if a specific VS arrangement was chosen
        const label = document.createElement('label');
        label.className = 'chip';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = desk.dataset.topicKey ?? 'Thema';
        input.value = topic;
        input.className = 'sr-only';
        input.setAttribute('data-topic-input', '');
        input.setAttribute('data-dynamic-topic', '');
        const span = document.createElement('span');
        span.textContent = topic;
        label.append(input, span);
        topicChips.prepend(label);
        matched = input;
      }
      matched.checked = true;
      autoTopicInput = matched;
      const more = topicChips.closest('details');
      if (more) more.open = true;
    };

    document.querySelectorAll<HTMLElement>('[data-open-form]').forEach((el) =>
      el.addEventListener('click', (event) => {
        event.preventDefault();
        const phase = el.dataset.phase;
        const topic = el.dataset.topic;
        const question = el.dataset.question;

        if (phase) {
          const more = desk.querySelector<HTMLDetailsElement>('[data-more]');
          if (more) more.open = true;
          desk.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((radio) => {
            radio.checked = radio.value === phase;
          });
          stationCards.forEach((card) => {
            card.classList.toggle('is-chosen', card.dataset.phase === phase);
          });
        }

        if (topic) {
          selectTopicChip(topic);
          showContext(topic);
        } else if (phase) {
          showContext(`${desk.dataset.phaseContext}: ${phase}`);
        }

        if (question && textarea) {
          const line = `${question}\n→ `;
          if (!textarea.value.includes(question)) {
            textarea.value = textarea.value ? `${textarea.value.trimEnd()}\n\n${line}` : line;
          }
          autoQuestionBlock = line;
          showContext(question);
        }

        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        desk.scrollIntoView({ behavior, block: 'start' });
        window.setTimeout(() => {
          if (question && textarea) {
            textarea.focus({ preventScroll: true });
            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
          } else {
            desk.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
          }
        }, behavior === 'smooth' ? 600 : 0);
        history.replaceState(null, '', '#anfrage');
      }),
    );
  }
</script>
