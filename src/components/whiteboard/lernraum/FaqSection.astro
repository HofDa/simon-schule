---
/**
 * Concise visible FAQ section matching the JSON-LD `FAQPage` graph in `src/lib/seo.ts`.
 * Open semantic `<dl>` rows keep answers immediately readable for visitors, crawlers, and LLMs,
 * and connect each topic directly to the inquiry desk (`#anfrage`).
 */
import { getLang } from '../../../i18n/ui';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const faq = lernraumCopy(lang).faq;
---

<section id="faq" class="lr-faq" aria-labelledby="faq-title">
  <div class="shell">
    <div class="faq-grid">
      <div class="faq-head">
        <p class="faq-eyebrow marker">{faq.eyebrow}</p>
        <h2 id="faq-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{faq.title}</h2>
        <p class="faq-lead">{faq.lead}</p>
      </div>

      <dl class="faq-list">
        {faq.items.map((item, i) => {
          const cta = faq.ctas[i];
          return (
            <div class="faq-item">
              <dt class="faq-question">{item.question}</dt>
              <dd class="faq-answer">
                <p>{item.answer}</p>
                {cta && (
                  <a href="#anfrage" class="faq-cta link-line" data-open-form data-topic={cta.topic}>
                    <span>{cta.label}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </dd>
            </div>
          );
        })}
      </dl>
    </div>

    <div class="faq-funnel">
      <p class="faq-funnel-title">{faq.bottomTitle}</p>
      <a href="#anfrage" class="btn btn-ink" data-open-form>
        {faq.bottomCta}
        <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .lr-faq {
    padding-block: clamp(72px, 8vw, 128px);
    border-bottom: 1px solid var(--color-line);
  }
  .faq-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .faq-eyebrow {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--color-ginster-deep);
    margin-bottom: 12px;
  }
  .faq-lead {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.65;
  }
  .faq-list {
    margin: 0;
    display: grid;
  }
  .faq-item {
    padding-block: 24px;
    border-top: 1px solid var(--color-line);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-question {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .faq-answer {
    margin: 10px 0 0;
    max-width: 65ch;
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.65;
  }
  .faq-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    min-height: 36px;
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--color-ink);
  }
  .faq-cta span:last-child {
    color: var(--color-ginster-deep);
    transition: transform 180ms var(--ease-draw);
  }
  .faq-cta:hover span:last-child {
    transform: translateX(3px);
  }

  .faq-funnel {
    margin-top: clamp(40px, 5vw, 64px);
    padding: clamp(20px, 2.8vw, 30px);
    background: var(--color-warm);
    border: 1.5px solid var(--color-ink);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .faq-funnel-title {
    font-size: var(--text-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .faq-head {
      grid-column: 1 / 5;
    }
    .faq-list {
      grid-column: 6 / 13;
    }
  }
</style>
