---
/**
 * "Der Lernraum" – Section 1 below the Whiteboard: Compact South Tyrol Reference Showcase.
 * Pairs the verified 234-facility track record (2015–2026) with the real reference collages
 * grouped by the three whiteboard category magnets (Grundschulen, Mittel- & Musikschulen,
 * Kindergarten & Bibliothek).
 */
import { collagesFor } from '../../../data/collages';
import { experience } from '../../../data/experience';
import { getLang, useTranslations } from '../../../i18n/ui';
import ResponsiveImage from '../ResponsiveImage.astro';
import Magnet from '../Magnet.astro';
import SwipeControls from '../shared/SwipeControls.astro';
import CategoryMagnetIcon from '../shared/CategoryMagnetIcon.astro';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).projects;
const collages = collagesFor(lang);
const totalFacilities = experience.categories.reduce((sum, category) => sum + category.count, 0);
// two groups are enough to read at a glance (three libraries alone looked thin, so they join the
// kindergartens and Kitas); the detailed split stays in src/data/experience.ts
const sum = (...labels: string[]) => experience.categories.filter((c) => labels.includes(c.label.de)).reduce((n, c) => n + c.count, 0);
const statGroups = [
  { count: sum('Grundschulen', 'Mittelschulen', 'Oberschulen', 'Berufs- & Fachschulen'), label: lang === 'it' ? 'Scuole' : 'Schulen' },
  { count: sum('Kindergärten', 'Kitas', 'Bibliotheken'), label: lang === 'it' ? 'Infanzia, nidi e biblioteche' : 'Kindergärten, Kitas & Bibliotheken' },
];

const L = lernraumCopy(lang);
const P = L.projects;
const G = L.board.collages;
const featured = Object.entries(P.featuredProjects).flatMap(([slug, summary]) => {
  const project = collages.find((collage) => collage.slug === slug);
  return project ? [{ project, summary }] : [];
});

const groupOf: Record<string, 'gs' | 'ms' | 'kb'> = {
  'gs-gais': 'gs',
  'gs-deflorian-meran': 'gs',
  'gs-sarnthein': 'gs',
  'gs-st-jakob': 'gs',
  'gs-st-martin-gsies': 'gs',
  'gs-riffian': 'gs',
  'gs-sinich': 'gs',
  'ms-lana': 'ms',
  'ms-sterzing': 'ms',
  'musikschule-brixen': 'ms',
  'kiga-tisens': 'kb',
  'bibliothek-terlan': 'kb',
};
const groups = (['gs', 'ms', 'kb'] as const).map((key) => ({
  key,
  name: G.groups[key],
  items: collages.filter((c) => (groupOf[c.slug] ?? 'gs') === key),
}));

const tilts = [-1.4, 1.1, -0.8, 1.5, -1.1];
---

<section id="projekte" class="lr-projects" aria-labelledby="projects-title" data-lr-projects>
  <div class="shell">
    <div class="head">
      <div class="head-copy" data-wb-reveal>
        <h2 id="projects-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
        <p class="sub">{P.referencesSub}</p>
      </div>

      <div class="experience-strip" role="group" aria-labelledby="experience-title" data-wb-reveal data-stats style="--wb-d: 80ms">
        <div class="experience-total">
          <span class="total-num" data-count-to={totalFacilities} style={`--digits: ${String(totalFacilities).length}`}>{totalFacilities}</span>
          <div>
            <h3 id="experience-title" class="experience-title">{experience.heading[lang]}</h3>
            <span class="experience-period">{experience.period}</span>
          </div>
        </div>
        <ul class="experience-breakdown" role="list">
          {statGroups.map((group) => (
            <li class="experience-row">
              <strong data-count-to={group.count}>{group.count}</strong>
              <span>{group.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="featured-projects" aria-labelledby="featured-projects-title">
      <h3 id="featured-projects-title" class="featured-title">{P.featuredTitle}</h3>
      <div class="featured-grid">
        {featured.map(({ project, summary }) => (
          <article class="featured-project">
            <h4>{project.name}</h4>
            <p>{summary}</p>
            <button
              type="button"
              class="link-line featured-photos"
              data-open-project={project.slug}
              aria-haspopup="dialog"
              aria-label={`${P.featuredPhotos} · ${project.name}`}
            >
              {P.featuredPhotos} <span aria-hidden="true">↗</span>
            </button>
          </article>
        ))}
      </div>
    </section>

    <div class="projects-browse">
      <SwipeControls railId="project-gallery" labelId="projects-title" />
    </div>
    <div id="project-gallery" class="ref-groups swipe-rail">
      {groups.map((group) => (
        <div class={`ref-group ref-group-${group.key}`}>
          <div class="ref-group-head" data-wb-reveal>
            <CategoryMagnetIcon kind={group.key} size={30} uid={`proj-${group.key}`} />
            <h3 id={`reference-title-${group.key}`} class="ref-group-title">{group.name}</h3>
          </div>
          <ul class="references-grid" role="list" aria-labelledby={`reference-title-${group.key}`}>
            {group.items.map((c, ci) => (
              <li class="ref-item" data-swipe-card style={`--print-tilt: ${tilts[ci % tilts.length]}deg`}>
                <button
                  type="button"
                  class="reference-print"
                  style={`--wb-d: ${ci * 65}ms`}
                  data-wb-pin
                  data-open-project={c.slug}
                  aria-haspopup="dialog"
                  aria-label={`${G.open(c.name, c.photos.length)} · ${group.name}`}
                >
                  <Magnet />
                  <span class="reference-thumb">
                    <ResponsiveImage
                      src={c.collage}
                      alt={c.alt}
                      width={480}
                      widths={[240, 360, 480, 640]}
                      sizes="(min-width: 1200px) 200px, (min-width: 768px) 30vw, 78vw"
                      loading="lazy"
                      draggable="false"
                    />
                    <span class="reference-count">
                      <span class="count-dot" aria-hidden="true"></span>
                      <span>{P.photosCount(c.photos.length)}</span>
                      <span class="count-arrow" aria-hidden="true">↗</span>
                    </span>
                  </span>
                  <span class="reference-body">
                    <span class="reference-category">{group.name}</span>
                    <strong class="reference-name marker">{c.name}</strong>
                    <span class="reference-highlight">{P.referenceHighlights[c.slug] ?? ''}</span>
                    {c.vsProducts.length > 0 && (
                      <span class="reference-vs">{c.vsProducts.join(' · ')}</span>
                    )}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lr-projects {
    padding-block: clamp(56px, 6.5vw, 96px);
  }
  .head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .head-copy {
    display: grid;
    gap: 14px;
  }
  .sub {
    max-width: 52ch;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .featured-projects {
    margin-bottom: clamp(28px, 5vw, 64px);
  }
  .featured-title {
    margin: 0 0 12px;
    font-size: var(--text-meta);
    font-weight: 700;
  }
  .featured-grid {
    display: grid;
    gap: 16px 24px;
  }
  .featured-project {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    border-top: 1px solid var(--color-ink);
    padding-top: 12px;
  }
  .featured-project h4 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .featured-project p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }
  .featured-photos {
    justify-self: start;
    min-height: 44px;
    text-align: start;
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .featured-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .experience-strip {
    min-width: 0;
    border: 1px solid var(--color-line);
  }
  .experience-total {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-left: 3px solid var(--color-ginster);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-warm);
  }
  .total-num {
    min-width: calc(var(--digits, 3) * 0.62em);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .experience-title {
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.25;
  }
  .experience-period {
    font-size: var(--text-label);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .experience-breakdown {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .experience-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px 14px;
    font-size: var(--text-label);
    line-height: 1.3;
    color: var(--color-muted);
  }
  .experience-row + .experience-row { border-left: 1px solid var(--color-line); }
  .experience-row strong {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .projects-browse, .reference-category { display: none; }
  .ref-groups {
    display: grid;
    gap: 28px 16px;
  }
  .ref-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ref-group-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ref-group-head.is-in :global(.cat-magnet-gloss) {
      transform: translateX(60px);
    }
  }
  .ref-group-title {
    margin: 0;
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .references-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 14px;
  }
  @media (min-width: 640px) {
    .references-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    /* six columns: the primary schools share one full-width row (seven across), then the three
       middle and music schools beside kindergarten and library */
    .ref-groups {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 28px 14px;
    }
    .ref-group-gs { grid-column: 1 / -1; }
    .ref-group-ms { grid-column: 1 / span 3; }
    .ref-group-kb { grid-column: 4 / span 3; }
    .ref-group-gs .references-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .ref-group-ms .references-grid,
    .ref-group-kb .references-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .projects-browse { display: flex; }
    .ref-group-head { display: none; }
    .ref-group, .references-grid { display: contents; }
    .ref-group:last-child .ref-item:last-child { scroll-snap-align: end; }
    .reference-category {
      display: block;
      font-size: var(--text-label);
      font-weight: 600;
      color: var(--color-ginster-deep);
    }
  }

  .ref-item {
    position: relative;
    display: flex;
  }
  .ref-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #faf9f3;
    border: 0;
    box-shadow: 0 2px 8px rgba(32, 32, 29, 0.08);
    transform: rotate(calc(var(--print-tilt, 0deg) + 1.8deg)) translate(2px, 3px);
    transition: transform 240ms var(--ease-draw), opacity 240ms var(--ease-draw);
    pointer-events: none;
  }
  .ref-item:has(.reference-print:not(.is-in))::before {
    opacity: 0;
  }
  .ref-item:hover::before,
  .ref-item:has(.reference-print:focus-visible)::before {
    transform: rotate(2.2deg) translate(3px, 3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .ref-item::before {
      opacity: 1 !important;
      transition: none;
    }
  }

  /* Pinned whiteboard photo print */
  .reference-print {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 7px 7px 11px;
    background: #fff;
    border: 0;
    box-shadow: 0 3px 6px rgba(32, 32, 29, 0.05), 2px 12px 18px -12px rgba(32, 32, 29, 0.32);
    color: var(--color-ink);
    font: inherit;
    text-align: left;
    cursor: zoom-in;
    transform: rotate(var(--print-tilt, 0deg));
    transition: transform 240ms var(--ease-draw), box-shadow 240ms var(--ease-draw);
  }
  .reference-print:hover,
  .reference-print:focus-visible {
    transform: rotate(0deg) translateY(-3px);
    box-shadow: 0 4px 8px rgba(32, 32, 29, 0.08), 4px 20px 26px -14px rgba(32, 32, 29, 0.45);
    z-index: 2;
  }
  .reference-print:focus-visible {
    outline: 2px dashed var(--color-ginster-deep);
    outline-offset: 4px;
  }
  .reference-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-surface);
  }
  .reference-thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 360ms var(--ease-draw);
  }
  .reference-print:hover .reference-thumb :global(img) {
    transform: scale(1.03);
  }
  .reference-count {
    position: absolute;
    right: 6px;
    bottom: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 7px;
    border-radius: 2px;
    background: rgba(29, 29, 27, 0.86);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    transition: background-color 180ms var(--ease-draw), color 180ms var(--ease-draw);
  }
  .count-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ginster);
    flex: none;
  }
  .count-arrow {
    color: var(--color-ginster-light);
    transition: transform 180ms var(--ease-draw);
  }
  .reference-print:hover .reference-count,
  .reference-print:focus-visible .reference-count {
    background: var(--color-ink);
    color: var(--color-ginster-light);
  }
  .reference-print:hover .count-arrow,
  .reference-print:focus-visible .count-arrow {
    transform: translate(1px, -1px);
  }
  .reference-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 3px;
    padding: 8px 4px 2px;
  }
  .reference-name {
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.05;
    color: var(--color-ink);
  }
  .reference-highlight {
    font-size: 0.76rem;
    line-height: 1.38;
    color: var(--color-muted);
  }
  .reference-vs {
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--color-ginster-deep);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      column-gap: 28px;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: center;
    }
    .head-copy { grid-column: 1 / 8; }
    .experience-strip { grid-column: 8 / 13; }
  }
</style>

<script>
  import { revealOnce, isMotionAllowed, easeOut } from '../../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-lr-projects]');
  if (section) {
    const stats = section.querySelector<HTMLElement>('[data-stats]');
    revealOnce(Array.from(section.querySelectorAll('[data-wb-reveal], [data-wb-pin]')).filter((el) => el !== stats));

    if (stats) {
      const numbers = Array.from(stats.querySelectorAll<HTMLElement>('[data-count-to]'));
      const target = (el: HTMLElement) => Number(el.dataset.countTo) || 0;
      const showFinal = () => {
        numbers.forEach((el) => { el.textContent = String(target(el)); });
      };
      // count up from zero, the total first and each category a beat later
      const countUp = () => {
        if (!isMotionAllowed() || stats.closest('[data-board-reader]')) return showFinal();
        const start = performance.now();
        const tick = (now: number) => {
          let running = false;
          numbers.forEach((el, i) => {
            const t = Math.min(1, Math.max(0, (now - start - 180 - i * 120) / 1300));
            if (t < 1) running = true;
            const value = String(Math.round(easeOut(t) * target(el)));
            if (el.textContent !== value) el.textContent = value;
          });
          if (running) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if (isMotionAllowed() && !stats.closest('[data-board-reader]')) {
        numbers.forEach((el) => { el.textContent = '0'; });
      }
      revealOnce([stats], undefined, countUp);
    }
  }
</script>
