---
/**
 * "Der Lernraum" – Section 3: Room Concepts with interactive "Planner's Eye" annotations.
 * Instead of apologetic "Platzhalter" badges, each VS room concept carries numbered spatial
 * pins that show how Simon and Rene read and plan a learning space.
 */
import { getProjects } from '../../../data/projects';
import { experience } from '../../../data/experience';
import { asset } from '../../../lib/paths';
import { getLang, useTranslations } from '../../../i18n/ui';
import ProjectTestimonial from '../ProjectTestimonial.astro';
import Lesson from '../klassenzimmer/Lesson.astro';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).projects;
const projects = getProjects(lang);
const src = (file: string, w: number) => asset(`images/projects/${file}-${w}.webp`);
const widths = [320, 480, 640, 720, 900, 960, 1800];

const L = lernraumCopy(lang);
const P = L.projects;
/** where each planning note points in its photograph */
const pinPlaces: Record<string, [string, string][]> = {
  'schule-klassenraeume': [['28%', '58%'], ['58%', '66%'], ['74%', '34%']],
  'kindergarten-spielraum': [['34%', '64%'], ['68%', '54%'], ['80%', '32%']],
  lernlandschaft: [['32%', '56%'], ['62%', '62%'], ['48%', '36%']],
};
const annotationFor = (id: string) => {
  const key = id in P.annotations ? id : 'schule-klassenraeume';
  const plan = P.annotations[key];
  return { ...plan, pins: plan.pins.map((pin, i) => ({ ...pin, x: pinPlaces[key][i][0], y: pinPlaces[key][i][1] })) };
};
---

<section id="projekte" class="lr-projects" aria-labelledby="projects-title" data-lr-projects>
  <div class="shell">
    <Lesson n="02" name={L.lesson.projects.name} note={L.lesson.projects.note} layout="groups" from="frontal" />

    <div class="head">
      <div>
        <h2 id="projects-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      </div>
      <p class="sub">
        {P.sub}
      </p>
    </div>

    <div class="experience" aria-labelledby="experience-title">
      <h3 id="experience-title" class="experience-title">{experience.heading[lang]} <span>· {experience.period}</span></h3>
      <dl class="experience-grid">
        {experience.categories.map((category) => (
          <div>
            <dt>{category.label[lang]}</dt>
            <dd>{category.count}</dd>
          </div>
        ))}
      </dl>
    </div>

    <ol class="concept-list">
      {projects.map((project, i) => {
        const [main] = project.images;
        const plan = annotationFor(project.id);
        return (
          <li class="concept-item">
            <article class="concept" data-concept aria-labelledby={`p-${project.id}`}>
              <div class="concept-media">
                <div class="media-frame">
                  <img
                    src={src(main.file, 900)}
                    srcset={widths.map((width) => `${src(main.file, width)} ${width}w`).join(', ')}
                    sizes="(min-width: 1520px) 840px, (min-width: 1024px) 56vw, calc(100vw - 40px)"
                    alt={main.alt}
                    width="1800"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                  />
                  {plan.pins.map((pin, pi) => (
                    <button
                      type="button"
                      class={`pin-spot ${pi === 0 ? 'is-active' : ''}`}
                      style={`left: ${pin.x}; top: ${pin.y}`}
                      data-pin-btn={pi}
                      aria-label={P.pinLabel(pi + 1, pin.title)}
                      aria-pressed={pi === 0 ? 'true' : 'false'}
                    >
                      <span>{pi + 1}</span>
                    </button>
                  ))}
                </div>
                <div class="media-caption">
                  <span class="caption-badge">{P.badge}</span>
                  <span class="caption-note marker" aria-hidden="true">{plan.callout}</span>
                </div>
              </div>

              <div class="concept-info">
                <div class="info-top">
                  <span class="concept-num" aria-hidden="true">{P.example} {String(i + 1).padStart(2, '0')}</span>
                  <span class="concept-type">{project.type}</span>
                </div>
                <h3 id={`p-${project.id}`} class="concept-title">{project.title}</h3>
                <p class="concept-desc">{project.description}</p>

                <div class="planner-notes" aria-label={P.notesLabel}>
                  <p class="notes-heading">{P.notesHeading}</p>
                  <ol class="notes-list">
                    {plan.pins.map((pin, pi) => (
                      <li>
                        <button
                          type="button"
                          class={`note-item ${pi === 0 ? 'is-active' : ''}`}
                          data-note-btn={pi}
                        >
                          <span class="note-num" aria-hidden="true">{pi + 1}</span>
                          <span class="note-body">
                            <strong class="note-title">{pin.title}</strong>
                            <span class="note-detail">{pin.detail}</span>
                          </span>
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="concept-footer">
                  <dl class="concept-services">
                    <dt>{t.meta.services}:</dt>
                    <dd>{project.services.join(' · ')}</dd>
                  </dl>
                  <a
                    href="#anfrage"
                    class="btn btn-ink"
                    data-open-form
                    data-topic={plan.topic}
                  >
                    {P.cta}
                    <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
                  </a>
                </div>
              </div>
            </article>
            {project.testimonial && <div class="mt-12"><ProjectTestimonial testimonial={project.testimonial} /></div>}
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .lr-projects { padding-block: clamp(80px, 9vw, 144px); }
  .head { display: grid; gap: 20px; margin-bottom: clamp(48px, 6vw, 88px); }
  .sub { max-width: 52ch; color: var(--color-muted); font-size: var(--text-body); line-height: 1.65; }

  .experience { margin-bottom: clamp(48px, 6vw, 88px); padding-block: 24px; border-block: 1px solid var(--color-line); }
  .experience-title { font-size: var(--text-meta); font-weight: 600; line-height: 1.5; }
  .experience-title span { display: inline-block; color: var(--color-muted); font-weight: 400; }
  .experience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 24px 0 0; }
  .experience-grid > div { display: flex; flex-direction: column; gap: 8px; }
  .experience-grid dt { font-size: var(--text-label); color: var(--color-muted); line-height: 1.4; }
  .experience-grid dd { order: -1; margin: 0; font-size: var(--text-title); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) { .experience-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .experience-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); } }

  .concept-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(64px, 8vw, 116px);
  }
  .concept-item + .concept-item {
    padding-top: clamp(56px, 7vw, 96px);
    border-top: 1.5px solid var(--color-ink);
  }

  .concept {
    display: grid;
    gap: 36px;
    align-items: start;
  }

  .media-frame {
    position: relative;
    background: var(--color-surface);
    border: 1.5px solid var(--color-ink);
    overflow: hidden;
  }
  .media-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Interactive numbered hotspots on the photo */
  .pin-spot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 220ms var(--ease-draw), background-color 220ms var(--ease-draw), color 220ms var(--ease-draw);
  }
  .pin-spot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--color-ginster);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 220ms var(--ease-draw), transform 220ms var(--ease-draw);
  }
  .pin-spot:hover,
  .pin-spot.is-active {
    background: var(--color-ginster);
    color: var(--color-ink);
    transform: translate(-50%, -50%) scale(1.12);
  }
  .pin-spot.is-active::after {
    opacity: 1;
    transform: scale(1);
  }

  .media-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }
  .caption-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    color: var(--color-muted);
    font-weight: 500;
  }
  .caption-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .caption-note {
    font-size: var(--text-marker);
    color: var(--color-ink);
    transform: rotate(-1.2deg);
  }

  .info-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .concept-num {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .concept-type {
    font-size: var(--text-label);
    font-weight: 600;
    padding: 2px 10px;
    background: var(--color-warm);
    border: 1px solid var(--color-line);
  }
  .concept-title {
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .concept-desc {
    margin-top: 14px;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.62;
  }

  /* Planner's eye notes */
  .planner-notes {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }
  .notes-heading {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 12px;
  }
  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .note-item {
    width: 100%;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 12px 14px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: background-color 200ms var(--ease-draw), border-color 200ms var(--ease-draw);
  }
  .note-item:hover {
    border-color: var(--color-ink);
  }
  .note-item.is-active {
    background: var(--color-warm);
    border-color: var(--color-ink);
    box-shadow: inset 3px 0 0 var(--color-ginster);
  }
  .note-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-ink);
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-top: 1px;
    transition: background-color 200ms var(--ease-draw);
  }
  .note-item.is-active .note-num {
    background: var(--color-ginster);
  }
  .note-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .note-title {
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.25;
  }
  .note-detail {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .concept-footer {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .concept-services {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--text-meta);
  }
  .concept-services dt {
    color: var(--color-muted);
  }
  .concept-services dd {
    margin: 0;
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: end;
    }
    .head > div { grid-column: 1 / 7; }
    .sub { grid-column: 7 / 13; }

    .concept {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
    }
    .concept-media { grid-column: 1 / 8; }
    .concept-info { grid-column: 8 / 13; }
    .concept-item:nth-child(even) .concept-media { grid-column: 6 / 13; grid-row: 1; }
    .concept-item:nth-child(even) .concept-info { grid-column: 1 / 6; grid-row: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-concept]').forEach((concept) => {
    const pins = Array.from(concept.querySelectorAll<HTMLButtonElement>('[data-pin-btn]'));
    const notes = Array.from(concept.querySelectorAll<HTMLButtonElement>('[data-note-btn]'));

    const activate = (index: number) => {
      pins.forEach((p, i) => {
        const on = i === index;
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-pressed', String(on));
      });
      notes.forEach((n, i) => {
        n.classList.toggle('is-active', i === index);
      });
    };

    pins.forEach((p, i) => {
      p.addEventListener('click', () => activate(i));
      p.addEventListener('mouseenter', () => activate(i));
    });
    notes.forEach((n, i) => {
      n.addEventListener('click', () => activate(i));
      n.addEventListener('mouseenter', () => activate(i));
    });
  });
</script>
