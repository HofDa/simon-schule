---
/**
 * Enhanced inquiry form for "Der Lernraum":
 * - Receives context from any section on the page (`data-phase`, `data-topic`, `data-question`)
 * - Offers clickable "Worum geht es?" topic chips and 1-click message starters to eliminate blank-textarea friction
 * - Preserves full Formspree + mailto + clipboard fallback behavior.
 */
import { inquiry } from '../../../data/site';
import { getLang, useTranslations } from '../../../i18n/ui';
import { legalFor } from '../../../lib/paths';
import { lernraumCopy } from '../../../i18n/lernraum';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const t = ui.form;
const f = t.fields;

const L = lernraumCopy(lang).form;
const defaultTopics = L.topics;
const messagePrompts = L.prompts;
---

<form
  class="inquiry"
  action={inquiry.endpoint ?? `mailto:${inquiry.mailto}`}
  method="post"
  enctype={inquiry.endpoint ? undefined : 'text/plain'}
  novalidate
  data-lr-inquiry
  data-endpoint={inquiry.endpoint ?? ''}
  data-mailto={inquiry.mailto}
  aria-labelledby="inquiry-title"
  data-org-key={f.org.key}
  data-topic-key={L.topicKey}
  data-messages={JSON.stringify(t.status)}
>
  <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line pb-4">
    <div>
      <h3 id="inquiry-title" class="text-phi-1 tracking-[-0.03em]">{t.title}</h3>
      <p class="mt-1 text-meta text-muted">{L.sub}</p>
    </div>
    <p class="text-label text-muted">{t.required}</p>
  </div>

  <!-- Context pill shown when a visitor clicked a specific room concept or question above -->
  <div class="context-bar" data-context-bar hidden>
    <span class="context-dot" aria-hidden="true"></span>
    <span class="context-text">{L.selected} <strong data-context-label></strong></span>
    <button type="button" class="context-clear" data-context-clear aria-label={L.clear}>×</button>
  </div>

  <div class="fields mt-6">
    <div class="field">
      <label for="lr-name">{f.name.label} *</label>
      <input id="lr-name" name={f.name.key} type="text" autocomplete="name" required aria-describedby="lr-name-err" />
      <p class="err" id="lr-name-err" data-msg={f.name.error}></p>
    </div>
    <div class="field">
      <label for="lr-org">{f.org.label}</label>
      <input id="lr-org" name={f.org.key} type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="lr-mail">{f.mail.label} *</label>
      <input id="lr-mail" name={f.mail.key} type="email" autocomplete="email" required aria-describedby="lr-mail-err lr-reach-hint" data-reach-mail />
      <p class="err" id="lr-mail-err" data-msg={t.reach.error}></p>
    </div>
    <div class="field">
      <label for="lr-tel">{f.tel.label} <span class="text-muted">{t.reach.callback}</span></label>
      <input id="lr-tel" name={f.tel.key} type="tel" autocomplete="tel" aria-describedby="lr-reach-hint" data-reach-tel />
    </div>
    <p class="reach-hint field-wide" id="lr-reach-hint">{t.reach.hint}</p>
    <details class="more field-wide" data-more>
      <summary>{L.more} <span class="text-muted font-normal">{t.optional}</span></summary>
      <div class="more-body">
    <div class="field field-wide">
      <label for="lr-ort">{f.place.label} <span class="text-muted">{t.optional}</span></label>
      <input id="lr-ort" name={f.place.key} type="text" autocomplete="address-level2" placeholder={f.place.placeholder} />
    </div>

    <fieldset class="field field-wide">
      <legend>{f.phase.label}</legend>
      <div class="chips" data-phase-chips>
        {t.phases.map((phase) => (
          <label class="chip">
            <input type="radio" name={f.phase.key} value={phase} class="sr-only" />
            <span>{phase}</span>
          </label>
        ))}
        <label class="chip">
          <input type="radio" name={f.phase.key} value={t.orderOption} class="sr-only" />
          <span>{t.orderOption}</span>
        </label>
      </div>
    </fieldset>

    <fieldset class="field field-wide">
      <legend>{L.about} <span class="text-muted font-normal">{t.optional}</span></legend>
      <div class="chips" data-topic-chips>
        {defaultTopics.map((topic) => (
          <label class="chip">
            <input type="checkbox" name={L.topicKey} value={topic} class="sr-only" data-topic-input />
            <span>{topic}</span>
          </label>
        ))}
      </div>
    </fieldset>

      </div>
    </details>

    <div class="field field-wide">
      <div class="msg-head">
        <label for="lr-msg">{f.msg.label} <span class="text-muted">{t.optional}</span></label>
        <div class="prompt-row" aria-label={L.promptsLabel}>
          {messagePrompts.map((p) => (
            <button type="button" class="prompt-chip" data-insert-prompt={p.text}>
              {p.label}
            </button>
          ))}
        </div>
      </div>
      <textarea id="lr-msg" name={f.msg.key} rows="3" placeholder={f.msg.placeholder}></textarea>
    </div>
  </div>

  <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
    <button type="submit" class="btn btn-ginster">
      {t.submit}
      <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
    </button>
    <p class="status text-meta text-muted" role="status" aria-live="polite" data-status></p>
    <a class="mail-fallback link-line text-meta font-semibold" data-mail-fallback hidden>{t.emailAction}</a>
    <button type="button" class="copy link-line text-meta font-semibold" data-copy hidden>{t.copy}</button>
  </div>
  <p class="mt-5 text-label text-muted">
    {inquiry.endpoint ? t.privacyHosted : t.privacy} <a class="link-line" href={legalFor(lang, 'privacy')}>{t.privacyLink}</a>
  </p>
</form>

<style>
  .context-bar {
    margin-top: 16px;
    padding: 10px 14px;
    background: var(--color-warm);
    border: 1px solid var(--color-ink);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-meta);
  }
  .context-bar[hidden] { display: none; }
  .context-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ginster);
    flex: none;
  }
  .context-text { min-width: 0; flex: 1; }
  .context-clear {
    border: 0;
    background: none;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-muted);
    padding: 2px 6px;
  }
  .context-clear:hover { color: var(--color-ink); }

  .fields { display: grid; gap: 18px 28px; }
  @media (min-width: 640px) {
    .fields { grid-template-columns: 1fr 1fr; }
    .field-wide { grid-column: 1 / -1; }
  }
  .field { display: flex; flex-direction: column; min-width: 0; border: 0; margin: 0; padding: 0; }
  .field label, .field legend { font-size: var(--text-label); font-weight: 500; margin-bottom: 4px; padding: 0; }
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #b9b6ad;
    border-radius: 0;
    background: transparent;
    padding: 8px 0 9px;
    font: inherit;
    font-size: var(--text-body);
    color: var(--color-ink);
    transition: border-color 200ms var(--ease-draw), box-shadow 200ms var(--ease-draw);
  }
  .field textarea { resize: vertical; min-height: 92px; }
  .field input::placeholder, .field textarea::placeholder { color: #8f8c83; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--color-ink); box-shadow: 0 1px 0 0 var(--color-ink); }
  .field input:focus-visible, .field textarea:focus-visible { box-shadow: 0 2px 0 0 var(--color-ginster); }
  .field [aria-invalid='true'] { border-color: #a4331c; box-shadow: 0 1px 0 0 #a4331c; }
  .err { margin: 6px 0 0; font-size: var(--text-label); color: #a4331c; min-height: 0; }
  .err:empty { display: none; }
  .more { border-block: 1px solid var(--color-line); }
  .more > summary { display: flex; align-items: center; gap: 8px; min-height: 48px; cursor: pointer; font-size: var(--text-meta); font-weight: 600; list-style: none; }
  .more > summary::-webkit-details-marker { display: none; }
  .more > summary::before { content: '+'; width: 1ch; font-size: 1.2em; font-weight: 500; line-height: 1; }
  .more[open] > summary::before { content: '–'; }
  .more > summary:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .more-body { display: grid; gap: 18px; padding: 6px 0 22px; }
  .reach-hint { margin: -8px 0 0; font-size: var(--text-label); color: var(--color-muted); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .chip { position: relative; }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #c9c6bc;
    border-radius: 2px;
    font-size: var(--text-meta);
    cursor: pointer;
    transition: background-color 180ms var(--ease-draw), border-color 180ms var(--ease-draw), color 180ms var(--ease-draw);
  }
  .chip:hover span { border-color: var(--color-ink); }
  @media (pointer: coarse) {
    .chip span { min-height: 44px; }
  }
  .chip input:checked + span { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .chip input:checked + span::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .chip input:focus-visible + span { outline: 2px solid var(--color-ink); outline-offset: 2px; }

  .msg-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  .prompt-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .prompt-chip {
    border: 1px dashed var(--color-line);
    background: var(--color-warm);
    color: var(--color-muted);
    font: inherit;
    font-size: 0.75rem;
    padding: 3px 8px;
    cursor: pointer;
    transition: border-color 180ms var(--ease-draw), color 180ms var(--ease-draw), background-color 180ms var(--ease-draw);
  }
  .prompt-chip:hover {
    border-color: var(--color-ink);
    border-style: solid;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .status.is-ok { color: var(--color-ink); }
  .inquiry button:disabled { cursor: wait; opacity: 0.65; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lr-inquiry]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const mailFallback = form?.querySelector<HTMLAnchorElement>('[data-mail-fallback]');
  const copy = form?.querySelector<HTMLButtonElement>('[data-copy]');
  const textarea = form?.querySelector<HTMLTextAreaElement>('#lr-msg');
  let composed = '';

  // Wide screens have room for the optional project details; phones open them on demand.
  const more = form?.querySelector<HTMLDetailsElement>('[data-more]');
  if (more && window.matchMedia('(min-width: 1024px)').matches) more.open = true;

  if (form && status) {
    const msg = JSON.parse(form.dataset.messages ?? '{}') as Record<string, string>;
    const withEmail = (text: string) => text.replace('{email}', form.dataset.mailto ?? '');
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]'));

    // Quick message starter prompts
    form.querySelectorAll<HTMLButtonElement>('[data-insert-prompt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!textarea) return;
        const snippet = btn.dataset.insertPrompt ?? '';
        if (!textarea.value.includes(snippet.trim())) {
          textarea.value = textarea.value ? `${textarea.value.trimEnd()}\n${snippet}` : snippet;
        }
        textarea.focus();
      });
    });

    const showError = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const err = document.getElementById(`${field.id}-err`);
      const valid = field.checkValidity();
      field.setAttribute('aria-invalid', String(!valid));
      if (err) err.textContent = valid ? '' : (err.dataset.msg ?? '');
      return valid;
    };

    // E-mail or phone is enough: the e-mail is only required while no phone number is given.
    const reachMail = form.querySelector<HTMLInputElement>('[data-reach-mail]');
    const reachTel = form.querySelector<HTMLInputElement>('[data-reach-tel]');
    const syncReach = () => {
      if (!reachMail || !reachTel) return;
      reachMail.required = reachTel.value.replace(/\D/g, '').length < 6;
      if (reachMail.getAttribute('aria-invalid') === 'true') showError(reachMail);
    };
    reachTel?.addEventListener('input', syncReach);
    form.addEventListener('reset', () => window.setTimeout(syncReach));

    fields.forEach((f) => {
      f.addEventListener('blur', () => f.value && showError(f));
      f.addEventListener('input', () => f.getAttribute('aria-invalid') === 'true' && showError(f));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      syncReach();
      const invalid = fields.filter((f) => !showError(f));
      if (invalid.length) {
        invalid[0].focus();
        status.classList.remove('is-ok');
        status.textContent = msg.invalid;
        return;
      }

      const data = new FormData(form);
      const org = String(data.get(form.dataset.orgKey ?? '') ?? '');
      const subject = `${msg.subject}: ${org.trim() || String(data.get(form.querySelector<HTMLInputElement>('#lr-name')?.name ?? '') ?? '')}`;
      const lines: string[] = [];
      const topics = data.getAll(form.dataset.topicKey ?? 'Thema').map(String).filter(Boolean);
      for (const [key, value] of data.entries()) {
        if (key === (form.dataset.topicKey ?? 'Thema')) continue;
        if (String(value).trim()) lines.push(`${key}: ${value}`);
      }
      if (topics.length) {
        lines.splice(Math.min(2, lines.length), 0, `${form.dataset.topicKey ?? 'Thema'}: ${topics.join(', ')}`);
      }
      composed = `${subject}\n\n${lines.join('\n')}`;
      const mailto = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;

      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        if (mailFallback) {
          mailFallback.href = mailto;
          mailFallback.hidden = true;
        }
        if (copy) copy.hidden = true;
        status.textContent = msg.sending;
        form.setAttribute('aria-busy', 'true');
        const controls = Array.from(
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('input, textarea, button'),
        );
        controls.forEach((control) => { control.disabled = true; });
        const emailField = form.querySelector<HTMLInputElement>('#lr-mail');
        if (emailField?.value) data.set('_replyto', emailField.value);
        data.set('_subject', subject);
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 15_000);
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
            signal: controller.signal,
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          if (mailFallback) mailFallback.hidden = true;
          if (copy) copy.hidden = true;
          status.classList.add('is-ok');
          status.textContent = msg.sent;
        } catch {
          status.classList.remove('is-ok');
          status.textContent = withEmail(msg.failed);
          if (mailFallback) mailFallback.hidden = false;
          if (copy) copy.hidden = false;
        } finally {
          window.clearTimeout(timeout);
          form.removeAttribute('aria-busy');
          controls.forEach((control) => { control.disabled = false; });
        }
        return;
      }

      if (mailFallback) {
        mailFallback.href = mailto;
        mailFallback.hidden = false;
      }
      if (copy) copy.hidden = false;
      window.location.href = mailto;
      status.classList.remove('is-ok');
      status.textContent = withEmail(msg.mailto);
    });

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(composed);
        status.classList.add('is-ok');
        status.textContent = withEmail(msg.copied);
      } catch {
        status.textContent = withEmail(msg.copyFailed);
      }
    });
  }
</script>
