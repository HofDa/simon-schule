---
/**
 * "Der Lernraum" – Section 2: Interactive Room Transformation ("Ein Raum, viele Arten zu lernen").
 * Combines the isometric VS catalogue SVG arrangements with instant interactive magnetic tabs
 * (no 400vh scroll-hijacking required). Near the viewport the drawings give way to one 3D room
 * (src/scripts/learning-room.ts) in which the furniture moves from one arrangement to the next;
 * the drawings stay as the picture before that, under reduced motion and without WebGL, spatial planning facts, and a 1-click "Vormerken" hook
 * that pre-selects the room arrangement in the inquiry form.
 */
import { sceneSize, type SceneName } from '../art/learning-scenes';
import { asset } from '../../../lib/paths';
import { getLang } from '../../../i18n/ui';
import { lernraumCopy } from '../../../i18n/lernraum';
import Magnet from '../Magnet.astro';

const lang = getLang(Astro.currentLocale);
const S = lernraumCopy(lang).scenes;
const order: SceneName[] = ['frontal', 'uform', 'gruppen', 'bewegung', 'landschaft', 'rueckzug', 'boden'];
const scenes = S.items.map((item, i) => ({ ...item, scene: order[i], id: `lr-scene-${order[i]}` }));

const size = sceneSize();
---

<section id="lernformen" class="lr-scenes" aria-labelledby="lr-scenes-title" data-lr-scenes data-scenes-expanded="false">
  <div class="shell">
    <div class="scenes-frame" data-wb-reveal>
      <div class="scenes-board">
        <div class="scenes-head">
          <div>
            <div class="scenes-kicker">
              <p class="marker scenes-note" aria-hidden="true">{S.note}</p>
              <span class="scenes-live-badge">{S.boardBadge}</span>
            </div>
            <h2 id="lr-scenes-title" class="mt-2 text-headline leading-[0.98] tracking-[-0.03em]">
              {S.title}
            </h2>
          </div>
          <p class="scenes-intro">{S.intro}</p>
          <p class="scenes-mobile-intro">{S.mobileIntro}</p>
          <button type="button" class="scenes-mobile-preview" data-scenes-preview aria-controls="room-arrangements" aria-label={S.expand}>
            <img
              src={asset(`scenes/${scenes[0].scene}.svg`)}
              width={size.width}
              height={size.height}
              alt={S.alt(scenes[0].name, scenes[0].product)}
              loading="lazy"
              decoding="async"
            />
            <span class="preview-badge" aria-hidden="true">3D · 7 {S.step === 'Aufstellung' ? 'Aufstellungen' : 'disposizioni'}</span>
          </button>
          <button type="button" class="scenes-toggle btn btn-ink" data-scenes-toggle aria-expanded="false" aria-controls="room-arrangements">
            <span data-scenes-open>{S.expand}</span>
            <span data-scenes-close>{S.collapse}</span>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg>
          </button>
        </div>

        <div id="room-arrangements" class="scenes-demo">
          <div class="scenes-picker">
            <button type="button" data-scenes-step="-1" aria-label={S.previous} aria-controls="room-stage"><span aria-hidden="true">←</span></button>
            <select data-scenes-select aria-label={S.tablist} aria-controls="room-stage">
              {scenes.map((s, i) => <option value={i}>{S.mobileNames[s.scene] ?? s.name}</option>)}
            </select>
            <button type="button" data-scenes-step="1" aria-label={S.nextShort} aria-controls="room-stage"><span aria-hidden="true">→</span></button>
          </div>

          <!-- Interactive magnetic switcher rail -->
          <div class="scenes-tabs" role="tablist" aria-label={S.tablist}>
            {scenes.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class={`scene-tab ${i === 0 ? 'is-active' : ''}`}
                data-scene-tab={i}
              >
                <span class="tab-magnet" aria-hidden="true"></span>
                <span class="tab-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tab-copy">
                  <span class="tab-name">{s.name}</span>
                  <span class="tab-short">{s.short}</span>
                </span>
              </button>
            ))}
          </div>

          <!-- Stage with the room arrangements -->
          <div id="room-stage" class="scenes-stage">
            {scenes.map((s, i) => (
              <div
                role="tabpanel"
                id={`panel-${s.id}`}
                aria-labelledby={`tab-${s.id}`}
                class={`scene-panel ${i === 0 ? 'is-active' : ''}`}
                data-scene-panel={i}
                data-scene-name={s.scene}
                data-canvas-label={S.canvas(s.name)}
              >
                <div class="scene-copy">
                  <div class="scene-badge">
                    <span class="scene-step">{S.step} {String(i + 1).padStart(2, '0')} / {String(scenes.length).padStart(2, '0')}</span>
                    <span class="scene-setup">{s.setup}</span>
                  </div>
                  <h3>{s.name}</h3>
                  <p class="scene-text">{s.text}</p>
                  <p class="scene-mobile-copy">{s.short} <span>{s.product}</span></p>

                  <div class="scene-sticky">
                    <Magnet />
                    <span class="sticky-label">{S.system}</span>
                    <strong class="marker sticky-product">{s.product}</strong>
                  </div>

                  <div class="scene-actions">
                    <a
                      href="#anfrage"
                      class="btn btn-ink"
                      data-open-form
                      data-topic={s.topic}
                    >
                      {S.reserve}
                      <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
                    </a>
                    <button type="button" class="next-scene link-line" data-scene-next>
                      {S.next(scenes[(i + 1) % scenes.length].name)} →
                    </button>
                  </div>
                </div>

                <figure class="scene-figure">
                  <img
                    class="iso"
                    src={asset(`scenes/${s.scene}.svg`)}
                    width={size.width}
                    height={size.height}
                    alt={S.alt(s.name, s.product)}
                    loading="lazy"
                    decoding="async"
                    data-lr-scene-src
                  />
                </figure>
              </div>
            ))}
            <!-- the 3D room: one canvas, moved into the open panel's frame once three.js has loaded -->
            <div class="room-3d" data-room-3d hidden>
              <canvas data-room-canvas tabindex="0" role="img" aria-label=""></canvas>
              <p class="room-hint" aria-hidden="true"><span class="room-hint-icon">⇄</span> <span class="marker">{S.hint}</span></p>
            </div>
          </div>
        </div>
      </div>
      <div class="scenes-tray" aria-hidden="true">
        <span class="scenes-tray-marker"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .lr-scenes {
    padding-block: clamp(56px, 7vw, 104px);
    background: var(--color-warm);
  }

  .scenes-frame {
    position: relative;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .scenes-board {
    background: transparent;
    padding: 0;
    box-shadow: none;
  }
  .scenes-tray {
    display: none;
  }

  .scenes-head {
    display: grid;
    gap: 20px;
    padding-bottom: clamp(24px, 3vw, 36px);
  }
  .scenes-mobile-intro, .scenes-mobile-preview, .scenes-toggle, .scenes-picker, .scene-mobile-copy { display: none; }
  .scenes-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .scenes-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    background: transparent;
    border: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .scenes-live-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ginster);
  }
  .scenes-note {
    display: inline-block;
    color: var(--color-ink);
    font-size: var(--text-marker);
    transform: rotate(-1.5deg);
  }
  .scenes-intro {
    max-width: 50ch;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.62;
  }

  /* Magnetic switcher rail */
  .scenes-tabs {
    display: flex;
    gap: 10px;
    margin-top: clamp(24px, 3vw, 36px);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .scene-tab {
    flex: 0 0 min(215px, 70vw);
    scroll-snap-align: start;
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 8px 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-muted);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: color 200ms var(--ease-draw), border-color 200ms var(--ease-draw);
  }
  @media (min-width: 1180px) {
    .scenes-tabs {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 12px;
      overflow-x: visible;
      padding-bottom: 0;
    }
    .scene-tab {
      flex: initial;
      flex-direction: column;
      gap: 6px;
      padding: 10px 8px 12px;
    }
    .tab-magnet {
      margin-top: 0;
    }
    .tab-num {
      position: absolute;
      top: 8px;
      right: 8px;
      padding-top: 0;
      font-size: 0.72rem;
    }
    .tab-name {
      font-size: 0.84rem;
      overflow-wrap: break-word;
    }
    .tab-short {
      font-size: 0.71rem;
    }
  }
  .scene-tab:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-line);
  }
  .scene-tab.is-active {
    background: transparent;
    border-bottom-color: var(--color-ginster);
    color: var(--color-ink);
  }
  .scene-tab.is-active .tab-name {
    font-weight: 700;
  }
  .tab-magnet {
    width: 8px;
    height: 8px;
    margin-top: 5px;
    border-radius: 50%;
    flex: none;
    border: 1.5px solid currentColor;
    transition: background-color 200ms var(--ease-draw), border-color 200ms var(--ease-draw);
  }
  .scene-tab.is-active .tab-magnet {
    background: var(--color-ginster);
    border-color: var(--color-ginster);
  }
  .tab-num {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
    padding-top: 1px;
  }
  .tab-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tab-name {
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.2;
  }
  .tab-short {
    font-size: 0.76rem;
    opacity: 0.72;
    line-height: 1.3;
  }

  /* Panels */
  .scenes-stage {
    position: relative;
    margin-top: clamp(28px, 4vw, 48px);
  }
  .scene-panel {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  :global(html.js) .scene-panel:not(.is-active) {
    display: none;
  }
  :global(html:not(.js)) .scene-panel + .scene-panel {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .scene-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .scene-step {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }
  .scene-setup {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 3px 10px;
    background: var(--color-ginster);
    color: var(--color-ink);
  }
  .scene-copy h3 {
    font-size: clamp(1.75rem, 2.8vw, 2.55rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .scene-text {
    margin-top: 14px;
    max-width: 44ch;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.62;
  }

  .scene-sticky {
    position: relative;
    margin-top: 22px;
    padding: 16px 18px 14px;
    max-width: 34ch;
    background: #f6dc78;
    box-shadow: 1px 8px 14px -10px rgba(32, 32, 29, 0.38);
    rotate: -1deg;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sticky-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4f482b;
  }
  .sticky-product {
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    color: var(--color-ink);
    line-height: 1.05;
  }

  .scene-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }
  .next-scene {
    border: 0;
    background: none;
    padding: 0 0 2px;
    font: inherit;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }

  .scene-figure {
    margin: 0;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .scene-figure :global(.iso) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: contain;
    margin-inline: auto;
  }

  /* the 3D room takes the drawing's place in the frame */
  .room-3d { position: relative; width: 100%; aspect-ratio: 4 / 3; max-height: 520px; }
  .room-3d[hidden] { display: none; }
  .room-3d canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; outline: none; }
  .room-3d.is-dragging canvas { cursor: grabbing; }
  .room-3d canvas:focus-visible { outline: 2px solid var(--color-ink); outline-offset: -2px; }
  .room-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 99px;
    background: rgba(255, 254, 251, 0.85);
    border: 0;
    box-shadow: 0 4px 12px rgba(32, 32, 29, 0.08);
    color: var(--color-ink);
    font-size: 0.96rem;
    line-height: 1;
    pointer-events: none;
    transition: opacity 260ms var(--ease-draw);
  }
  .room-hint-icon {
    color: var(--color-ginster-deep);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .room-3d.is-dragging .room-hint,
  .room-3d.has-dragged .room-hint {
    opacity: 0.25;
  }
  .lr-scenes.is-3d .scene-figure { padding: 0; }
  .lr-scenes.is-3d .scene-figure :global(.iso) { display: none; }

  /* Furniture piece, sticky-note, copy, and marker-tray animations */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .scenes-frame:not(.is-in) .scenes-tray-marker {
      opacity: 0;
      transform: translateX(-56px) rotate(-14deg);
    }
    .scenes-tray-marker {
      transition:
        transform 640ms var(--ease-draw) 160ms,
        opacity 320ms var(--ease-draw) 160ms;
    }

    .scenes-frame.is-in .scene-panel.is-active .scene-copy {
      animation: lr-copy-in 320ms var(--ease-draw) both;
    }
    .scenes-frame.is-in .scene-panel.is-active .scene-sticky {
      animation: wb-pin-in 380ms var(--ease-draw) 80ms both;
    }
    .scenes-frame.is-in .scene-panel.is-active .scene-sticky > :global(.magnet) {
      animation: wb-magnet-in 220ms var(--ease-draw) 220ms both;
    }
    @keyframes lr-copy-in {
      from {
        opacity: 0;
        translate: 0 10px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }

    .scene-panel.is-active :global(.iso-piece) {
      animation: lr-piece-in 340ms cubic-bezier(0.34, 1.45, 0.64, 1) both;
      animation-delay: calc(min(var(--k, 0), 35) * 8ms);
      transform-box: fill-box;
      transform-origin: 50% 100%;
    }
    .scene-panel.is-active :global(.iso-piece[data-kind='hokki']) {
      animation:
        lr-piece-in 340ms cubic-bezier(0.34, 1.45, 0.64, 1) both,
        lr-hokki-rock 0.9s ease-in-out 0.35s infinite alternate;
    }
    @keyframes lr-piece-in {
      from {
        opacity: 0;
        translate: 0 -6px;
        scale: 0.96;
      }
      to {
        opacity: 1;
        translate: 0 0;
        scale: 1;
      }
    }
    @keyframes lr-hokki-rock {
      from { rotate: -2.4deg; }
      to { rotate: 2.4deg; }
    }
  }

  @media (max-width: 767px) {
    .lr-scenes { padding-block: 40px; }
    .scenes-head { gap: 12px; padding-bottom: 0; }
    .scenes-head h2 { margin-top: 0; }
    .scenes-kicker, .scenes-intro { display: none; }
    .scenes-mobile-intro {
      display: block;
      color: var(--color-muted);
    }
    :global(html.js) .scenes-mobile-preview {
      position: relative;
      display: block;
      width: 100%;
      margin-top: 4px;
      padding: 8px;
      border: 1px solid var(--color-line);
      border-radius: 3px;
      background: var(--color-paper);
      cursor: pointer;
    }
    :global(html.js) .scenes-mobile-preview img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 240px;
      object-fit: contain;
      margin-inline: auto;
    }
    .preview-badge {
      position: absolute;
      right: 10px;
      bottom: 10px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 9px;
      border-radius: 2px;
      background: rgba(32, 32, 29, 0.88);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .preview-badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-ginster);
    }
    :global(html.js) .lr-scenes[data-scenes-expanded='true'] .scenes-mobile-preview { display: none; }
    :global(html.js) .scenes-toggle {
      display: inline-flex;
      justify-self: start;
      margin-top: 4px;
    }
    .scenes-toggle[aria-expanded='false'] [data-scenes-close],
    .scenes-toggle[aria-expanded='true'] [data-scenes-open],
    :global(html.js) .lr-scenes[data-scenes-expanded='false'] .scenes-demo { display: none; }
    .scenes-toggle[aria-expanded='true'] svg { rotate: 180deg; }

    .scenes-demo { margin-top: 20px; }
    .scenes-tabs { display: none; }
    :global(html.js) .scenes-picker {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 8px;
    }
    .scenes-picker :is(button, select) {
      min-width: 0;
      min-height: 44px;
      border: 1px solid var(--color-line);
      border-radius: 3px;
      background: var(--color-paper);
      color: var(--color-ink);
    }
    .scenes-picker button { cursor: pointer; }
    .scenes-picker select { appearance: auto; padding-inline: 8px; font-weight: 600; }
    .scenes-stage { margin-top: 12px; }
    .scene-panel { gap: 12px; }
    .scene-figure {
      display: grid;
      grid-template: minmax(0, 1fr) / minmax(0, 1fr);
      order: -1;
      aspect-ratio: 3 / 2;
      max-height: 380px;
    }
    .scene-figure > :global(*) { grid-area: 1 / 1; height: 100%; }
    .scene-badge, .scene-text, .scene-sticky, .next-scene, .room-hint,
    :global(html.js) .scene-copy h3 { display: none; }
    .scene-mobile-copy { display: block; font-size: var(--text-meta); }
    .scene-mobile-copy span { display: block; margin-top: 2px; color: var(--color-muted); }
    .scene-actions { margin-top: 12px; }
  }

  @media (min-width: 1024px) {
    .scenes-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: end;
    }
    .scenes-head > div { grid-column: 1 / 7; }
    .scenes-intro { grid-column: 7 / 13; }

    .scene-panel {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(32px, 4vw, 56px);
    }
    .scene-figure,
    .scene-panel > :global(.room-3d) {
      order: -1;
    }
  }
</style>

<script>
  import { revealOnce } from '../../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-lr-scenes]');
  if (section) {
    const frame = section.querySelector<HTMLElement>('.scenes-frame');
    if (frame) revealOnce([frame]);

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-scene-tab]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-scene-panel]'));
    const nextButtons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-scene-next]'));
    const mobile = window.matchMedia('(max-width: 767px)');
    const toggle = section.querySelector<HTMLButtonElement>('[data-scenes-toggle]');
    const preview = section.querySelector<HTMLButtonElement>('[data-scenes-preview]');
    const picker = section.querySelector<HTMLSelectElement>('[data-scenes-select]');
    let current = 0;

    // Inline the SVG files once near the viewport so individual furniture pieces animate cleanly
    let inlined = false;
    const inlineSvgs = () => {
      if (inlined) return;
      inlined = true;
      section.querySelectorAll<HTMLImageElement>('img[data-lr-scene-src]').forEach(async (img) => {
        try {
          const res = await fetch(img.currentSrc || img.src);
          if (!res.ok) return;
          const svg = new DOMParser().parseFromString(await res.text(), 'image/svg+xml').documentElement;
          if (svg.nodeName !== 'svg') return;
          svg.setAttribute('class', 'iso');
          svg.setAttribute('role', 'img');
          svg.setAttribute('aria-label', img.alt || '');
          img.replaceWith(document.importNode(svg, true));
        } catch {
          // Keep <img> fallback if fetch fails
        }
      });
    };

    // The 3D room: loaded once the section comes near, unless the visitor asked for less motion
    // or less data. Until it is ready, and whenever it cannot run, the drawings stay.
    type Room = { show: (name: any, instant?: boolean) => void };
    let room: Room | null = null;
    const host = section.querySelector<HTMLElement>('[data-room-3d]');
    const canvas = host?.querySelector<HTMLCanvasElement>('[data-room-canvas]');
    canvas?.addEventListener('pointerdown', () => host?.classList.add('has-dragged'), { once: true });
    const seat = () => {
      const panel = panels[current];
      const figure = panel?.querySelector('.scene-figure');
      if (!host || !canvas || !figure) return;
      figure.append(host);
      canvas.setAttribute('aria-label', panel.dataset.canvasLabel ?? '');
    };
    const load3d = async () => {
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      if (!host || !canvas || saveData || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return inlineSvgs();
      try {
        const { createLearningRoom } = await import('../../../scripts/learning-room');
        host.hidden = false;
        seat();
        const made = await createLearningRoom(host, canvas, panels[current].dataset.sceneName as never);
        if (!made) throw new Error('WebGL unavailable');
        room = made;
        section.classList.add('is-3d');
        // the visitor may have switched while it loaded
        seat();
        room.show(panels[current].dataset.sceneName, true);
      } catch {
        host.hidden = true;
        inlineSvgs();
      }
    };

    let nearby = !('IntersectionObserver' in window);
    let started = false;
    const maybeLoad = () => {
      if (started || !nearby || (mobile.matches && section.dataset.scenesExpanded !== 'true')) return;
      started = true;
      void load3d();
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            nearby = true;
            io.disconnect();
            maybeLoad();
          }
        },
        { rootMargin: '600px 0px' },
      );
      io.observe(section);
    }

    const setExpanded = (expanded: boolean) => {
      section.dataset.scenesExpanded = String(expanded);
      toggle?.setAttribute('aria-expanded', String(expanded));
      maybeLoad();
    };
    toggle?.addEventListener('click', () => setExpanded(section.dataset.scenesExpanded !== 'true'));
    preview?.addEventListener('click', () => setExpanded(true));
    mobile.addEventListener('change', maybeLoad);
    maybeLoad();

    const selectScene = (index: number, focusTarget: 'tab' | 'next' | 'none' = 'none') => {
      current = (index + tabs.length) % tabs.length;
      if (picker) picker.value = String(current);
      tabs.forEach((tab, i) => {
        const active = i === current;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && !mobile.matches) {
          // scroll only the tab rail sideways; the page stays where the reader is
          const rail = tab.parentElement;
          if (rail) {
            const left = tab.offsetLeft - rail.offsetLeft;
            const right = left + tab.offsetWidth;
            const target = left < rail.scrollLeft ? left : right > rail.scrollLeft + rail.clientWidth ? right - rail.clientWidth : rail.scrollLeft;
            if (target !== rail.scrollLeft) {
              const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              rail.scrollTo({ left: target, behavior: smooth ? 'smooth' : 'auto' });
            }
          }
          if (focusTarget === 'tab') tab.focus({ preventScroll: true });
        }
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === current);
      });
      if (focusTarget === 'next') {
        panels[current]?.querySelector<HTMLButtonElement>('[data-scene-next]')?.focus({ preventScroll: true });
      }
      if (room) {
        seat();
        room.show(panels[current].dataset.sceneName);
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectScene(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          selectScene(i + 1, 'tab');
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          selectScene(i - 1, 'tab');
        }
      });
    });

    picker?.addEventListener('change', () => selectScene(Number(picker.value)));
    section.querySelectorAll<HTMLButtonElement>('[data-scenes-step]').forEach((button) => {
      button.addEventListener('click', () => selectScene(current + Number(button.dataset.scenesStep)));
    });

    nextButtons.forEach((btn) => {
      btn.addEventListener('click', () => selectScene(current + 1, 'next'));
    });
  }
</script>
