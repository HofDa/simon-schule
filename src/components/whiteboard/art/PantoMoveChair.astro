---
/**
 * Flat front view of a VS PantoMove-LuPo swivel chair in ginstergelb: the PantoSwing shell
 * with its grip hole on a gas spring in a plastic sleeve and a five-star base with glides.
 * The outer arms end on the floor at x = 5 and x = 395 (viewBox 0 0 400 490), where the
 * Leistungen column continues the left one as its route line.
 *
 * The chair can swivel: it renders facing front, and `swivel()` (./swivel.ts) redraws the
 * base, the shell and its side profile for any turn about the column.
 */
import { getLang } from '../../../i18n/ui';
import { arms } from './swivel';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const base = arms(0);
const label = getLang(Astro.currentLocale) === 'it'
  ? 'Sedia girevole PantoMove di VS in giallo ginestra, vista frontale'
  : 'Ginstergelber PantoMove-Drehstuhl von VS, Vorderansicht';
---

<svg class={`panto-move ${className}`} viewBox="0 0 400 490" role="img" aria-label={label} data-swivel>
  <g fill="#E2A300">
    <!-- five-star base: the arms are redrawn as the chair turns -->
    <g fill="none" stroke="#E2A300" stroke-width="11" stroke-linecap="round">
      {base.map((arm) => <path d={arm.d} data-arm />)}
    </g>
    {base.map((arm) => <rect x={arm.glide.x} y={arm.glide.y} width="18" height="14" rx="3" data-glide />)}
    <!-- hub, gas spring sleeve and the seat plate: round, so the same from every side -->
    <ellipse cx="200" cy="430" rx="30" ry="12" />
    <path d="M178 330 H222 L218 426 H182 Z" />
    <rect x="150" y="312" width="100" height="22" rx="6" />

    <g class="pm-shell" data-shell>
      <path
        fill-rule="evenodd"
        d="M200 12
           C260 12 330 8 368 14
           C380 16 382 30 380 44
           C378 90 368 140 320 180
           C300 196 296 212 304 232
           C316 258 350 272 376 280
           C386 284 386 296 376 300
           C330 310 270 314 200 314
           C130 314 70 310 24 300
           C14 296 14 284 24 280
           C50 272 84 258 96 232
           C104 212 100 196 80 180
           C32 140 22 90 20 44
           C18 30 20 16 32 14
           C70 8 140 12 200 12 Z
           M228 72 A28 28 0 1 0 172 72 A28 28 0 1 0 228 72 Z"
      />
    </g>
    <!-- the shell seen from the side (facing right): backrest and seat in one S-curve -->
    <g class="pm-side" opacity="0" data-side>
      <path
        fill="none"
        stroke="#E2A300"
        stroke-width="18"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M104 18 C112 96 126 170 118 238 C114 278 124 302 156 304 L262 306 C282 306 294 312 298 324"
      />
    </g>
  </g>
</svg>

<style>
  .pm-shell,
  .pm-side { filter: brightness(var(--shade, 1)); }
</style>
