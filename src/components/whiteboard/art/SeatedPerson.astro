---
/**
 * A person on a ginstergelb VS Hokki stool, drawn as an architectural scale
 * figure in three frames (side, three-quarter, front). The figure is a contour:
 * each limb is a wide ink stroke under a paper-coloured one, so only the outline
 * of the whole body shows. The stool is flat ginstergelb; the floor belongs to the
 * scene (ContactScene), so it stays level while the figures turn.
 * The contact scene cross-fades between the frames with scroll. Replace with a
 * photo frame sequence (simon-rene-contact-frame-XX.webp) once it has been shot.
 */
interface Props {
  id: string;
  /** Face left instead of right in the side and three-quarter frames. */
  mirror?: boolean;
  label: string;
  class?: string;
}
const { mirror = false, label, class: className = '' } = Astro.props;
const flip = mirror ? 'translate(340 0) scale(-1 1)' : undefined;

/** [path, stroke width] per limb; a head is [cx, cy, r]. */
type Limb = [string, number];
interface Pose {
  name: 'side' | 'quarter' | 'front';
  far?: Limb[];
  near: Limb[];
  head: [number, number, number];
  flip?: boolean;
}
const poses: Pose[] = [
  {
    name: 'side',
    flip: true,
    near: [
      ['M166 238 L176 74', 50],
      ['M170 244 L298 250', 36],
      ['M298 250 L302 388', 28],
      ['M302 397 L326 399', 16],
      ['M182 98 L206 190', 22],
      ['M206 190 L268 232', 20],
    ],
    head: [186, 12, 27],
  },
  {
    name: 'quarter',
    flip: true,
    far: [
      ['M184 240 L262 236', 32],
      ['M262 236 L272 384', 26],
      ['M272 391 L292 393', 15],
      ['M192 98 L214 186', 20],
      ['M214 186 L258 226', 18],
    ],
    near: [
      ['M168 238 L172 74', 54],
      ['M160 246 L238 262', 36],
      ['M238 262 L242 390', 28],
      ['M242 398 L262 401', 16],
      ['M154 98 L166 194', 22],
      ['M166 194 L230 246', 20],
    ],
    head: [178, 10, 27],
  },
  {
    name: 'front',
    near: [
      ['M170 238 L170 74', 58],
      ['M152 242 L134 268', 36],
      ['M188 242 L206 268', 36],
      ['M134 268 L128 390', 28],
      ['M206 268 L212 390', 28],
      ['M124 399 L132 400', 18],
      ['M216 399 L208 400', 18],
      ['M140 98 L124 190', 22],
      ['M124 190 L136 254', 20],
      ['M200 98 L216 190', 22],
      ['M216 190 L204 254', 20],
    ],
    head: [170, 8, 28],
  },
];
const EDGE = 4; // outline width in viewBox units (half on each side)
---

<svg class={className} viewBox="0 -60 340 480" role="img" aria-label={label}>
  <!-- Hokki stool: flat ginstergelb, the seat face a shade lighter -->
  <path class="stool" d="M110 404 C110 382 132 370 170 370 C208 370 230 382 230 404 C212 410 128 410 110 404 Z" />
  <path class="stool" d="M136 280 C146 312 150 334 141 384 L199 384 C190 334 194 312 204 280 Z" />
  <path class="stool" d="M108 256 L108 274 C108 284 136 292 170 292 C204 292 232 284 232 274 L232 256 Z" />
  <ellipse class="stool-top" cx="170" cy="256" rx="62" ry="13" />

  {poses.map((pose) => (
    <g class="pose" data-pose={pose.name} transform={pose.flip ? flip : undefined}>
      {pose.far && (
        <g class="far">
          {pose.far.map(([d, w]) => <path class="edge" d={d} stroke-width={w + EDGE} />)}
          {pose.far.map(([d, w]) => <path class="core" d={d} stroke-width={w} />)}
        </g>
      )}
      {pose.near.map(([d, w]) => <path class="edge" d={d} stroke-width={w + EDGE} />)}
      <circle class="head-edge" cx={pose.head[0]} cy={pose.head[1]} r={pose.head[2] + EDGE / 2} />
      {pose.near.map(([d, w]) => <path class="core" d={d} stroke-width={w} />)}
      <circle class="head-core" cx={pose.head[0]} cy={pose.head[1]} r={pose.head[2]} />
    </g>
  ))}
</svg>

<style>
  .stool { fill: var(--color-ginster); }
  .stool-top { fill: var(--color-ginster-light); }
  .edge, .core { fill: none; stroke-linecap: round; }
  .edge { stroke: var(--color-ink); }
  .core { stroke: var(--color-paper); }
  .head-edge { fill: var(--color-ink); }
  .head-core { fill: var(--color-paper); }
  /* the far arm and leg sit a step back */
  .far .core { stroke: var(--color-surface); }
</style>
