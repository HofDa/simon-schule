---
/**
 * Front elevations traced from VS's product-sheet photographs. The silhouettes,
 * openings and frames follow the references; colour and shading follow the site.
 * References and the tracing choices are recorded in service-chair-references.md.
 */
export type ChairModel = 'pantoswing' | 'jumper-air' | 'pantomove' | 'jumper-ply' | 'bambino';
interface Props { model: ChairModel; }
const { model } = Astro.props;
const names = {
  pantoswing: 'VS PantoSwing-LuPo',
  'jumper-air': 'VS JUMPER Air Four',
  pantomove: 'VS PantoMove-LuPo',
  'jumper-ply': 'VS JUMPER Ply Four',
  bambino: 'VS Bambino',
};
const panto = model === 'pantoswing' || model === 'pantomove';
const backId = `service-${model}-back`;
const pantoBack = 'M92 30 C92 18 112 14 200 14 C288 14 308 18 308 30 C312 84 302 119 278 154 C250 192 242 216 248 249 Q250 258 264 265 H136 Q150 258 152 249 C158 216 150 192 122 154 C98 119 88 84 92 30 Z';
---

<svg viewBox="0 0 400 500" role="img" aria-label={`${names[model]} · Vorderansicht, Illustration`}>
  {panto && (
    <>
      {model === 'pantoswing' ? (
        <>
          <g class="steel">
            <path d="M69 483 V293 Q69 274 88 274 H117 M331 483 V293 Q331 274 312 274 H283" />
            <path d="M72 478 H328" />
          </g>
          <g class="steel-highlight"><path d="M67 465 V295 Q67 273 88 273 M333 465 V295 Q333 273 312 273" /></g>
          <g class="glides"><path d="M69 477 V489 M331 477 V489" /></g>
        </>
      ) : (
        <>
          <path class="mechanism" d="M158 283 H242 L234 319 Q200 328 166 319 Z" />
          <path class="steel-solid" d="M191 316 H209 V350 H191 Z" />
          <path class="mechanism" d="M187 344 H213 V444 H187 Z" />
          <path class="steel-solid" d="M191 438 L73 455 L72 473 L190 456 L200 476 L210 456 L328 473 L327 455 L209 438 Z" />
          <path class="steel-solid" d="M197 438 L133 447 V458 L191 451 H209 L267 458 V447 L203 438 Z" />
          <path class="steel-highlight" d="M76 455 L190 440 M210 440 L324 455" />
          <g class="casters">
            <circle cx="72" cy="481" r="12" /><circle cx="328" cy="481" r="12" />
            <circle cx="138" cy="464" r="10" /><circle cx="262" cy="464" r="10" />
            <circle cx="200" cy="488" r="12" />
          </g>
          <path class="lever" d="M160 307 L131 313" /><path class="glides" d="M120 315 L133 313" />
        </>
      )}
      <defs><clipPath id={backId}><path d={pantoBack} /></clipPath></defs>
      <path class="seat" fill-rule="evenodd" d={`${pantoBack} M220 66 A20 20 0 1 0 180 66 A20 20 0 1 0 220 66 Z`} />
      <g class="shell-grid" clip-path={`url(#${backId})`}>
        <path d="M237 24 V239 M267 24 V210 M297 24 V155 M221 42 H310 M223 74 H311 M223 106 H304 M223 138 H291 M222 170 H268 M222 202 H249" />
      </g>
      <path class="seat" d="M87 263 Q94 255 112 262 Q200 277 288 262 Q306 255 313 263 Q317 271 304 279 L291 294 Q200 314 109 294 L96 279 Q83 271 87 263 Z" />
      <path class="seat-shadow" d="M96 279 Q200 299 304 279 L291 294 Q200 314 109 294 Z" />
      <path class="seat-edge" d="M90 269 Q200 294 310 269" />
    </>
  )}

  {model === 'jumper-air' && (
    <>
      <g class="steel">
        <path d="M58 485 L62 290 Q62 270 82 270 H115 M342 485 L338 290 Q338 270 318 270 H285" />
        <path d="M78 474 L81 297 M322 474 L319 297" />
      </g>
      <g class="steel-highlight"><path d="M60 478 L64 291 M340 478 L336 291" /></g>
      <g class="glides"><path d="M55 488 H63 M337 488 H345 M75 477 H83 M317 477 H325" /></g>
      <path class="seat" fill-rule="evenodd" d="M93 45 Q95 24 126 20 Q200 9 274 20 Q305 24 307 45 L328 158 Q332 179 314 194 L275 218 Q262 227 259 247 L256 276 H144 L141 247 Q138 227 125 218 L86 194 Q68 179 72 158 Z M161 227 Q200 238 239 227 Q243 230 238 235 L212 252 Q200 261 188 252 L162 235 Q157 230 161 227 Z" />
      <path class="seat-shadow" d="M90 234 Q100 242 112 244 L137 259 L144 276 H256 L263 259 L288 244 Q300 242 310 234 L294 281 Q200 313 106 281 Z" />
      <path class="seat" d="M90 264 Q100 282 132 286 Q200 299 268 286 Q300 282 310 264 L311 279 Q310 291 289 297 Q200 317 111 297 Q90 291 89 279 Z" />
      <path class="seat-edge" d="M107 282 Q200 309 293 282" />
      <ellipse class="brand-mark" cx="200" cy="212" rx="5" ry="2" />
    </>
  )}

  {model === 'jumper-ply' && (
    <>
      <g class="steel">
        <path d="M58 485 L65 290 Q66 272 85 272 H120 M342 485 L335 290 Q334 272 315 272 H280" />
        <path d="M77 474 L86 303 M323 474 L314 303" />
      </g>
      <g class="steel-highlight"><path d="M60 478 L67 292 M340 478 L333 292" /></g>
      <g class="glides"><path d="M54 488 H64 M336 488 H346 M73 477 H81 M319 477 H327" /></g>
      <path class="seat" fill-rule="evenodd" d="M92 42 Q94 30 111 26 Q200 4 289 26 Q306 30 308 42 L331 180 Q334 195 320 205 L276 230 Q263 238 261 258 L261 278 H139 L139 258 Q137 238 124 230 L80 205 Q66 195 69 180 Z M162 48 Q200 61 238 48 Q242 52 235 59 L214 73 Q200 82 186 73 L165 59 Q158 52 162 48 Z" />
      <path class="seat" d="M87 267 Q108 263 127 268 Q200 283 273 268 Q292 263 313 267 L313 282 Q310 292 291 295 Q200 306 109 295 Q90 292 87 282 Z" />
      <path class="ply-edge" d="M72 183 Q69 196 83 205 L126 230 Q140 239 142 257 M313 282 Q200 304 87 282" />
      <path class="seat-shadow" d="M139 257 Q200 268 261 257 V278 Q200 289 139 278 Z" />
      <ellipse class="brand-mark" cx="200" cy="94" rx="4" ry="2" />
    </>
  )}

  {model === 'bambino' && (
    <>
      <path class="wood" d="M88 91 Q88 84 98 84 H107 L111 114 L119 327 L107 489 H91 L98 327 Z M312 91 Q312 84 302 84 H293 L289 114 L281 327 L293 489 H309 L302 327 Z" />
      <path class="wood-dark" d="M111 321 H289 V345 H111 Z M110 326 H122 L119 479 H110 Z M278 326 H290 V479 H281 Z" />
      <path class="wood" d="M105 98 Q200 67 295 98 L292 151 H108 Z" />
      <path class="wood-highlight" d="M108 99 Q200 73 292 99" />
      <path class="wood" d="M104 299 Q200 294 296 299 L302 317 Q200 323 98 317 Z" />
      <path class="wood-dark" d="M98 317 Q200 323 302 317 V331 H98 Z" />
      <path class="wood-highlight" d="M100 317 H300" />
    </>
  )}
</svg>

<style>
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .seat { fill: var(--color-ginster); }
  .seat-shadow { fill: #cb9400; }
  .seat-edge { fill: none; stroke: #bd8900; stroke-width: 2.5; stroke-linecap: round; }
  .steel { fill: none; stroke: #969b99; stroke-width: 11; stroke-linecap: round; stroke-linejoin: round; }
  .steel-solid { fill: #a4aaa7; }
  .steel-highlight { fill: none; stroke: #d1d5d2; stroke-width: 3; stroke-linecap: round; }
  .mechanism { fill: #393a37; }
  .glides, .lever { fill: none; stroke: #393a37; stroke-width: 7; stroke-linecap: round; }
  .casters { fill: #393a37; stroke: #777d78; stroke-width: 3; }
  .shell-grid { fill: none; stroke: #f0bd48; stroke-width: 1.5; opacity: 0.42; }
  .ply-edge { fill: none; stroke: #bd8a31; stroke-width: 3; stroke-linecap: round; }
  .brand-mark { fill: #fae4a9; }
  .wood { fill: #cda06b; }
  .wood-dark { fill: #bc8a56; }
  .wood-highlight { fill: none; stroke: #e2ba88; stroke-width: 3; }
</style>
