---
import { contact, fullName, locations, people, roleFor } from '../../data/site';
import { asset } from '../../lib/paths';
import { getLang, useTranslations } from '../../i18n/ui';

const lang = getLang(Astro.currentLocale);
const ui = useTranslations(lang);
const t = ui.people;
const questions = t.questions;
---

<section id="menschen" class="people relative bg-paper pt-12 pb-28 lg:pt-16 lg:pb-40" aria-labelledby="people-title" data-people>
  <div class="shell">
    <div class="people-intro max-w-[60rem]">
      <h2 id="people-title" class="text-headline leading-[0.98] tracking-[-0.03em]">
        {t.title}
      </h2>
      <p class="mt-7 max-w-[52ch] text-body leading-[1.65] text-muted lg:text-lead">
        {t.intro}
      </p>
    </div>

    <div class="people-grid mt-16 lg:mt-24">
      <div class="persons">
        <div class="persons-list">
          {people.map((person) => {
            const role = roleFor(person, lang);
            return (
              <article class="person" data-person>
                {person.photo && (
                  <img
                    class="portrait"
                    src={asset(`images/team/${person.photo}.webp`)}
                    alt={t.portraitAlt(fullName(person))}
                    width="800"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h3 class="person-name">{fullName(person)}</h3>
                {role && <p class="mt-1.5 text-muted">{role}</p>}
                {(person.phone || person.email) && (
                  <ul class="mt-4 space-y-1.5 text-meta">
                    {person.phone && <li><a class="link-line font-semibold" href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a></li>}
                    {person.email && <li><a class="link-line font-semibold" href={`mailto:${person.email}`}>{person.email}</a></li>}
                  </ul>
                )}
              </article>
            );
          })}

          <article class="person" data-person>
            <h3 class="person-name">{t.teamTitle}</h3>
            <p class="mt-1.5 text-muted">{t.teamRole}</p>
            <ul class="mt-4 space-y-1.5 text-meta text-muted">
              {locations.map((loc) => (
                <li>{loc.city[lang]} · {loc.street[lang]}</li>
              ))}
              <li class="pt-0.5"><a class="link-line text-ink" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            </ul>
          </article>
        </div>
      </div>

      <div class="notes" aria-label={t.questionsLabel}>
        <ul>
          {questions.map((q, i) => (
            <li class="note marker" style={`--i: ${i}`} data-note>{q}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .people-grid { display: grid; gap: 64px; }
  .persons-list { display: grid; gap: 32px; }
  /* each contact sits on its own hairline, like an entry in a title block */
  .person { border-top: 1px solid var(--color-line); padding-top: 22px; }
  .person-name {
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .portrait {
    display: block;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 20px;
    background: var(--color-surface);
  }
  .shared-mail { margin-top: 28px; font-size: var(--text-meta); color: var(--color-muted); }

  .notes { position: relative; }
  .notes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .note {
    font-size: var(--text-marker);
    color: #2b2b27;
    line-height: 1.1;
  }
  .note:nth-child(odd) { transform: rotate(-1.2deg); }
  .note:nth-child(even) { transform: rotate(0.8deg); padding-left: 1.2em; }

  @media (min-width: 640px) {
    .persons-list { grid-template-columns: 1fr 1fr; column-gap: 40px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .people-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; align-items: end; }
    .persons-list { grid-template-columns: 1fr; }
  }
  @media (min-width: 1024px) {
    .people-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: end; }
    .persons { grid-column: 1 / 8; }
    .notes { grid-column: 9 / 13; }
    .notes ul { gap: 40px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .person {
      opacity: 0;
      translate: 0 14px;
      transition: opacity 900ms var(--ease-draw), translate 900ms var(--ease-draw);
    }
    :global(html.js) .person + .person { transition-delay: 120ms; }
    :global(html.js) .person.is-in { opacity: 1; translate: 0 0; }
    :global(html.js) .note {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transition: opacity 500ms var(--ease-draw), clip-path 700ms var(--ease-draw);
      transition-delay: calc(var(--i) * 260ms + 200ms);
    }
    :global(html.js) .notes.is-in .note { opacity: 1; clip-path: inset(-10% -5% -10% 0); }
  }
</style>

<script>
  import { revealOnce } from '../../scripts/motion';
  revealOnce(document.querySelectorAll('[data-person], .notes'));

</script>
