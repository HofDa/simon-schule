---
import { homeFor } from '../../../lib/paths';
import Logo from '../../shared/Logo.astro';
import { trias } from '../../../data/site';
import { getLang, langs, useTranslations, type Lang } from '../../../i18n/ui';
import { lernraumCopy } from '../../../i18n/lernraum';

interface Props {
  /** This page in each language, for the language switch (default: the home pages). */
  alternates?: Record<Lang, string>;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const N = lernraumCopy(lang).nav;
const alternates = Astro.props.alternates ?? { de: homeFor('de'), it: homeFor('it') };
// the Whiteboard pages are single pages: its section links and the inquiry stay in-page
const onHome = true;
const home = onHome ? '' : homeFor(lang);
const nav = t.nav.items.map((item) => ({ ...item, href: `${home}${item.href}` }));
---

<header class="site-nav fixed inset-x-0 top-0 z-[100] h-[var(--nav-h)]" data-nav>
  <div class="shell flex h-full items-center justify-between gap-2.5 sm:gap-8">
    <div class="flex min-w-0 items-center gap-6">
      <a href={onHome ? '#top' : homeFor(lang)} class="wordmark flex shrink-0 items-center text-ink" aria-label={t.nav.home}>
        <Logo class="logo-nav" />
      </a>
      <a href="#top" class="board-return" aria-label={N.backToBoard}><span aria-hidden="true">↑</span> {N.toBoard}</a>
    </div>

    <nav class="hidden items-center gap-9 lg:flex" aria-label={t.nav.main}>
      {nav.map((item) => (
        <a class="nav-link relative whitespace-nowrap py-2 text-meta font-medium text-muted transition-colors duration-200 hover:text-ink" href={item.href} data-nav-link>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-right flex items-center gap-3 sm:gap-5">
      <a href={`${home}#anfrage`} class="nav-cta btn btn-ink !gap-2.5 !px-3.5 text-meta sm:!gap-3 sm:!px-4 max-[359px]:!px-3" data-open-form>
        <span class="h-1.5 w-1.5 rounded-full bg-ginster max-[359px]:hidden" aria-hidden="true"></span>
        <span class="sm:hidden">{t.nav.ctaShort}</span>
        <span class="hidden sm:inline">{t.nav.cta}</span>
      </a>
      <button
        type="button"
        class="menu-toggle inline-flex h-11 min-w-11 items-center justify-center px-1 text-meta font-medium"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={t.nav.menu}
        data-label-close={t.nav.close}
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only" data-menu-label>{t.nav.menu}</span>
      </button>
    </div>
  </div>

  <dialog id="mobile-menu" class="site-menu" aria-label={t.nav.main} data-board-menu>
    <div class="menu-header">
      <nav class="menu-languages" aria-label={t.nav.switchLabel}>
        {langs.map((l) => {
          const name = useTranslations(l).langName;
          return l === lang ? (
            <span aria-current="true" lang={l}>{name}</span>
          ) : (
            <a href={alternates[l]} hreflang={l} lang={l}>{name}</a>
          );
        })}
      </nav>
      <button type="button" class="menu-close" aria-label={t.nav.close} data-menu-close autofocus><span aria-hidden="true">×</span></button>
    </div>
    <nav class="menu-navigation" aria-label={t.nav.main}>
      <ul>
        <li><a href="#top" data-menu-link>{N.board}</a></li>
        {nav.map((item) => (
          <li>
            <a href={item.href} data-menu-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu-footer">
      <a href={`${home}#anfrage`} class="btn btn-ginster justify-center" data-menu-link data-open-form>{t.nav.cta}</a>
      <a class="menu-family" href={trias.url[lang]} target="_blank" rel="noopener">{t.nav.family} <span aria-hidden="true">↗</span><span class="sr-only">{t.nav.familyNewTab}</span></a>
    </div>
  </dialog>
</header>

<style>
  .board-return { display: none; }
  @media (min-width: 1024px) {
    .site-nav:not(.is-below-board) .wordmark { display: none; }
    .site-nav:not(.is-below-board) > div > nav,
    .site-nav:not(.is-below-board) .nav-cta { display: none; }
    .site-nav.is-below-board .board-return { position: absolute; top: calc(100% + 12px); left: 28px; display: inline-flex; align-items: center; gap: 8px; padding: 4px 14px; border: 1px solid var(--color-line); border-radius: 2px; background: #fafbf9; box-shadow: 0 4px 12px #20201d0a; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .board-return > span { color: var(--color-ginster-deep); font-size: 20px; }
    .site-nav.is-below-board > div > nav { gap: clamp(12px, 2vw, 30px); }
  }
  .wordmark :global(.logo-nav) { height: 24px; width: auto; }
  @media (min-width: 420px) { .wordmark :global(.logo-nav) { height: 30px; } }
  @media (min-width: 1280px) { .wordmark :global(.logo-nav) { height: 36px; } }
  .site-nav {
    transition: background-color 300ms var(--ease-draw);
  }
  .site-nav.is-scrolled,
  .site-nav.is-open,
  :global(html:not(.js)) .site-nav {
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
    backdrop-filter: blur(12px) saturate(1.1);
  }
  /* open: an opaque header without the blur, which would otherwise become the containing block
     of the fixed menu sheet and collapse it to the header's height */
  .site-nav.is-open { background: var(--color-paper); -webkit-backdrop-filter: none; backdrop-filter: none; }

  /* a compact button in the header; on touch a full 44px target at every width */
  .nav-cta { min-height: 40px; }
  /* with the sheet open its own inquiry button takes over, and "Schließen" needs the room */
  .site-nav.is-open .nav-cta { display: none; }
  @media (pointer: coarse) {
    .nav-cta { min-height: 44px; }
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-ginster);
    transform: translateX(-50%) scale(0);
    transition: transform 250ms var(--ease-draw);
  }
  .nav-link[aria-current='true'] { color: var(--color-ink); }
  .nav-link[aria-current='true']::after { transform: translateX(-50%) scale(1); }

  .menu-toggle { color: #231f20; }
  .menu-toggle:focus-visible { outline: 2px solid var(--color-ginster-deep); outline-offset: 3px; }
  /* As on trias.it: two ink bars and a shorter lower bar, here in the Trias Schule accent */
  .menu-icon { position: relative; display: block; width: 32px; height: 22px; }
  .menu-icon span {
    position: absolute;
    left: 0;
    height: 3px;
    background: currentColor;
    transition: transform 250ms var(--ease-draw), top 250ms var(--ease-draw), width 250ms var(--ease-draw),
      opacity 150ms linear, background-color 250ms var(--ease-draw);
  }
  .menu-icon span:nth-child(1) { top: 0; width: 100%; }
  .menu-icon span:nth-child(2) { top: 9px; width: 100%; }
  .menu-icon span:nth-child(3) { top: 18px; width: 66%; background: var(--color-ginster); }
  .menu-toggle:hover .menu-icon span:nth-child(3) { width: 100%; }
  [aria-expanded='true'] .menu-icon span:nth-child(1) { top: 9px; transform: rotate(45deg); }
  [aria-expanded='true'] .menu-icon span:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .menu-icon span:nth-child(3) { top: 9px; width: 100%; transform: rotate(-45deg); background: currentColor; }
  /* Desktop: the menu sits inside the board's upper-right corner, then joins the fixed navigation below it. */
  @media (min-width: 1024px) {
    .menu-toggle { position: absolute; top: 50%; right: 40px; translate: 0 -50%; padding: 0; }
    .site-nav:not(.is-below-board) {
      position: absolute;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      pointer-events: none;
    }
    .site-nav:not(.is-below-board) .menu-toggle {
      top: 24px;
      right: 60px;
      translate: none;
      pointer-events: auto;
    }
    .site-nav:not(.is-below-board) .site-menu { pointer-events: auto; }
    .menu-icon { width: 45px; height: 26px; }
    .menu-icon span { height: 3.5px; }
    .menu-icon span:nth-child(2) { top: 11px; }
    .menu-icon span:nth-child(3) { top: 22px; width: 64%; }
    /* open: the header stays as it is and the hamburger keeps its bars (the panel has its own ×) */
    .site-nav.is-open:not(.is-scrolled) { background: transparent; }
    [aria-expanded='true'] .menu-icon span:nth-child(1) { top: 0; transform: none; }
    [aria-expanded='true'] .menu-icon span:nth-child(2) { opacity: 1; }
    [aria-expanded='true'] .menu-icon span:nth-child(3) { top: 22px; width: 64%; transform: none; background: var(--color-ginster); }
    /* the header's button keeps clear of the hamburger */
    .nav-right { margin-right: max(0px, calc(40px + 45px + 28px - var(--gutter))); }
  }

  /* The menu, after trias.it: a dark panel at the right; opening pushes the whole page to the left
     while the panel moves in with it (0.4s), closing slides both back. */
  :global(:root) { --menu-w: min(440px, 92vw); }
  :global(html.site-menu-open) { overflow: hidden; }
  :global(html.site-menu-anim body > *:not(dialog)) { transition: transform 400ms cubic-bezier(.4, 0, .2, 1); }
  :global(html.site-menu-push body > *:not(dialog)) { transform: translateX(calc(-1 * var(--menu-w))); }
  /* Keep the board beside the sidebar; its artwork fits into the remaining surface. */
  @media (min-width: 1024px) {
    :global(html.site-menu-fit.site-menu-push main) { transform: none; }
  }
  .site-menu { position: fixed; inset: 0 0 0 auto; width: var(--menu-w); max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: #231f20; color: #fff; overflow-y: auto; overscroll-behavior: contain; }
  .site-menu:not([open]) { display: none; }
  .site-menu[open] { display: flex; flex-direction: column; animation: menu-enter 400ms cubic-bezier(.4, 0, .2, 1); }
  .site-menu.is-closing { animation: menu-leave 400ms cubic-bezier(.4, 0, .2, 1) forwards; }
  /* no dimming: the page stays as it is, pushed aside (a click on it closes the menu) */
  .site-menu::backdrop { background: transparent; }
  .menu-header { display: flex; align-items: stretch; justify-content: space-between; min-height: 60px; padding-left: 30px; border-bottom: 1px solid #ffffff12; }
  .menu-languages { display: flex; align-items: center; gap: 22px; font-size: 13px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .menu-languages > * { position: relative; display: inline-flex; align-items: center; min-height: 44px; }
  .menu-languages a { color: #999; transition: color 150ms ease; }
  .menu-languages a:hover { color: #fff; }
  .menu-languages [aria-current='true'] { color: #fff; }
  .menu-languages [aria-current='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 9px; height: 2px; background: var(--color-ginster); }
  .menu-close { display: grid; place-items: center; width: 60px; min-height: 60px; padding: 0; border: 0; background: #2f2a2b; color: #fff; font-size: 38px; font-weight: 200; line-height: 1; cursor: pointer; transition: background-color 150ms ease, color 150ms ease; }
  .menu-close:hover { background: #3b3537; color: var(--color-ginster); }
  .menu-navigation { padding: clamp(24px, 6.5vh, 64px) 30px 24px; }
  .menu-navigation a { display: block; padding-block: clamp(12px, 2.6vh, 21px); color: #fff; font-size: clamp(23px, 2vw, 28px); line-height: 1.2; font-weight: 400; letter-spacing: -.01em; transition: color 150ms ease, translate 150ms ease; }
  .menu-navigation a:hover { color: var(--color-ginster); translate: 4px 0; }
  .menu-footer { display: flex; flex-direction: column; gap: 24px; margin-top: auto; padding: 0 30px max(30px, env(safe-area-inset-bottom)); }
  .menu-family { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-size: 13px; color: #c5bdbf; }
  .menu-family:hover { color: #fff; }
  .site-menu a:focus-visible, .menu-close:focus-visible { outline: 2px solid var(--color-ginster); outline-offset: 4px; }
  .menu-close:focus-visible { outline-offset: -6px; }
  @keyframes menu-enter { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes menu-leave { from { transform: translateX(0); } to { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) {
    .site-menu[open], .site-menu.is-closing { animation: none; }
    .menu-icon span, .menu-navigation a { transition: none; }
    :global(html.site-menu-push body > *:not(dialog)) { transform: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      const board = document.querySelector<HTMLElement>('[data-board-home]');
      header.classList.toggle('is-below-board', Boolean(board) && window.scrollY >= (board?.offsetHeight ?? window.innerHeight) - header.offsetHeight);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  const syncMenu = () => {
    if (!toggle || !menu || !header) return;
    const open = menu.open && !menu.classList.contains('is-closing');
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('site-menu-open', open);
    if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
  };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const board = document.querySelector<HTMLElement>('[data-board-home]');
  const desktop = window.matchMedia('(min-width: 1024px)');
  const fitBoardToMenu = () => {
    const frame = board?.querySelector<HTMLElement>('.board-frame');
    const fits = Boolean(menu?.open && desktop.matches && board && frame && !header?.classList.contains('is-below-board'));
    root.classList.toggle('site-menu-fit', fits);
    if (!fits || !board || !frame || !menu) return;

    // Use the board's normal width even while its right padding is animating.
    // The canvas keeps its own dimensions, preserving dragged magnets and drawings.
    const gutter = parseFloat(getComputedStyle(board).paddingLeft);
    const frameStyle = getComputedStyle(frame);
    const inset = parseFloat(frameStyle.paddingLeft) + parseFloat(frameStyle.borderLeftWidth);
    const fullWidth = board.clientWidth - 2 * (gutter + inset);
    const sidebarWidth = menu.getBoundingClientRect().width;
    board.style.setProperty('--board-menu-full-width', `${fullWidth}px`);
    board.style.setProperty('--board-menu-scale', String((fullWidth - sidebarWidth) / fullWidth));
  };
  const clearBoardFit = () => {
    root.classList.remove('site-menu-fit');
    board?.style.removeProperty('--board-menu-full-width');
    board?.style.removeProperty('--board-menu-scale');
  };
  window.addEventListener('resize', fitBoardToMenu);
  let closing = 0;
  /** Fit the visible board beside the menu; other sections retain the page-push transition. */
  const setMenu = (open: boolean, instant = false) => {
    if (!menu) return;
    if (open && !menu.open) {
      window.clearTimeout(closing);
      menu.classList.remove('is-closing');
      document.querySelector('[data-board-home]')?.dispatchEvent(new Event('whiteboard:tools-idle'));
      root.classList.add('site-menu-anim');
      menu.showModal();
      fitBoardToMenu();
      requestAnimationFrame(() => root.classList.add('site-menu-push'));
    } else if (!open && menu.open) {
      root.classList.remove('site-menu-push');
      const finish = () => {
        menu.classList.remove('is-closing');
        if (menu.open) menu.close();
        root.classList.remove('site-menu-anim');
        clearBoardFit();
      };
      if (instant || reduce.matches) finish();
      else {
        menu.classList.add('is-closing');
        syncMenu();
        closing = window.setTimeout(finish, 400);
      }
    }
    syncMenu();
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
  menu?.addEventListener('close', syncMenu);
  // Escape closes with the same slide
  menu?.addEventListener('cancel', (event) => {
    event.preventDefault();
    setMenu(false);
  });
  menu?.addEventListener('click', (event) => {
    const rect = menu.getBoundingClientRect();
    if (event.target === menu && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) setMenu(false);
  });
  // Close at once before the board's capture handler opens a topic or an inquiry dialog.
  window.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest('a[href]');
    if (link && menu?.contains(link)) setMenu(false, true);
  }, true);

  // Active section marker
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  // only links into this page's own sections (other pages link to the home page's sections)
  const inPage = (a: HTMLAnchorElement) => new URL(a.href).pathname === location.pathname;
  // every section of the page is watched: over one that has no nav entry (hero, phases) no link is marked
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));
  if ('IntersectionObserver' in window && links.some(inPage)) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id ? `#${entry.target.id}` : '';
          links.forEach((a) => a.setAttribute('aria-current', String(Boolean(id) && inPage(a) && a.hash === id)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
