---
/**
 * The classroom's one piece of furniture, seen from above: a VS shell seat with its backrest
 * behind it. It faces up (towards the board) and is centred on 0 0, so a rotation turns it in place.
 * Each use can recolour it: --seat (fill), --seat-line and --seat-dash (outline, for an empty place).
 */
---

<svg class="sprite" aria-hidden="true" width="0" height="0">
  <symbol id="kz-chair" viewBox="-12 -12 24 24" overflow="visible">
    <rect x="-8" y="-8.5" width="16" height="14" rx="4.5" style="fill: var(--seat, var(--color-ginster)); stroke: var(--seat-line, none); stroke-width: 1.4; stroke-dasharray: var(--seat-dash, none)" />
    <path d="M-9 8.5 Q0 13 9 8.5" fill="none" style="stroke: var(--back, var(--color-ink))" stroke-width="2.4" stroke-linecap="round" />
  </symbol>
</svg>

<style>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
