---
import { contact, fullName, people, type Person } from '../../../data/site';
import { getLang, useTranslations } from '../../../i18n/ui';
import Lesson from './Lesson.astro';

/**
 * Sitzkreis: Simon and Rene sit in a circle of ten chairs. Four chairs hold the questions of a
 * planning talk (the one asked shows in the middle), the chair nearest the visitor is free for them.
 */
const ui = useTranslations(getLang(Astro.currentLocale));
const t = ui.people;
const [simon, rene] = people;

const openFacts = (p: Person) =>
  [!p.lastName && ui.pendingFields.lastName, !p.role && ui.pendingFields.role, !p.phone && ui.pendingFields.phone].filter(
    (f): f is string => Boolean(f),
  );
const sharedMail = people.some((p) => !p.email);

// ten places, the first at the top; each chair is turned to face the middle
type Seat = { kind: 'empty' } | { kind: 'person'; person: Person } | { kind: 'question'; q: number } | { kind: 'you' };
const seats: Seat[] = [
  { kind: 'empty' },
  { kind: 'question', q: 1 },
  { kind: 'empty' },
  { kind: 'person', person: simon },
  { kind: 'question', q: 2 },
  { kind: 'you' },
  { kind: 'question', q: 3 },
  { kind: 'person', person: rene },
  { kind: 'empty' },
  { kind: 'question', q: 0 },
];
const placed = seats.map((seat, i) => {
  const a = -90 + i * (360 / seats.length);
  const rad = (a * Math.PI) / 180;
  return {
    seat,
    x: (50 + 40 * Math.cos(rad)).toFixed(2),
    y: (50 + 40 * Math.sin(rad)).toFixed(2),
    r: a - 90,
    ox: Math.cos(rad).toFixed(3),
    oy: Math.sin(rad).toFixed(3),
  };
});
---

<section id="menschen" class="circle-section" aria-labelledby="people-title">
  <div class="shell grid-wrap">
    <div class="copy">
      <Lesson n="03" name="Sitzkreis" note="miteinander reden, einander zuhören" layout="circle" from="groups" />
      <h2 id="people-title" class="text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
      <p class="mt-7 max-w-[46ch] text-body leading-[1.65] text-muted lg:text-lead">{t.intro}</p>
      <div class="persons">
        {people.map((person) => {
          const open = openFacts(person);
          return (
            <article class="person">
              <h3 class="name">{fullName(person)}</h3>
              {person.role && <p class="mt-1 text-muted">{person.role}</p>}
              {open.length > 0 && <p class="open-fact mt-2 text-meta">{ui.pending(open)}</p>}
              {person.email && <p class="mt-3 text-meta"><a class="link-line" href={`mailto:${person.email}`}>{person.email}</a></p>}
            </article>
          );
        })}
      </div>
      {sharedMail && (
        <p class="mail">{t.reachBoth} <a class="link-line font-semibold text-ink" href={`mailto:${contact.email}`}>{contact.email}</a></p>
      )}
    </div>

    <div class="ring-wrap">
      <div class="kz-ring" data-ring>
        <span class="rug" aria-hidden="true"></span>
        <div class="middle">
          <p class="middle-label">{t.questionsLabel}</p>
          <ul class="questions" id="kz-questions">
            {t.questions.map((q, i) => <li class="question marker" data-question={i}>{q}</li>)}
          </ul>
        </div>
        {placed.map(({ seat, x, y, r, ox, oy }) => {
          const style = `left: ${x}%; top: ${y}%; --r: ${r}deg; --ox: ${ox}; --oy: ${oy}`;
          const chair = <svg class="chair" viewBox="-12 -12 24 24" aria-hidden="true"><use href="#kz-chair" x="-12" y="-12" width="24" height="24" /></svg>;
          if (seat.kind === 'person') return (
            <span class="seat seat-person" style={style}>{chair}<span class="seat-label">{seat.person.firstName}</span></span>
          );
          if (seat.kind === 'question') return (
            <button class="seat seat-question" type="button" style={style} data-ask={seat.q} aria-controls="kz-questions" aria-label={t.questions[seat.q]}>
              {chair}<span class="seat-q" aria-hidden="true">?</span>
            </button>
          );
          if (seat.kind === 'you') return (
            <a class="seat seat-you" href="#anfrage" data-open-form style={style}>{chair}<span class="seat-label">Ihr Platz</span></a>
          );
          return <span class="seat" style={style} aria-hidden="true">{chair}</span>;
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .circle-section { padding-block: clamp(80px, 9vw, 144px); }
  .grid-wrap { display: grid; gap: 56px; }
  .persons { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
  .person { border-top: 1px solid var(--color-line); padding-top: 18px; }
  .name { font-size: var(--text-title); letter-spacing: -0.03em; line-height: 1.05; }
  .mail { margin-top: 24px; font-size: var(--text-meta); color: var(--color-muted); }

  .ring-wrap { display: grid; place-items: center; }
  .kz-ring { --chair: clamp(38px, 9vw, 60px); position: relative; width: min(100%, 580px); aspect-ratio: 1; margin: calc(var(--chair) * 0.7); }
  .rug { position: absolute; inset: 20%; border-radius: 50%; background: var(--color-warm); box-shadow: inset 0 0 0 1px var(--color-line); }

  .middle { position: absolute; inset: 24%; display: grid; place-content: center; text-align: center; }
  .middle-label { color: var(--color-muted); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .questions { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
  .question { font-size: clamp(1rem, 1.5vw, 1.3rem); line-height: 1.1; color: var(--color-ink); }
  /* with script, the question asked stands alone in the middle */
  :global(html.js) .kz-ring.is-live .questions { display: grid; grid-template-areas: 'q'; }
  :global(html.js) .kz-ring.is-live .question {
    grid-area: q;
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    opacity: 0;
    translate: 0 8px;
    transition: opacity 350ms var(--ease-draw), translate 450ms var(--ease-draw);
  }
  :global(html.js) .kz-ring.is-live .question.is-asked { opacity: 1; translate: 0 0; }

  .seat {
    position: absolute;
    width: var(--chair);
    height: var(--chair);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    transform: translate(-50%, -50%);
  }
  .chair { display: block; width: 100%; height: 100%; overflow: visible; transform: rotate(var(--r)); transition: transform 400ms var(--ease-draw); }
  .seat-person { --seat: var(--color-ink); --back: var(--color-ink); }
  .seat-you { --seat: var(--color-paper); --seat-line: var(--color-ink); --seat-dash: 3 2.5; --back: var(--color-muted); }
  .seat-you:hover, .seat-you:focus-visible { --seat: var(--color-ginster-light); }

  /* labels sit outside the ring, along the line from the middle through the chair */
  .seat-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translate(calc(var(--ox) * var(--chair) * 1.05), calc(var(--oy) * var(--chair) * 0.95));
    white-space: nowrap;
    font-size: var(--text-meta);
    font-weight: 600;
  }
  .seat-you .seat-label { font-family: var(--font-marker); font-size: var(--text-marker); font-weight: 600; }
  .seat-q {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -58%);
    font-size: 0.95rem;
    font-weight: 700;
    pointer-events: none;
  }
  .seat-question { cursor: pointer; }
  .seat-question:hover .chair, .seat-question.is-asking .chair { transform: rotate(var(--r)) scale(1.12); }
  .seat-question.is-asking { --seat: var(--color-ink); }
  .seat-question.is-asking .seat-q { color: var(--color-paper); }

  @media (min-width: 1024px) {
    .grid-wrap { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); align-items: center; }
    .copy { grid-column: 1 / 6; }
    .ring-wrap { grid-column: 6 / 13; }
  }
  @media (max-width: 479px) {
    .persons { grid-template-columns: 1fr; }
    .middle-label { display: none; }
  }
</style>

<script>
  // The circle talks: one question at a time, passed round while the circle is in view.
  // Choosing a chair asks its question and stops the round.
  const ring = document.querySelector<HTMLElement>('[data-ring]');
  if (ring) {
    const questions = Array.from(ring.querySelectorAll<HTMLElement>('[data-question]'));
    const chairs = Array.from(ring.querySelectorAll<HTMLButtonElement>('[data-ask]'));
    let current = 0;
    let timer: number | undefined;
    const ask = (q: number) => {
      current = q;
      questions.forEach((el, i) => {
        el.classList.toggle('is-asked', i === q);
        el.setAttribute('aria-hidden', String(i !== q));
      });
      chairs.forEach((c) => {
        const on = Number(c.dataset.ask) === q;
        c.classList.toggle('is-asking', on);
        c.setAttribute('aria-pressed', String(on));
      });
    };
    ring.classList.add('is-live');
    ask(0);
    const stop = () => window.clearInterval(timer);
    chairs.forEach((c) => c.addEventListener('click', () => { stop(); ask(Number(c.dataset.ask)); }));
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      let stopped = false;
      chairs.forEach((c) => c.addEventListener('click', () => { stopped = true; }));
      new IntersectionObserver(([entry]) => {
        stop();
        if (entry.isIntersecting && !stopped) timer = window.setInterval(() => ask((current + 1) % questions.length), 3200);
      }, { threshold: 0.4 }).observe(ring);
    }
  }
</script>
