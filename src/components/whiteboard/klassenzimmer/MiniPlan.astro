---
/**
 * The room from above, beside a section's seating order: the same twelve chairs stand as in the
 * section before and move into this section's order when it comes into view. Decorative.
 */
export type Layout = 'frontal' | 'groups' | 'circle' | 'landscape' | 'stations' | 'talk';
interface Props {
  layout: Layout;
  /** the order the chairs come from (the section above) */
  from: Layout;
}
const { layout, from } = Astro.props;
type Spot = [x: number, y: number, r: number];
const layouts: Record<Layout, { spots: Spot[] }> = {
  frontal: {
    spots: [24, 48, 72, 96].flatMap((x) => [34, 54, 74].map((y): Spot => [x, y, 0])),
  },
  groups: {
    spots: [[24, 46], [60, 68], [96, 46]].flatMap(([cx, cy]): Spot[] => [
      [cx, cy - 12, 180], [cx + 12, cy, -90], [cx, cy + 12, 0], [cx - 12, cy, 90],
    ]),
  },
  circle: {
    spots: Array.from({ length: 12 }, (_, i): Spot => {
      const a = -90 + i * 30;
      const rad = (a * Math.PI) / 180;
      return [60 + 30 * Math.cos(rad), 52 + 30 * Math.sin(rad), a - 90];
    }),
  },
  landscape: {
    spots: [[18, 30, 20], [30, 38, -30], [82, 26, 10], [96, 32, 60], [50, 62, 90], [64, 54, 200], [18, 70, -80], [30, 80, 0], [88, 66, 130], [102, 78, -20], [72, 82, 15], [46, 28, -10]],
  },
  stations: {
    spots: [
      ...[[24, 30], [60, 26], [96, 30], [84, 66], [36, 66]].flatMap(([cx, cy]): Spot[] => [[cx - 9, cy, 90], [cx + 9, cy, -90]]),
      [104, 84, 0], [112, 84, 0],
    ],
  },
  talk: {
    spots: [[60, 38, 180], [60, 68, 0], ...Array.from({ length: 10 }, (_, i): Spot => [12 + i * 10.6, 85, 0])],
  },
};
const place = (k: Layout, i: number) => {
  const [x, y, r] = layouts[k].spots[i];
  return `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) rotate(${r.toFixed(0)}deg)`;
};
const chairStyle = (i: number) => `--from: ${place(from, i)}; --to: ${place(layout, i)}; --i: ${i}`;
---

<div class={`plan show-${layout}`} data-plan aria-hidden="true">
  <svg viewBox="0 0 120 92">
    <rect x="1" y="1" width="118" height="90" rx="2" class="wall" />
    <rect x="34" y="5" width="52" height="3.5" rx="1" class="board" />
    <g class="layer l-groups">{[[24, 46], [60, 68], [96, 46]].map(([cx, cy]) => <rect x={cx - 7} y={cy - 7} width="14" height="14" rx="1.5" class="furniture" />)}</g>
    <g class="layer l-circle"><circle cx="60" cy="52" r="22" class="rug" /></g>
    <g class="layer l-landscape"><rect x="8" y="18" width="32" height="28" rx="2" class="zone" /><rect x="70" y="52" width="42" height="34" rx="2" class="zone" /></g>
    <g class="layer l-stations">{[[24, 30], [60, 26], [96, 30], [84, 66], [36, 66]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="5" class="furniture" />)}</g>
    <g class="layer l-talk"><rect x="48" y="46" width="24" height="14" rx="1.5" class="furniture" /></g>
    {layouts.frontal.spots.map((_, i) => (
      <g class="seat" style={chairStyle(i)}><use href="#kz-chair" x="-5" y="-5" width="10" height="10" /></g>
    ))}
  </svg>
</div>

<style>
  .plan { width: 112px; flex: none; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .wall { fill: var(--color-warm); stroke: var(--color-ink); stroke-width: 1.5; }
  .board { fill: #c3c7ca; }
  .furniture { fill: var(--color-paper); stroke: var(--color-ink); stroke-width: 0.9; }
  .rug { fill: var(--color-paper); stroke: var(--color-line); stroke-width: 0.9; }
  .zone { fill: none; stroke: #c3bfb3; stroke-width: 0.9; stroke-dasharray: 2 1.5; }
  .layer { opacity: 0; transition: opacity 600ms var(--ease-draw) 300ms; }
  .show-groups .l-groups, .show-circle .l-circle, .show-landscape .l-landscape, .show-stations .l-stations, .show-talk .l-talk { opacity: 1; }
  .seat { transform: var(--to); }

  @media (prefers-reduced-motion: no-preference) {
    /* the room is rearranged when the section arrives: chairs leave the last order for this one */
    :global(html.js) .seat { transform: var(--from); transition: transform 1100ms var(--ease-draw); transition-delay: calc(var(--i) * 45ms + 200ms); }
    :global(html.js) .layer { opacity: 0; }
    :global(html.js) .plan.is-in .seat { transform: var(--to); }
    :global(html.js) .plan.show-groups.is-in .l-groups,
    :global(html.js) .plan.show-circle.is-in .l-circle,
    :global(html.js) .plan.show-landscape.is-in .l-landscape,
    :global(html.js) .plan.show-stations.is-in .l-stations,
    :global(html.js) .plan.show-talk.is-in .l-talk { opacity: 1; }
  }
</style>

<script>
  import { revealOnce } from '../../../scripts/motion';
  revealOnce(document.querySelectorAll('[data-plan]'), '0px 0px -30% 0px');
</script>
