---
import { getLang, useTranslations } from '../../../i18n/ui';
import Lesson from './Lesson.astro';

/**
 * Stationenlernen: the five project phases as stations along one route. Each station opens the
 * inquiry with its phase already chosen (see Talk: data-phase).
 */
const ui = useTranslations(getLang(Astro.currentLocale));
const t = ui.phases;
const phases = ui.form.phases.map((name, i) => ({ name, hint: t.hints[i] }));
---

<section class="stations" aria-labelledby="phases-title">
  <div class="shell">
    <Lesson n="05" name="Stationenlernen" note="dort einsteigen, wo man gerade steht" layout="stations" from="landscape" />
    <h2 id="phases-title" class="max-w-[16ch] text-headline leading-[0.98] tracking-[-0.03em]">{t.title}</h2>
    <p class="mt-6 max-w-[44ch] text-body leading-[1.65] text-muted lg:text-lead">{t.lead}</p>

    <ol class="route">
      {phases.map((p, i) => (
        <li>
          <a class="station" href="#anfrage" data-open-form data-phase={p.name}>
            <span class="station-table" aria-hidden="true">
              <svg viewBox="-30 -30 60 60">
                <use href="#kz-chair" x="-30" y="-12" width="24" height="24" transform="rotate(90 -18 0)" />
                <use href="#kz-chair" x="6" y="-12" width="24" height="24" transform="rotate(-90 18 0)" />
              </svg>
              <span class="station-n">{i + 1}</span>
            </span>
            <span class="station-copy">
              <span class="station-label">Station {i + 1}</span>
              <span class="station-name">{p.name}</span>
              <span class="station-hint">{p.hint}</span>
              <span class="station-go">Hier anfangen →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stations { padding-block: clamp(80px, 9vw, 144px); background: var(--color-warm); }
  .route { position: relative; list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; display: grid; gap: 28px; }
  /* the route from station to station, dashed like tape on the floor */
  .route::before {
    content: '';
    position: absolute;
    left: 44px;
    top: 44px;
    bottom: 44px;
    border-left: 2px dashed var(--color-ginster-deep);
  }

  .station { position: relative; display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 20px; align-items: start; }
  .station-table {
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
  }
  .station-table svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .station-n {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: background-color 250ms var(--ease-draw);
  }
  .station:hover .station-n, .station:focus-visible .station-n { background: var(--color-ginster); }
  .station-copy { display: grid; gap: 6px; padding-top: 14px; }
  .station-label { color: var(--color-muted); font-size: var(--text-label); letter-spacing: 0.08em; text-transform: uppercase; }
  .station-name { font-size: var(--text-phi-1); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; }
  .station-hint { max-width: 32ch; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.5; }
  .station-go { margin-top: 4px; font-size: var(--text-meta); font-weight: 600; opacity: 0; transform: translateX(-4px); transition: opacity 200ms, transform 200ms var(--ease-draw); }
  .station:hover .station-go, .station:focus-visible .station-go { opacity: 1; transform: none; }
  @media (hover: none) { .station-go { opacity: 1; transform: none; } }

  @media (min-width: 1024px) {
    .route { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); }
    .route::before { left: 44px; right: 10%; top: 44px; bottom: auto; border-left: 0; border-top: 2px dashed var(--color-ginster-deep); }
    .station { grid-template-columns: 1fr; gap: 12px; }
    .station-copy { padding-top: 0; }
    .station-name { font-size: clamp(var(--text-lead), 1.9vw, var(--text-phi-1)); }
  }
</style>
