---
import MiniPlan, { type Layout } from './MiniPlan.astro';

/** The seating order of a section, written like a note on the lesson plan, with the room beside it. */
interface Props {
  n: string;
  name: string;
  note: string;
  layout: Layout;
  from: Layout;
}
const { n, name, note, layout, from } = Astro.props;
---

<div class="lesson">
  <MiniPlan layout={layout} from={from} />
  <p class="lesson-copy">
    <span class="lesson-n">Sitzordnung {n}</span>
    <span class="lesson-name marker">{name}</span>
    <span class="lesson-note">{note}</span>
  </p>
</div>

<style>
  .lesson { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
  .lesson-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .lesson-n { color: var(--color-muted); font-size: var(--text-label); font-variant-numeric: tabular-nums; letter-spacing: 0.08em; text-transform: uppercase; }
  .lesson-name {
    position: relative;
    z-index: 0;
    font-size: var(--text-marker);
    color: var(--color-ink);
    transform: rotate(-1.5deg);
  }
  .lesson-name::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -4%;
    bottom: 0.02em;
    height: 0.18em;
    border-radius: 99px;
    background: var(--color-ginster);
    opacity: 0.55;
    z-index: -1;
  }
  .lesson-note { color: var(--color-muted); font-size: var(--text-meta); }
</style>
