---
/**
 * Example rooms on white paper. Each photograph is measured before it opens:
 * a dimension line draws across its width, then the frame opens from the plan's
 * outline to the full image. Without motion everything is simply shown.
 */
import { getProjects } from '../data/projects';
import { asset } from '../lib/paths';
import { getLang, useTranslations } from '../i18n/ui';
import ProjectTestimonial from './ProjectTestimonial.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).projects;
const projects = getProjects(lang);
const layouts = ['left', 'right', 'full'] as const;
const src = (file: string, w: number) => asset(`images/projects/${file}-${w}.webp`);
const widths = [320, 480, 640, 720, 900, 960, 1800];
const srcset = (file: string) => widths.map((w) => `${src(file, w)} ${w}w`).join(', ');
---

<section id="projekte" class="projects sheet-paper" aria-labelledby="projects-title" data-projects>
  <div class="shell">
    <header class="pr-head">
      <h2 id="projects-title" class="pr-title display">{t.title}</h2>
      <p class="pr-sub">{t.sub}</p>
    </header>

    <div class="pr-list">
      {projects.map((project, i) => {
        const layout = layouts[i % layouts.length];
        const [main, detail] = project.images;
        const sizes = layout === 'full'
          ? '(min-width: 1560px) 1560px, 100vw'
          : '(min-width: 1560px) 960px, (min-width: 1024px) 64vw, calc(100vw - 40px)';
        return (
          <>
            <article class={`pr pr--${layout}`} data-project aria-labelledby={`p-${project.id}`}>
              <div class="pr-figure">
                <div class="dim pr-dim" aria-hidden="true"><span class="dim-end"></span></div>
                <div class="pr-media" data-media>
                  <img
                    src={src(main.file, 900)}
                    srcset={srcset(main.file)}
                    sizes={sizes}
                    alt={main.alt}
                    width="1800"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <div class="pr-info">
                <h3 id={`p-${project.id}`} class="pr-name">{project.title}</h3>
                {project.placeholder && <p class="tag-placeholder pr-status">{t.placeholder}</p>}
                <p class="pr-desc">{project.description}</p>
                <dl class="pr-meta">
                  {project.location && <div><dt>{t.meta.location}</dt><dd>{project.location}</dd></div>}
                  <div><dt>{t.meta.type}</dt><dd>{project.type}</dd></div>
                  <div><dt>{t.meta.services}</dt><dd>{project.services.join(' · ')}</dd></div>
                  {project.year && <div><dt>{t.meta.year}</dt><dd class="tnum">{project.year}</dd></div>}
                  {project.architect && <div><dt>{t.meta.architect}</dt><dd>{project.architect}</dd></div>}
                  {project.client && <div><dt>{t.meta.client}</dt><dd>{project.client}</dd></div>}
                </dl>
                {detail && layout !== 'full' && (
                  <div class="pr-detail">
                    <img
                      src={src(detail.file, 640)}
                      srcset={srcset(detail.file)}
                      sizes="(min-width: 1024px) 22vw, 60vw"
                      alt={detail.alt}
                      width="900"
                      height="675"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
              </div>
            </article>
            {project.testimonial && <ProjectTestimonial testimonial={project.testimonial} />}
          </>
        );
      })}
    </div>
  </div>
</section>

<style>
  .projects { padding-block: clamp(104px, 12vw, 176px); }
  .pr-head { display: grid; gap: 24px; align-items: end; }
  .pr-title { font-size: var(--text-display); }
  .pr-sub { max-width: 46ch; color: var(--color-muted); font-size: var(--text-body); }

  .pr-list { display: flex; flex-direction: column; gap: clamp(96px, 11vw, 168px); margin-top: clamp(64px, 8vw, 120px); }

  .pr { display: grid; gap: 28px; align-items: start; }
  .pr-figure { min-width: 0; }
  .pr-dim { margin-bottom: 14px; color: var(--color-ink); }
  .pr-media { position: relative; overflow: hidden; background: var(--color-warm); aspect-ratio: 3 / 2; clip-path: inset(var(--clip, 0%)); }
  .pr-media img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(var(--zoom, 1)); transform-origin: 50% 60%; }

  .pr-info { min-width: 0; }
  .pr-name { font-size: var(--text-title); font-variation-settings: "wdth" 112; font-weight: 680; letter-spacing: -0.03em; line-height: 1.02; max-width: 16ch; }
  .pr-status { margin-top: 12px; }
  .pr-desc { margin-top: 18px; max-width: 40ch; color: var(--color-muted); }
  .pr-meta { margin: 28px 0 0; font-size: var(--text-meta); border-top: 1px solid var(--color-ink); }
  .pr-meta div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--color-line); }
  .pr-meta dt { color: var(--color-muted); }
  .pr-meta dd { margin: 0; }
  .pr-detail { margin-top: 32px; max-width: 320px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-warm); }
  .pr-detail img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 1024px) {
    .pr-head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); }
    .pr-title { grid-column: 1 / span 7; }
    .pr-sub { grid-column: 9 / span 4; padding-bottom: 0.6em; }

    .pr { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(24px, 2.6vw, 44px); }
    .pr--left .pr-figure { grid-column: 1 / span 8; }
    .pr--left .pr-info { grid-column: 9 / span 4; padding-top: 20px; }
    .pr--right .pr-figure { grid-column: 5 / span 8; grid-row: 1; }
    .pr--right .pr-info { grid-column: 1 / span 4; grid-row: 1; padding-top: 20px; }
    .pr--full .pr-figure { grid-column: 1 / -1; margin-inline: calc(-1 * var(--gutter)); }
    .pr--full .pr-dim { margin-inline: var(--gutter); }
    .pr--full .pr-media { aspect-ratio: 21 / 9; }
    .pr--full .pr-info {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 2.6vw, 44px);
      align-items: start;
    }
    .pr--full .pr-name { grid-column: 1 / span 5; grid-row: 1; }
    .pr--full .pr-status { grid-column: 1 / span 5; grid-row: 2; }
    .pr--full .pr-desc { grid-column: 6 / span 3; grid-row: 1 / span 2; margin-top: 4px; }
    .pr--full .pr-meta { grid-column: 9 / span 4; grid-row: 1 / span 2; margin-top: 4px; }
  }
  @media (min-width: 1560px) {
    .pr--full .pr-figure { margin-inline: calc((100vw - 1560px) / -2 - var(--gutter)); }
    .pr--full .pr-dim { margin-inline: calc((100vw - 1560px) / 2 + var(--gutter)); }
  }
</style>

<script>
  import { addScene, easeOut, range } from '../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
    const dim = project.querySelector<HTMLElement>('.pr-dim');
    const media = project.querySelector<HTMLElement>('[data-media]');
    if (!dim || !media) return;
    addScene({
      el: media,
      // from the frame's top entering the lower edge until it sits in the upper third
      progress: (rect, vh) => (vh * 1.02 - rect.top) / (vh * 0.75),
      render(p) {
        const measure = easeOut(range(p, 0, 0.4));
        const open = easeOut(range(p, 0.25, 1));
        dim.style.setProperty('--dim-p', measure.toFixed(3));
        dim.style.setProperty('--dim-end', measure > 0.98 ? '1' : '0');
        media.style.setProperty('--clip', `${((1 - open) * 9).toFixed(2)}% ${((1 - open) * 14).toFixed(2)}%`);
        media.style.setProperty('--zoom', (1 + (1 - open) * 0.14).toFixed(4));
      },
    });
  });
</script>
