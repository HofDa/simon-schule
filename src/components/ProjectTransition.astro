---
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale)).projects;
/**
 * The ruler-drawn route and the projects, as one pinned stage (desktop):
 * the line comes down from the chair's leg and turns along the bottom of the
 * screen, revealing "Unsere Projekte". Then the whole plan sheet (line, title
 * and the projects passed in as the slot) slides to the left under a fixed pen
 * tip, so the line keeps drawing to the right beneath each project and then the
 * two contact people. At the end of the row it turns 90° down, towards the next section.
 * Mobile and reduced motion: a U-shaped line with the title, projects stacked below.
 */
---

<section id="projekte" class="transition relative" aria-labelledby="projects-title" data-transition>
  <div class="t-stage relative" data-stage>
    <div class="t-sheet" data-sheet>
      <div class="t-head relative" data-head>
        <svg class="t-svg absolute inset-0 h-full w-full" data-svg aria-hidden="true">
          <path class="t-path" data-path d="" />
          <path class="t-corner" data-corner d="" />
          <circle class="t-node" data-start r="5.5" cx="-20" cy="-20" />
          <circle class="t-head-dot" data-head-dot r="6" cx="-20" cy="-20" />
        </svg>

        <div class="t-title-wrap absolute inset-x-0">
          <div class="shell">
            <h2 id="projects-title" class="t-title" data-title>{t.title}</h2>
          </div>
        </div>
        <div class="t-sub-wrap absolute inset-x-0">
          <div class="shell">
            <p class="t-sub">{t.sub}</p>
          </div>
        </div>
      </div>

      <div class="t-row" data-row>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .t-head { height: 380px; }
  @media (min-width: 1024px) {
    .t-head { height: 440px; }
  }

  /* the drawn route: bold, in the signal colour; ink only for its nodes and the right-angle mark */
  .t-path {
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: var(--leg-w, 4px); /* same thickness as the chair legs */
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }
  .t-corner { fill: none; stroke: var(--color-ink); stroke-width: 1.5; }
  .t-node, .t-head-dot { fill: var(--color-ink); }

  .t-title-wrap { bottom: calc(100% - var(--ym, 300px) + 14px); }
  .t-sub-wrap { top: calc(var(--ym, 300px) + 20px); }
  .t-title {
    display: inline-block;
    font-size: var(--text-route-title);
    line-height: 0.95;
    letter-spacing: -0.045em;
    clip-path: inset(-10% calc((1 - var(--reveal, 1)) * 100%) -20% 0);
    margin-left: var(--title-x, 0px);
  }
  .t-sub {
    max-width: 44ch;
    color: var(--color-muted);
    font-size: var(--text-body);
    margin-left: var(--title-x, 0px);
    opacity: var(--sub, 1);
    transform: translateY(calc((1 - var(--sub, 1)) * 6px));
  }

  /* pinned desktop stage: a wide sheet that slides left */
  .transition.is-scrub .t-stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .transition.is-scrub .t-sheet {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--sheet-w, 300vw);
    transform: translateX(var(--tx, 0px));
    will-change: transform;
  }
  .transition.is-scrub .t-head { position: absolute; inset: 0; height: auto; pointer-events: none; }
  .transition.is-scrub .t-title-wrap,
  .transition.is-scrub .t-sub-wrap { right: auto; width: 100vw; }
  .transition.is-scrub .t-row {
    position: absolute;
    top: var(--row-top, 104px);
    height: var(--row-h, 600px);
    left: var(--row-left, 900px);
  }

  /* the projects as a horizontal row above the line */
  .transition.is-scrub .t-row :global(.projects) { padding: 0; height: 100%; width: max-content; max-width: none; }
  .transition.is-scrub .t-row :global(.projects-inner) {
    flex-direction: row;
    align-items: stretch;
    gap: 120px;
    height: 100%;
    padding: 0;
  }
  /* everything rests on the drawn line like objects on a shelf; images are golden rectangles,
     sized by the height of the stage (nav to line) so the rooms appear at full scale */
  .transition.is-scrub .t-row {
    --img-h: min(var(--row-h, 600px), calc(60vw / 1.618));
    --img-h-full: min(var(--row-h, 600px), calc(66vw / 1.618));
  }
  .transition.is-scrub .t-row :global(.project) {
    flex: none;
    display: flex;
    align-items: flex-end;
    gap: clamp(28px, 2.6vw, 44px);
    height: 100%;
  }
  .transition.is-scrub .t-row :global(.project--right) { flex-direction: row-reverse; }
  .transition.is-scrub .t-row :global(.p-media) { flex: none; height: var(--img-h); aspect-ratio: 1.618 / 1; }
  .transition.is-scrub .t-row :global(.project--full .p-media) { height: var(--img-h-full); }
  .transition.is-scrub .t-row :global(.p-media img) { width: 100%; height: 100%; aspect-ratio: auto; }
  .transition.is-scrub .t-row :global(.p-info) { flex: none; width: min(22rem, 26vw); margin-top: 0; padding-top: 0; }
  .transition.is-scrub .t-row :global(.project--full .p-info) { display: block; }
  .transition.is-scrub .t-row :global(.project--full .p-meta) { margin-top: 28px; }
  .transition.is-scrub .t-row :global(.project--full .p-desc) { margin-top: 22px; }
  .transition.is-scrub .t-row :global(.p-detail) { display: none; }
  /* the row: projects, then the people as the last stop, all resting on the line */
  .transition.is-scrub .t-row { display: flex; align-items: stretch; gap: 180px; }
  .transition.is-scrub .t-row :global(.people) { flex: none; height: 100%; padding: 0; background: transparent; }
  /* the last stop has to fit one screen (minus the line's turn), or the heading is cut off at the end */
  .transition.is-scrub .t-row :global(.people > .shell) {
    display: flex;
    align-items: flex-end;
    gap: min(56px, 4vw);
    height: 100%;
    width: max-content;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .transition.is-scrub .t-row :global(.people-intro) { flex: none; width: min(26rem, 26vw); padding-bottom: 8px; }
  .transition.is-scrub .t-row :global(.people h2) { font-size: var(--text-title); }
  /* heading · the two names stacked · the planning questions */
  .transition.is-scrub .t-row :global(.people-grid) {
    display: flex;
    align-items: flex-end;
    gap: min(56px, 4vw);
    margin-top: 0;
  }
  .transition.is-scrub .t-row :global(.persons) { flex: none; width: min(20rem, 24vw); padding-bottom: 8px; }
  .transition.is-scrub .t-row :global(.persons-list) { grid-template-columns: 1fr; row-gap: 28px; }
  .transition.is-scrub .t-row :global(.notes) { flex: none; width: min(240px, 17vw); padding-bottom: 12px; }
  .transition.is-scrub .t-row :global(.notes ul) { gap: 26px; }

  .transition.is-scrub .t-row :global(.p-quote) { flex: none; width: min(520px, 38vw); align-self: end; margin-left: 0; }
</style>

<script>
  import { addScene, clamp, range } from '../scripts/motion';

  const DESKTOP = '(min-width: 1024px) and (min-height: 640px)';
  const section = document.querySelector<HTMLElement>('[data-transition]');
  const sheet = section?.querySelector<HTMLElement>('[data-sheet]');
  const headBox = section?.querySelector<HTMLElement>('[data-head]');
  const svg = section?.querySelector<SVGSVGElement>('[data-svg]');
  const path = section?.querySelector<SVGPathElement>('[data-path]');
  const corner = section?.querySelector<SVGPathElement>('[data-corner]');
  const dot = section?.querySelector<SVGCircleElement>('[data-head-dot]');
  const start = section?.querySelector<SVGCircleElement>('[data-start]');
  const title = section?.querySelector<HTMLElement>('[data-title]');
  const row = section?.querySelector<HTMLElement>('[data-row]');

  if (section && sheet && headBox && svg && path && corner && dot && start && title && row) {
    let total = 1;
    let x0 = 0;
    let ym = 0;
    let bendAt = 1; // path length where the final upward bend starts
    let titleLeft = 0;
    let titleW = 1;
    let pinned = false;
    // desktop scroll budget (px)
    let lead = 0; // the line starts drawing while the stage scrolls in
    let A = 1; // draw down and along the bottom up to the pen position
    let B = 1; // slide the sheet (1:1 with scroll)
    let C = 1; // finish the line and the upward bend
    let span = 1;
    let lenA = 0; // path length when the pen reaches its fixed position
    let travel = 0; // how far the sheet slides

    // half the route's stroke width, so the right-angle mark sits inside the corner
    const half = () => (parseFloat(getComputedStyle(path).strokeWidth) || 4) / 2;

    const measure = (scrub: boolean) => {
      pinned = scrub;
      section.classList.toggle('is-scrub', scrub);
      section.style.height = '';
      sheet.style.removeProperty('--tx');

      const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
      const pad = parseFloat(getComputedStyle(title.parentElement as HTMLElement).paddingLeft);
      const vw = document.documentElement.clientWidth;
      const leg = document.querySelector<HTMLElement>('[data-axis]')?.getBoundingClientRect();
      x0 = leg && leg.width ? leg.left + leg.width / 2 : pad;

      if (!scrub) {
        // static: U-shaped line across the section, title centred on desktop
        const w = headBox.clientWidth;
        const h = headBox.clientHeight;
        const x1 = w - pad - 2;
        ym = h - 80;
        svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
        section.style.setProperty('--ym', `${ym}px`);
        const tw = title.offsetWidth;
        const titleX = isDesktop ? Math.max(0, (w - tw) / 2 - pad) : 0;
        section.style.setProperty('--title-x', `${titleX}px`);
        titleLeft = pad + titleX;
        titleW = tw;
        path.setAttribute('d', `M${x0} 0 V${ym} H${x1} V${h}`);
        total = path.getTotalLength();
        bendAt = ym + (x1 - x0);
        path.style.strokeDasharray = `${total}`;
        const c = 16;
        const o = half();
        corner.setAttribute('d', `M${x1 - o - c} ${ym + o} V${ym + o + c} H${x1 - o}`);
        start.setAttribute('cx', String(x0));
        start.setAttribute('cy', String(ym));
        return;
      }

      // pinned: one long sheet; title at its start, projects to the right
      const vh = window.innerHeight;
      const navH = 72;
      ym = Math.round(vh - Math.max(96, vh * 0.12));
      section.style.setProperty('--ym', `${ym}px`);
      const titleX = x0 + 40 - pad;
      section.style.setProperty('--title-x', `${titleX}px`);
      titleW = title.offsetWidth;
      titleLeft = title.getBoundingClientRect().left - sheet.getBoundingClientRect().left;

      const rowTop = navH + 32;
      const rowLeft = Math.round(titleLeft + titleW + 120);
      section.style.setProperty('--row-top', `${rowTop}px`);
      section.style.setProperty('--row-h', `${ym - 44 - rowTop}px`);
      section.style.setProperty('--row-left', `${rowLeft}px`);
      const rowW = row.scrollWidth;
      const endX = rowLeft + rowW + 60; // the line ends just past the last project
      const sheetW = Math.max(vw, endX + pad + 40);
      section.style.setProperty('--sheet-w', `${sheetW}px`);

      svg.setAttribute('viewBox', `0 0 ${sheetW} ${vh}`);
      // after the last project the line turns down and leaves the stage towards the next section
      path.setAttribute('d', `M${x0} 0 V${ym} H${endX} V${vh}`);
      total = path.getTotalLength();
      bendAt = ym + (endX - x0);
      path.style.strokeDasharray = `${total}`;
      const c = 16;
      const o = half();
      corner.setAttribute('d', `M${endX - o - c} ${ym + o} V${ym + o + c} H${endX - o}`);
      start.setAttribute('cx', String(x0));
      start.setAttribute('cy', String(ym));

      const penX = vw * 0.62; // where the pen tip stays while the sheet slides
      travel = Math.max(0, sheetW - vw);
      lenA = ym + (penX - x0);
      lead = vh; // drawing starts the moment the stage enters at the bottom of the screen
      A = lead + vh * 0.6;
      B = travel;
      C = vh * 0.35;
      span = A + B + C + vh * 0.1;
      section.style.height = `${vh + span - lead}px`;
    };

    const draw = (len: number) => {
      path.style.strokeDashoffset = String(total - len);
      const pt = path.getPointAtLength(len);
      dot.setAttribute('cx', String(pt.x));
      dot.setAttribute('cy', String(pt.y));
      dot.style.opacity = len > 1 && len < total - 1 ? '1' : '0';
      start.style.opacity = len >= ym ? '1' : '0';
      corner.style.opacity = len >= bendAt + 18 ? '1' : '0';
      const headX = len <= ym ? x0 : x0 + (len - ym);
      section.style.setProperty('--reveal', String(len > ym ? clamp((headX - titleLeft) / titleW) : 0));
      section.style.setProperty('--sub', String(range(headX, titleLeft + titleW * 0.6, titleLeft + titleW + 200)));
    };

    addScene({
      el: section,
      media: DESKTOP,
      measure: (active) => {
        if (active || window.matchMedia(DESKTOP).matches) measure(active);
      },
      progress: (rect, vh) => (vh - rect.top) / span,
      render: (p) => {
        if (!pinned) {
          if (window.matchMedia(DESKTOP).matches) draw(total);
          return;
        }
        const s = p * span;
        let len: number;
        let tx = 0;
        if (s < A) {
          // down segment 1:1 with the scroll (its tip stays at the screen's bottom edge), then across
          len = s <= ym ? s : ym + ((s - ym) / (A - ym)) * (lenA - ym);
        } else if (s < A + B) {
          tx = s - A;
          len = lenA + tx; // the pen stays put while the sheet moves under it
        } else {
          tx = travel;
          len = lenA + travel + clamp((s - A - B) / C) * (total - lenA - travel);
        }
        sheet.style.setProperty('--tx', `${(-tx).toFixed(1)}px`);
        draw(Math.min(total, len));
      },
    });

    // Links to anchors inside the sliding sheet (e.g. #menschen): scroll to where the sheet shows them.
    document.addEventListener('click', (event) => {
      if (!pinned) return;
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      const id = link?.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target || target === section || !sheet.contains(target)) return;
      event.preventDefault();
      const pad = parseFloat(getComputedStyle(title.parentElement as HTMLElement).paddingLeft);
      const x = target.getBoundingClientRect().left - sheet.getBoundingClientRect().left;
      const s = A + clamp((x - pad) / Math.max(1, travel)) * travel;
      const docTop = section.getBoundingClientRect().top + window.scrollY;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: docTop - window.innerHeight + s, behavior: reduced ? 'auto' : 'smooth' });
    });

    addScene({
      el: headBox,
      media: '(max-width: 1023px), (max-height: 639px)',
      measure: (active) => {
        if (active || !window.matchMedia(DESKTOP).matches) measure(false);
      },
      // runs slightly ahead of the scroll, so the line is drawn wherever it is on screen
      progress: (rect, vh) => ((vh - rect.top) * 1.6) / Math.max(1, total),
      render: (p) => {
        if (!window.matchMedia(DESKTOP).matches) draw(total * p);
      },
    });
  }
</script>
