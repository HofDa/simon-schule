---
/**
 * The ruler-drawn route and the projects, as one pinned stage (desktop):
 * the line comes down from the chair's leg, runs along the bottom of the
 * screen revealing "Unsere Projekte", then climbs the right edge. While it
 * climbs, the projects (passed in as the slot) travel down through the frame
 * the line draws, so scrolling on feels like moving up the plan.
 * Mobile and reduced motion: the U-shaped line with the title, projects below.
 */
---

<section id="projekte" class="transition relative" aria-labelledby="projects-title" data-transition>
  <div class="t-stage relative" data-stage>
    <div class="t-head relative" data-head>
      <svg class="t-svg absolute inset-0 h-full w-full" data-svg aria-hidden="true">
        <path class="t-path" data-path d="" />
        <path class="t-corner" data-corner d="" />
        <circle class="t-node" data-start r="5.5" cx="-20" cy="-20" />
        <circle class="t-head-dot" data-head-dot r="6" cx="-20" cy="-20" />
      </svg>

      <div class="t-title-wrap absolute inset-x-0">
        <div class="shell">
          <h2 id="projects-title" class="t-title" data-title>Unsere Projekte</h2>
        </div>
      </div>
      <div class="t-sub-wrap absolute inset-x-0">
        <div class="shell">
          <p class="t-sub">Schulen und Kindergärten in Südtirol – geplant, eingerichtet und begleitet von Trias Schule.</p>
        </div>
      </div>
    </div>

    <div class="t-window" data-window>
      <div class="t-track" data-track>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .t-head { height: 380px; }
  @media (min-width: 1024px) {
    .t-head { height: 440px; }
  }

  /* the drawn route: bold, in the signal colour; ink only for its nodes and the right-angle mark */
  .t-path {
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: 4;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }
  .t-corner { fill: none; stroke: var(--color-ink); stroke-width: 1.5; }
  .t-node, .t-head-dot { fill: var(--color-ink); }

  .t-title-wrap { bottom: calc(100% - var(--ym, 300px) + 14px); }
  .t-sub-wrap { top: calc(var(--ym, 300px) + 20px); }
  .t-title {
    display: inline-block;
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    clip-path: inset(-10% calc((1 - var(--reveal, 1)) * 100%) -20% 0);
    margin-left: var(--title-x, 0px);
  }
  .t-sub {
    max-width: 44ch;
    color: var(--color-muted);
    font-size: 1.02rem;
    margin-left: var(--title-x, 0px);
    opacity: var(--sub, 1);
    transform: translateY(calc((1 - var(--sub, 1)) * 6px));
  }

  /* pinned desktop stage */
  .transition.is-scrub .t-stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .transition.is-scrub .t-head { position: absolute; inset: 0; height: auto; z-index: 2; pointer-events: none; }
  .transition.is-scrub .t-head .t-title-wrap,
  .transition.is-scrub .t-head .t-sub-wrap { pointer-events: auto; }
  .transition.is-scrub .t-window {
    position: absolute;
    top: var(--win-top, 88px);
    bottom: var(--win-bottom, 300px);
    left: var(--win-left, 80px);
    right: var(--win-right, 80px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 28px, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(transparent, #000 28px, #000 calc(100% - 28px), transparent);
  }
  .transition.is-scrub .t-track {
    position: absolute;
    inset: 0 0 auto 0;
    transform: translateY(var(--ty, 0px));
    will-change: transform;
  }
  /* first project enters first from the top, so the list runs bottom-up */
  .transition.is-scrub .t-track :global(.projects) { padding: 0; }
  .transition.is-scrub .t-track :global(.projects-inner) { flex-direction: column-reverse; gap: 120px; padding: 0; }
  .transition.is-scrub .t-track :global(.p-media img) { aspect-ratio: 16 / 10; }
  .transition.is-scrub .t-track :global(.project--full .p-media img) { aspect-ratio: 21 / 9; }
</style>

<script>
  import { addScene, clamp, range, viewProgress } from '../scripts/motion';

  const DESKTOP = '(min-width: 1024px) and (min-height: 640px)';
  const section = document.querySelector<HTMLElement>('[data-transition]');
  const stage = section?.querySelector<HTMLElement>('[data-stage]');
  const headBox = section?.querySelector<HTMLElement>('[data-head]');
  const svg = section?.querySelector<SVGSVGElement>('[data-svg]');
  const path = section?.querySelector<SVGPathElement>('[data-path]');
  const corner = section?.querySelector<SVGPathElement>('[data-corner]');
  const dot = section?.querySelector<SVGCircleElement>('[data-head-dot]');
  const start = section?.querySelector<SVGCircleElement>('[data-start]');
  const title = section?.querySelector<HTMLElement>('[data-title]');
  const track = section?.querySelector<HTMLElement>('[data-track]');

  if (section && stage && headBox && svg && path && corner && dot && start && title && track) {
    let total = 1;
    let x0 = 0;
    let x1 = 0;
    let ym = 0;
    let across = 1; // length of the down + across part of the route
    let titleLeft = 0;
    let titleW = 1;
    let pinned = false;
    // desktop scroll budget (px): approach + draw along the bottom (A), climb with the projects (B), short hold
    let A = 1;
    let B = 1;
    let trackH = 0;
    let tyEnd = 0;
    let lead = 0;
    let span = 1;

    const measure = (scrub: boolean) => {
      pinned = scrub;
      section.classList.toggle('is-scrub', scrub);
      section.style.height = '';

      const w = headBox.clientWidth;
      const h = headBox.clientHeight;
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      const pad = parseFloat(getComputedStyle(title.parentElement as HTMLElement).paddingLeft);
      const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
      const leg = document.querySelector<HTMLElement>('[data-axis]')?.getBoundingClientRect();
      const box = headBox.getBoundingClientRect();

      x0 = isDesktop && leg && leg.width ? leg.left + leg.width / 2 - box.left : pad;
      x1 = w - pad - 2; // full width, so the title is always completely revealed
      ym = scrub ? Math.round(h - Math.max(96, h * 0.12)) : h - 80;
      section.style.setProperty('--ym', `${ym}px`);

      const tw = title.offsetWidth;
      const titleX = isDesktop ? Math.max(0, (w - tw) / 2 - pad) : 0;
      section.style.setProperty('--title-x', `${titleX}px`);
      titleLeft = pad + titleX;
      titleW = tw;

      // down from the leg, along the bottom, up the right edge
      path.setAttribute('d', `M${x0} 0 V${ym} H${x1} V0`);
      total = path.getTotalLength();
      across = ym + (x1 - x0);
      path.style.strokeDasharray = `${total}`;
      const c = 16;
      const o = 2; // half the route's stroke width
      corner.setAttribute('d', `M${x1 - o - c} ${ym - o} V${ym - o - c} H${x1 - o}`);
      start.setAttribute('cx', String(x0));
      start.setAttribute('cy', String(ym));

      if (!scrub) return;
      // the window the projects travel through: inside the frame, above the title
      const vh = window.innerHeight;
      const navH = 72;
      const titleTop = ym - 14 - title.offsetHeight;
      section.style.setProperty('--win-top', `${navH + 16}px`);
      section.style.setProperty('--win-bottom', `${h - titleTop + 28}px`);
      section.style.setProperty('--win-left', `${x0 + 40}px`);
      section.style.setProperty('--win-right', `${w - x1 + 40}px`);
      trackH = track.offsetHeight;
      // travel ends when the last project (drawn at the top of the reversed list) sits fully in the window
      const winH = titleTop - 28 - (navH + 16);
      const lastItem = track.querySelector<HTMLElement>('.projects-inner')?.lastElementChild as HTMLElement | null;
      tyEnd = Math.min(0, winH - (lastItem?.offsetHeight ?? 0));
      lead = vh * 0.55; // the line starts drawing while the stage scrolls in
      A = lead + vh * 0.9;
      B = trackH + tyEnd;
      span = A + B + vh * 0.15;
      section.style.height = `${vh + span - lead}px`;
    };

    const draw = (len: number) => {
      path.style.strokeDashoffset = String(total - len);
      const pt = path.getPointAtLength(len);
      dot.setAttribute('cx', String(pt.x));
      dot.setAttribute('cy', String(pt.y));
      dot.style.opacity = len > 1 && len < total - 1 ? '1' : '0';
      start.style.opacity = len >= ym ? '1' : '0';
      corner.style.opacity = len >= across + 18 ? '1' : '0';
      const headX = len <= ym ? x0 : Math.min(x1, x0 + (len - ym));
      section.style.setProperty('--reveal', String(len > ym ? clamp((headX - titleLeft) / titleW) : 0));
      section.style.setProperty('--sub', String(range(headX, titleLeft + titleW * 0.6, x1)));
    };

    addScene({
      el: section,
      media: DESKTOP,
      measure: (active) => {
        if (active || window.matchMedia(DESKTOP).matches) measure(active);
      },
      progress: (rect, vh) => (vh * 0.55 - rect.top) / span,
      render: (p) => {
        if (!pinned) {
          if (window.matchMedia(DESKTOP).matches) draw(total);
          return;
        }
        const s = p * span;
        const a = clamp(s / A);
        const b = clamp((s - A) / B);
        draw(a < 1 ? a * across : across + b * ym);
        // projects come down from above while the line climbs
        track.style.setProperty('--ty', `${(-trackH + b * (trackH + tyEnd)).toFixed(1)}px`);
      },
    });

    addScene({
      el: headBox,
      media: '(max-width: 1023px), (max-height: 639px)',
      measure: (active) => {
        if (active || !window.matchMedia(DESKTOP).matches) measure(false);
      },
      progress: viewProgress(0.95, 0.15),
      render: (p) => {
        if (!window.matchMedia(DESKTOP).matches) draw(total * p);
      },
    });
  }
</script>
