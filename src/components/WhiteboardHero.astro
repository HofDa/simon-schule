---
import { getProjects } from '../data/projects';
import { getLang, useTranslations } from '../i18n/ui';
import { letter } from '../lib/lettering';
import ProjectPhoto from './ProjectPhoto.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const [a, b, c] = getProjects(lang);

// The claim is hand-lettered: each word is drawn as pen strokes (src/lib/lettering.ts) at one
// constant pen speed with short lifts between strokes, so the whole line takes about WRITE
// seconds in any language and stays one quick marker gesture.
const headline = t.hero.headline;
const lettering = letter(headline);
const SCALE = 1.1; // the single-line font sits small in its em box
const PAD = 60; // font units around each word, so round stroke ends are not clipped
const top = lettering.top - PAD;
const height = lettering.bottom - lettering.top + 2 * PAD;
const em = (units: number) => `${((units / 1000) * SCALE).toFixed(3)}em`;
const WRITE = 0.85;
const LIFT = 0.012;
const WORD_LIFT = 0.05;
const strokeCount = lettering.words.reduce((n, w) => n + w.strokes.length, 0);
const penLength = lettering.words.reduce((n, w) => n + w.strokes.reduce((m, s) => m + s.length, 0), 0);
const speed = penLength / (WRITE - LIFT * (strokeCount - 1) - WORD_LIFT * (lettering.words.length - 1));
let clock = 0;
const words = lettering.words.map((word) => {
  const strokes = word.strokes.map((stroke) => {
    const dur = Math.max(0.02, stroke.length / speed);
    const out = { d: stroke.d, delay: clock.toFixed(3), dur: dur.toFixed(3) };
    clock += dur + LIFT;
    return out;
  });
  clock += WORD_LIFT - LIFT;
  return { width: word.width, strokes };
});
const writeDuration = (clock - WORD_LIFT).toFixed(2);
const LINE = 1.06; // baseline to baseline, in em: each word's box is trimmed to this height
// the last line's descenders hang below the trimmed box; keep them clear of the subline
const DESCENDERS = `calc(${em(height)} - ${LINE}em - ${em(PAD)})`;
---

<Fragment set:html={`<style>:root{--hero-write:${writeDuration}s}</style>`} />
<section id="top" class="hero relative pt-[calc(var(--nav-h)+8px)]" aria-labelledby="hero-title">
  <div class="shell">
    <div class="board relative">
      <div class="board-surface relative h-full">
        <!-- sketch layer (desktop) -->
        <svg class="sketch pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
          <g class="ink-lines" fill="none" stroke="#20201D" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
            <path class="draw" style="--d: 1.05s" pathLength="1" d="M560 50 C585 46 598 64 602 98" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.2s" pathLength="1" d="M595 92 L602 100 L609 92" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.1s" pathLength="1" d="M648 386 C656 392 660 404 662 416" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.25s" pathLength="1" d="M655 410 L662 418 L668 409" vector-effect="non-scaling-stroke" />
            <path class="draw dashed" style="--d: 1.15s" pathLength="1" d="M562 390 C562 402 560 414 558 428" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.3s" pathLength="1" d="M830 224 C850 220 880 222 902 220" vector-effect="non-scaling-stroke" />
          </g>
          <!-- floor-plan sketch -->
          <g class="plan" fill="none" stroke="#20201D" stroke-linecap="round" vector-effect="non-scaling-stroke">
            <path class="draw" style="--d: 0.95s" pathLength="1" stroke-width="2" d="M510 432 H610 V516 H510 Z" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.1s" pathLength="1" stroke-width="1.2" d="M524 446 h18 v10 h-18 Z M552 446 h18 v10 h-18 Z M580 446 h18 v10 h-18 Z M524 480 h26 v14 h-26 Z M566 480 h32 v14 h-32 Z" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.25s" pathLength="1" stroke-width="1.2" d="M510 532 H610 M510 527 V537 M610 527 V537" vector-effect="non-scaling-stroke" />
          </g>
        </svg>

        <div class="relative grid h-full lg:block">
          <!-- copy -->
          <div class="hero-copy relative z-10 pt-10 pb-8 lg:absolute lg:left-0 lg:top-0 lg:w-[38.2%] lg:pt-[calc(var(--board-h)*0.146)]">
            <h1 id="hero-title" class="hero-title">
              <span class="sr-only">{headline}</span>
              <span class="handwriting" aria-hidden="true" style={`--base: ${em(lettering.baseline - top)}; padding-bottom: ${DESCENDERS}`}>
                {words.map((word, wi) => (
                  <>
                    <span class={`word${wi === words.length - 1 ? ' word-last' : ''}`}>
                      <svg
                        class="lettering"
                        viewBox={`${-PAD} ${top} ${word.width + 2 * PAD} ${height}`}
                        style={`width: ${em(word.width + 2 * PAD)}; height: ${em(height)}; margin-bottom: calc(${LINE}em - ${em(height)})`}
                      >
                        {word.strokes.map((s) => <path d={s.d} pathLength="1" style={`--sd: ${s.delay}s; --sdur: ${s.dur}s`} />)}
                      </svg>
                      {wi === words.length - 1 && (
                        <svg class="hand-underline" viewBox="0 0 300 16" preserveAspectRatio="none">
                          <path pathLength="1" d="M4 10 C60 5 130 12 190 8 S270 6 296 9" />
                        </svg>
                      )}
                    </span>{' '}
                  </>
                ))}
              </span>
            </h1>
            <p class="rise mt-7 max-w-[38ch] text-body leading-[1.6] text-muted sm:text-lead" style="--d: 0s">
              {t.hero.sub}
            </p>
            <div class="rise mt-9 flex flex-wrap items-center gap-x-7 gap-y-4" style="--d: 0.08s">
              <a href="#projekte" class="btn btn-ink">
                {t.hero.primary}
                <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4" /></svg>
              </a>
              <a href="#anfrage" class="link-line text-meta font-semibold" data-open-form>{t.hero.secondary}</a>
            </div>
          </div>

          <!-- pinned photos -->
          <div class="pins relative mb-[calc(var(--chair-peek)+20px)] h-[min(78vw,520px)] lg:absolute lg:inset-0 lg:m-0 lg:h-auto">
            <ProjectPhoto project={a} class="pin-a" sizes="(min-width: 1024px) 33vw, 62vw" priority />
            <ProjectPhoto project={b} class="pin-b" sizes="(min-width: 1024px) 13vw, 48vw" />
            <ProjectPhoto project={c} class="pin-c hidden lg:block" sizes="21vw" />

            <span class="note note-flex marker" style="--d: 0.95s">{t.hero.notes.flex}</span>
            <span class="note note-akustik marker hidden lg:block" style="--d: 1.1s">{t.hero.notes.acoustics}</span>
            <span class="note note-gruppe marker hidden lg:block" style="--d: 1.2s">{t.hero.notes.groups}</span>
            <span class="note note-dim marker hidden lg:block" style="--d: 1.3s">7,20 m</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .board {
    --board-h: clamp(600px, calc(100svh - var(--nav-h) - 30px), 1000px);
  }
  @media (min-width: 1024px) {
    .board {
      height: var(--board-h);
      /* the prints and their sketch are composed for a board of about golden proportions: on wide,
         short screens they keep that shape, anchored right, instead of stretching into each other */
      --frame-w: min(100%, calc(var(--board-h) * 1.66));
    }
    .sketch,
    .pins { left: auto; right: 0; width: var(--frame-w); }
  }

  .dashed { stroke-dasharray: 0.02 0.025; }

  .note {
    position: absolute;
    z-index: 3;
    color: #2b2b27;
    font-size: var(--text-marker);
    white-space: nowrap;
  }
  .note-flex { left: 52%; top: -2%; transform: rotate(-3deg); }
  @media (min-width: 1024px) {
    .note-flex { left: 47%; top: 6%; }
    .note-akustik { left: 83%; top: 31%; transform: rotate(2deg); }
    .note-gruppe { right: 35.5%; top: 61.5%; transform: rotate(-2deg); } /* right-anchored: ends at its arrow in any language */
    .note-dim { left: 53%; top: 90.5%; font-size: var(--text-lead); }
  }

  /* pins: mobile */
  .pins :global(.pin-a) { left: 0; top: 10%; width: 64%; transform: rotate(-1.5deg); }
  .pins :global(.pin-b) { right: 0; top: 46%; width: 48%; transform: rotate(2deg); }
  @media (min-width: 1024px) {
    /* Golden grid (φ ≈ 1.618). The board is close to a golden rectangle.
       A (33%) is centred on the golden point 61.8% / 38.2%; C = A/φ sits on 76.4% / 76.4%;
       B = C/φ sits top right. The text column is 38.2% wide; the chair rests below it on the same left edge. */
    .pins :global(.pin-a) { left: 45.3%; top: 17.7%; width: 33%; transform: rotate(-1.2deg); }
    .pins :global(.pin-b) { left: 81.9%; right: auto; top: 6.8%; width: 12.6%; transform: rotate(2.5deg); }
    .pins :global(.pin-c) { left: 66.2%; top: 63.7%; width: 20.4%; transform: rotate(1.2deg); }
  }

  /* Board preparation, about a second in all: the claim is written while the offer is already readable
     and the prints are pinned up; the annotations follow, the chair (ServicesStory) comes last.
     Defined on :root so the chair in the next section shares the timeline. */
  :global(:root) {
    --t-claim: 0.1s;
    --t-after: calc(var(--t-claim) + var(--hero-write, 0.85s)); /* end of the writing: the underline */
    --t-offer: 0.12s; /* subline and buttons, readable within ~0.3s */
    --t-images: 0.35s;
    --t-notes: -0.2s; /* added to each note's own --d (0.95–1.3s): annotations draw from 0.75s */
    --t-chair: 0.9s;
  }

  .hero-title {
    font-family: var(--font-marker);
    font-weight: 700;
    font-size: clamp(3.4rem, min(6.4vw, 11vh), 6.8rem);
    line-height: 0.86;
    letter-spacing: 0;
    color: var(--color-ink);
  }
  .handwriting { display: block; transform: rotate(-1.5deg); transform-origin: 0 100%; }
  .word { display: inline-block; white-space: nowrap; position: relative; }
  /* one word = pen strokes of a single-line marker hand (see src/lib/lettering.ts) */
  .lettering {
    display: inline-block;
    vertical-align: top;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 58;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hand-underline {
    position: absolute;
    left: -2%;
    top: calc(var(--base) + 0.03em);
    width: 100%;
    height: 0.16em;
    overflow: visible;
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rise {
      animation: hero-rise 600ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 0s) + var(--t-offer));
    }
    /* the claim is written stroke by stroke, in the pen's own order and at its own pace */
    :global(html.js) .lettering path {
      stroke-dasharray: 1;
      animation: pen var(--sdur) cubic-bezier(0.3, 0, 0.7, 1) both;
      animation-delay: calc(var(--t-claim) + var(--sd));
    }
    :global(html.js) .hand-underline path {
      animation: underline 650ms var(--ease-draw) both;
      animation-delay: calc(var(--t-after) - 0.05s);
    }
    .pins :global(.pin-a) { --pin-d: var(--t-images); }
    .pins :global(.pin-b) { --pin-d: calc(var(--t-images) + 0.1s); }
    .pins :global(.pin-c) { --pin-d: calc(var(--t-images) + 0.2s); }
    :global(html.js) .pins :global(.pin) {
      animation: pin-in 600ms var(--ease-draw) both;
      animation-delay: var(--pin-d, 0.35s);
    }
    :global(html.js) .pins :global(.magnet) {
      animation: magnet-in 320ms var(--ease-draw) both;
      animation-delay: calc(var(--pin-d, 0.35s) + 0.3s);
    }
    :global(html.js) .note {
      animation: note-in 500ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
    }
    :global(html.js) .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 500ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
    }
    :global(html.js) .draw.dashed {
      stroke-dasharray: 0.02 0.025;
      stroke-dashoffset: 0;
      animation: fade 400ms ease forwards;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
      opacity: 0;
    }
  }

  /* hidden until its turn: a zero-length dash would otherwise show as a dot under the round cap */
  @keyframes pen {
    from { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes underline {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pin-in {
    from { opacity: 0; translate: 0 8px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes magnet-in {
    from { opacity: 0; scale: 0.6; }
    to { opacity: 1; scale: 1; }
  }
  @keyframes note-in {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  /* Hidden until its turn: dash rounding on non-scaling strokes would otherwise leave visible fragments. */
  @keyframes draw {
    from { stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes fade { to { opacity: 1; } }
</style>
