---
import { projects } from '../data/projects';
import ProjectPhoto from './ProjectPhoto.astro';

const [a, b, c] = projects;

// The headline is written letter by letter. Delays are computed here so the
// pacing is slightly uneven (like a hand) but identical on every load.
const headline = 'Lernräume für Südtirol.';
const PER_LETTER = 0.068;
const WORD_GAP = 0.2;
let clock = 0;
const words = headline.split(' ').map((word, wi) => {
  const letters = [...word].map((char, ci) => {
    const delay = clock;
    clock += PER_LETTER + (((wi * 7 + ci * 13) % 5) - 2) * 0.012;
    return { char, delay: delay.toFixed(3) };
  });
  clock += WORD_GAP;
  return letters;
});
const writeDuration = (clock - WORD_GAP + 0.15).toFixed(2);
---

<section id="top" class="hero relative pt-[calc(var(--nav-h)+8px)]" aria-labelledby="hero-title" style={`--write: ${writeDuration}s`}>
  <div class="shell">
    <div class="board relative">
      <div class="board-surface relative h-full">
        <!-- sketch layer (desktop) -->
        <svg class="sketch pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
          <g class="ink-lines" fill="none" stroke="#20201D" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
            <path class="draw" style="--d: 1.05s" pathLength="1" d="M662 27 C694 22 716 34 728 52" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.2s" pathLength="1" d="M720 45 L728 53 L735 43" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.1s" pathLength="1" d="M566 432 C586 432 600 420 612 404" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.25s" pathLength="1" d="M602 406 L612 403 L613 414" vector-effect="non-scaling-stroke" />
            <path class="draw dashed" style="--d: 1.15s" pathLength="1" d="M660 300 C672 316 690 322 706 330" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.3s" pathLength="1" d="M846 64 C866 60 890 62 910 60" vector-effect="non-scaling-stroke" />
          </g>
          <!-- floor-plan sketch -->
          <g class="plan" fill="none" stroke="#20201D" stroke-linecap="round" vector-effect="non-scaling-stroke">
            <path class="draw" style="--d: 0.95s" pathLength="1" stroke-width="2" d="M866 372 H972 V452 H866 Z" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.1s" pathLength="1" stroke-width="1.2" d="M882 386 h18 v10 h-18 Z M912 386 h18 v10 h-18 Z M942 386 h18 v10 h-18 Z M882 418 h26 v14 h-26 Z M926 418 h34 v14 h-34 Z" vector-effect="non-scaling-stroke" />
            <path class="draw" style="--d: 1.25s" pathLength="1" stroke-width="1.2" d="M866 466 H972 M866 461 V471 M972 461 V471" vector-effect="non-scaling-stroke" />
          </g>
        </svg>

        <div class="relative grid h-full lg:block">
          <!-- copy -->
          <div class="hero-copy relative z-10 pt-10 pb-8 lg:absolute lg:left-0 lg:top-0 lg:w-[44%] lg:pt-[clamp(40px,8vh,88px)]">
            <h1 id="hero-title" class="hero-title">
              <span class="sr-only">{headline}</span>
              <span class="handwriting" aria-hidden="true">
                {words.map((letters, wi) => (
                  <>
                    <span class={`word${wi === words.length - 1 ? ' word-last' : ''}`}>
                      {letters.map((l) => <span class="ch" style={`--cd: ${l.delay}s`}>{l.char}</span>)}
                      {wi === words.length - 1 && (
                        <svg class="hand-underline" viewBox="0 0 300 16" preserveAspectRatio="none">
                          <path pathLength="1" d="M4 10 C60 5 130 12 190 8 S270 6 296 9" />
                        </svg>
                      )}
                    </span>{' '}
                  </>
                ))}
              </span>
            </h1>
            <p class="rise mt-7 max-w-[38ch] text-[1.05rem] leading-[1.6] text-muted sm:text-[1.12rem]" style="--d: 0s">
              Trias Schule plant und realisiert Lernräume für Schulen und Kindergärten – persönlich begleitet und mit Einrichtungslösungen von VS Möbel.
            </p>
            <div class="rise mt-9 flex flex-wrap items-center gap-x-7 gap-y-4" style="--d: 0.15s">
              <a href="#projekte" class="btn btn-ink">
                Projekte entdecken
                <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4" /></svg>
              </a>
              <a href="#anfrage" class="link-line text-[0.95rem] font-semibold" data-open-form>Projekt besprechen</a>
            </div>
          </div>

          <!-- pinned photos -->
          <div class="pins relative mb-10 h-[min(78vw,520px)] lg:absolute lg:inset-0 lg:m-0 lg:h-auto">
            <ProjectPhoto project={a} class="pin-a" sizes="(min-width: 1024px) 31vw, 62vw" priority />
            <ProjectPhoto project={b} class="pin-b" sizes="(min-width: 1024px) 16vw, 48vw" />
            <ProjectPhoto project={c} class="pin-c hidden lg:block" sizes="22vw" />

            <span class="note note-flex marker" style="--d: 0.95s">Flexibilität</span>
            <span class="note note-akustik marker hidden lg:block" style="--d: 1.1s">Akustik?</span>
            <span class="note note-gruppe marker hidden lg:block" style="--d: 1.2s">Gruppenarbeit</span>
            <span class="note note-dim marker hidden lg:block" style="--d: 1.3s">7,20 m</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .board {
    --board-h: clamp(600px, calc(100svh - var(--nav-h) - 30px), 1000px);
  }
  @media (min-width: 1024px) {
    .board { height: var(--board-h); }
  }

  .dashed { stroke-dasharray: 0.02 0.025; }

  .note {
    position: absolute;
    z-index: 3;
    color: #2b2b27;
    font-size: clamp(1.35rem, 1.8vw, 1.9rem);
    white-space: nowrap;
  }
  .note-flex { left: 52%; top: -2%; transform: rotate(-3deg); }
  @media (min-width: 1024px) {
    .note-flex { left: 56%; top: 2.2%; }
    .note-akustik { left: 84.6%; top: 6.4%; transform: rotate(2deg); }
    .note-gruppe { left: 44.5%; top: 68.5%; transform: rotate(-2deg); }
    .note-dim { left: 88.6%; top: 78.6%; font-size: 1.25rem; }
  }

  /* pins: mobile */
  .pins :global(.pin-a) { left: 0; top: 10%; width: 64%; transform: rotate(-1.5deg); }
  .pins :global(.pin-b) { right: 0; top: 46%; width: 48%; transform: rotate(2deg); }
  @media (min-width: 1024px) {
    .pins :global(.pin-a) { left: 47%; top: 9%; width: 31%; }
    .pins :global(.pin-b) { left: auto; right: 3.8%; top: 16%; width: 15.5%; }
    .pins :global(.pin-c) { left: 61.5%; top: 55%; width: 22%; transform: rotate(1deg); }
  }

  /* Attention sequence: chair (in ServicesStory) → wordmark and handwritten claim → subline → projects → annotations */
  .hero {
    --t-claim: 0.85s;
    --t-after: calc(var(--t-claim) + var(--write)); /* --write is set from the headline length */
    --t-images: calc(var(--t-after) + 0.35s);
    --t-notes: calc(var(--t-images) - 0.2s); /* added to each note's own --d (0.95–1.3s) */
  }

  .hero-title {
    font-family: var(--font-marker);
    font-weight: 700;
    font-size: clamp(3.6rem, min(8.6vw, 13vh), 7.6rem);
    line-height: 0.86;
    letter-spacing: 0;
    color: var(--color-ink);
  }
  .handwriting { display: block; transform: rotate(-1.5deg); transform-origin: 0 100%; }
  .word { display: inline-block; white-space: nowrap; position: relative; }
  .ch { display: inline-block; }
  .hand-underline {
    position: absolute;
    left: -2%;
    bottom: -0.02em;
    width: 100%;
    height: 0.16em;
    overflow: visible;
    fill: none;
    stroke: var(--color-ginster);
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rise {
      animation: hero-rise 800ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 0s) + var(--t-after));
    }
    /* each letter is wiped in left to right, like a marker stroke */
    :global(html.js) .ch {
      animation: write-letter 150ms linear both;
      animation-delay: calc(var(--t-claim) + var(--cd));
    }
    :global(html.js) .hand-underline path {
      animation: underline 650ms var(--ease-draw) both;
      animation-delay: calc(var(--t-after) - 0.05s);
    }
    .pins :global(.pin-a) { --pin-d: var(--t-images); }
    .pins :global(.pin-b) { --pin-d: calc(var(--t-images) + 0.15s); }
    .pins :global(.pin-c) { --pin-d: calc(var(--t-images) + 0.3s); }
    :global(html.js) .pins :global(.pin) {
      animation: pin-in 700ms var(--ease-draw) both;
      animation-delay: var(--pin-d, 0.35s);
    }
    :global(html.js) .pins :global(.magnet) {
      animation: magnet-in 380ms var(--ease-draw) both;
      animation-delay: calc(var(--pin-d, 0.35s) + 0.42s);
    }
    :global(html.js) .note {
      animation: note-in 700ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
    }
    :global(html.js) .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 700ms var(--ease-draw) both;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
    }
    :global(html.js) .draw.dashed {
      stroke-dasharray: 0.02 0.025;
      stroke-dashoffset: 0;
      animation: fade 600ms ease forwards;
      animation-delay: calc(var(--d, 1s) + var(--t-notes));
      opacity: 0;
    }
  }

  @keyframes write-letter {
    from { clip-path: inset(-1em 100% -1em -1em); }
    to { clip-path: inset(-1em -1em -1em -1em); }
  }
  @keyframes underline {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pin-in {
    from { opacity: 0; translate: 0 8px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes magnet-in {
    from { opacity: 0; scale: 0.6; }
    to { opacity: 1; scale: 1; }
  }
  @keyframes note-in {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  /* Hidden until its turn: dash rounding on non-scaling strokes would otherwise leave visible fragments. */
  @keyframes draw {
    from { stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes fade { to { opacity: 1; } }
</style>
