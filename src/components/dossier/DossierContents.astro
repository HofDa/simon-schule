---
import { getProjects } from '../../data/projects';
import { asset } from '../../lib/paths';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('de');
const projects = getProjects('de');
const widths = [480, 720, 960];
const image = (file: string, width: number) => asset(`images/projects/${file}-${width}.webp`);
---

<section id="leistungen" class="positions" aria-labelledby="positions-title">
  <div class="shell">
    <div class="section-head">
      <p class="folio">BLATT 02 <span aria-hidden="true">/</span> LEISTUNGEN</p>
      <h2 id="positions-title">Von der Idee<br />bis zum Raum.</h2>
      <p>{t.services.intro}</p>
    </div>
    <ol class="position-list">
      {t.services.items.map((item, index) => (
        <li class="position">
          <span class="position-no tnum">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="position-mark" aria-hidden="true">↗</span>
        </li>
      ))}
    </ol>
    <a class="next-sheet" href="#projekte"><span>Zum Anhang: Raumbeispiele</span><span aria-hidden="true">↓</span></a>
  </div>
</section>

<section id="projekte" class="annex" aria-labelledby="annex-title">
  <div class="shell">
    <div class="annex-head">
      <p class="folio">ANHANG A <span aria-hidden="true">/</span> RAUMBEISPIELE</p>
      <h2 id="annex-title">Räume, die sich verändern.</h2>
      <p>{t.projects.sub}</p>
    </div>
    <div class="annex-list">
      {projects.map((project, index) => (
        <article class="annex-item">
          <div class="annex-image">
            <img
              src={image(project.images[0].file, 960)}
              srcset={widths.map((width) => `${image(project.images[0].file, width)} ${width}w`).join(', ')}
              sizes="(max-width: 800px) calc(100vw - 40px), 55vw"
              alt={project.images[0].alt}
              width="960"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="annex-info">
            <p class="annex-no tnum">ANLAGE A.{String(index + 1).padStart(2, '0')}</p>
            <h3>{project.title}</h3>
            {project.placeholder && <p class="annex-status">{t.projects.placeholder}</p>}
            <p class="annex-desc">{project.description}</p>
            <dl>
              <div><dt>{t.projects.meta.type}</dt><dd>{project.type}</dd></div>
              <div><dt>{t.projects.meta.services}</dt><dd>{project.services.join(' · ')}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .positions { background: var(--color-paper); padding-block: clamp(90px, 12vw, 170px); }
  .folio { font-size: .78rem; font-weight: 750; letter-spacing: .11em; }
  .folio span { margin-inline: .5em; }
  .section-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 60px; margin-bottom: clamp(50px, 8vw, 100px); }
  .section-head .folio { grid-column: 1 / -1; }
  .section-head h2, .annex-head h2 { max-width: 13ch; font-size: clamp(3rem, 6.2vw, 6.5rem); line-height: .95; letter-spacing: -.06em; font-weight: 780; }
  .section-head > p:last-child { align-self: end; max-width: 42ch; font-size: var(--text-lead); line-height: 1.5; }
  .position-list { border-top: 2px solid var(--color-ink); }
  .position { display: grid; grid-template-columns: 70px minmax(180px, .75fr) minmax(0, 1fr) 28px; gap: 24px; align-items: baseline; padding-block: clamp(28px, 4vw, 52px); border-bottom: 1.5px solid var(--color-ink); }
  .position-no { font-size: .82rem; font-weight: 750; }
  .position h3 { font-size: clamp(2rem, 4vw, 4.25rem); line-height: 1; letter-spacing: -.055em; font-weight: 760; }
  .position p { max-width: 46ch; line-height: 1.55; font-size: var(--text-body); }
  .position-mark { align-self: start; font-size: 1.5rem; }
  .next-sheet { display: flex; justify-content: space-between; padding-block: 20px; font-size: .8rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .next-sheet:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; }
  .annex { background: var(--color-ink); color: var(--color-paper); padding-block: clamp(90px, 12vw, 170px); }
  .annex-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 60px; margin-bottom: clamp(54px, 7vw, 90px); }
  .annex-head .folio { grid-column: 1 / -1; color: var(--color-ginster); }
  .annex-head h2 { max-width: 12ch; }
  .annex-head > p:last-child { align-self: end; max-width: 43ch; color: var(--color-on-ink); font-size: var(--text-lead); line-height: 1.5; }
  .annex-item { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); padding-block: clamp(32px, 5vw, 64px); border-top: 1.5px solid var(--color-paper); }
  .annex-item:last-child { border-bottom: 1.5px solid var(--color-paper); }
  .annex-image { align-self: start; aspect-ratio: 3 / 2; overflow: hidden; }
  .annex-image img { width: 100%; height: 100%; object-fit: cover; }
  .annex-info { display: flex; flex-direction: column; align-items: start; }
  .annex-no { color: var(--color-ginster); font-size: .8rem; font-weight: 750; letter-spacing: .09em; }
  .annex-info h3 { margin-top: 24px; max-width: 15ch; font-size: clamp(2rem, 3.6vw, 3.8rem); line-height: 1.03; letter-spacing: -.05em; font-weight: 750; }
  .annex-status { margin-top: 18px; padding: 6px 9px; border: 1px solid var(--color-on-ink); font-size: .72rem; letter-spacing: .04em; }
  .annex-desc { margin-top: 28px; max-width: 42ch; color: var(--color-on-ink); line-height: 1.5; }
  .annex-info dl { width: 100%; margin-top: auto; padding-top: 36px; font-size: .8rem; }
  .annex-info dl div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; padding-block: 10px; border-top: 1px solid var(--color-ink-line); }
  .annex-info dl div:last-child { border-bottom: 1px solid var(--color-ink-line); }
  .annex-info dt { color: var(--color-on-ink); }
  @media (max-width: 800px) {
    .section-head, .annex-head, .annex-item { grid-template-columns: 1fr; }
    .position { grid-template-columns: 40px minmax(0, 1fr) 24px; gap: 10px 16px; }
    .position p { grid-column: 2 / 3; }
    .position-mark { grid-column: 3; grid-row: 1; }
    .annex-info dl { margin-top: 0; }
  }
  @media (max-width: 460px) {
    .position h3 { font-size: 2rem; }
    .annex-info h3 { margin-top: 14px; }
  }
</style>
