---
import { getClosingTestimonial } from '../data/projects';
import { getLang, useTranslations } from '../i18n/ui';

/** The one strong quote before the contact scene. Renders nothing until a quote is approved. */
const lang = getLang(Astro.currentLocale);
const q = useTranslations(lang).quotes;
const t = getClosingTestimonial(lang);
---

{t && (
  <section class="closing flex min-h-[64vh] items-center py-28" aria-label={q.closingLabel}>
    <div class="shell">
      <figure class="m-0 lg:ml-[calc(100%/12)] lg:max-w-[calc(100%/12*9)]">
        <svg class="mb-10 h-7 w-9" viewBox="0 0 36 28" aria-hidden="true"><path d="M0 28V16C0 7 5 1.5 14 0l1.5 3.5C10 5 7.5 8.5 7.5 13H14v15H0Zm21 0V16c0-9 5-14.5 14-16l1 3.5c-5.5 1.5-8 5-8 9.5H35v15H21Z" fill="var(--color-ginster)" /></svg>
        <blockquote class="m-0">
          <p class="text-headline font-medium leading-[1.08] tracking-[-0.04em]">
            {t.quote}
          </p>
        </blockquote>
        <figcaption class="mt-10 flex flex-wrap gap-x-3 gap-y-1 text-meta">
          <span class="font-semibold">{t.author}</span>
          {t.role && <span class="text-muted">{t.role}</span>}
          {t.organisation && <span class="text-muted">{t.organisation}</span>}
        </figcaption>
      </figure>
    </div>
  </section>
)}
