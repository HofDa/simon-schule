---
/**
 * A person on a ginstergelb VS Hokki stool, drawn as an architectural scale
 * figure in three frames (side, three-quarter, front). The contact scene
 * cross-fades between the frames with scroll. Replace with a photo frame
 * sequence (simon-rene-contact-frame-XX.webp) once it has been shot.
 */
interface Props {
  id: string;
  /** Face left instead of right in the side and three-quarter frames. */
  mirror?: boolean;
  label: string;
  class?: string;
}
const { id, mirror = false, label, class: className = '' } = Astro.props;
const flip = mirror ? 'translate(340 0) scale(-1 1)' : undefined;
const ink = '#20201D';
const far = '#4A4944';
---

<svg class={className} viewBox="0 -60 340 480" role="img" aria-label={label}>
  <defs>
    <linearGradient id={`${id}-col`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#C98F00" />
      <stop offset="0.4" stop-color="#E8AB0A" />
      <stop offset="1" stop-color="#C08900" />
    </linearGradient>
    <filter id={`${id}-blur`} x="-30%" y="-300%" width="160%" height="700%">
      <feGaussianBlur stdDeviation="6" />
    </filter>
  </defs>

  <ellipse cx="170" cy="408" rx="96" ry="9" fill={ink} opacity="0.16" filter={`url(#${id}-blur)`} />

  <!-- Hokki stool -->
  <g>
    <path d="M110 404 C110 382 132 370 170 370 C208 370 230 382 230 404 C212 410 128 410 110 404 Z" fill="#C88F00" />
    <path d="M136 280 C146 312 150 334 140 374 L200 374 C190 334 194 312 204 280 Z" fill={`url(#${id}-col)`} />
    <path d="M108 256 L108 274 C108 284 136 292 170 292 C204 292 232 284 232 274 L232 256 Z" fill="#D49800" />
    <ellipse cx="170" cy="256" rx="62" ry="13" fill="#F0B82A" />
  </g>

  <g fill="none" stroke-linecap="round" stroke={ink}>
    <g class="pose" data-pose="side" transform={flip}>
      <path d="M166 238 L176 74" stroke-width="50" />
      <circle cx="186" cy="12" r="27" fill={ink} stroke="none" />
      <path d="M170 244 L298 250" stroke-width="36" />
      <path d="M298 250 L302 388" stroke-width="28" />
      <path d="M302 397 L326 399" stroke-width="16" />
      <path d="M182 98 L206 190" stroke-width="22" />
      <path d="M206 190 L268 232" stroke-width="20" />
    </g>

    <g class="pose" data-pose="quarter" transform={flip}>
      <g stroke={far}>
        <path d="M184 240 L262 236" stroke-width="32" />
        <path d="M262 236 L272 384" stroke-width="26" />
        <path d="M272 391 L292 393" stroke-width="15" />
        <path d="M192 98 L214 186" stroke-width="20" />
        <path d="M214 186 L258 226" stroke-width="18" />
      </g>
      <path d="M168 238 L172 74" stroke-width="54" />
      <circle cx="178" cy="10" r="27" fill={ink} stroke="none" />
      <path d="M160 246 L238 262" stroke-width="36" />
      <path d="M238 262 L242 390" stroke-width="28" />
      <path d="M242 398 L262 401" stroke-width="16" />
      <path d="M154 98 L166 194" stroke-width="22" />
      <path d="M166 194 L230 246" stroke-width="20" />
    </g>

    <g class="pose" data-pose="front">
      <path d="M170 238 L170 74" stroke-width="58" />
      <circle cx="170" cy="8" r="28" fill={ink} stroke="none" />
      <path d="M152 242 L134 268" stroke-width="36" />
      <path d="M188 242 L206 268" stroke-width="36" />
      <path d="M134 268 L128 390" stroke-width="28" />
      <path d="M206 268 L212 390" stroke-width="28" />
      <path d="M124 399 L132 400" stroke-width="18" />
      <path d="M216 399 L208 400" stroke-width="18" />
      <path d="M140 98 L124 190" stroke-width="22" />
      <path d="M124 190 L136 254" stroke-width="20" />
      <path d="M200 98 L216 190" stroke-width="22" />
      <path d="M216 190 L204 254" stroke-width="20" />
    </g>
  </g>
</svg>
