---
/**
 * Abstract front silhouette of the VS PantoSwing shell: broad, almost flat top
 * with the round grip hole, a narrow waist and the seat flaring out to a straight front edge.
 * The front edge is drawn flush with the bottom of the viewBox so the
 * Leistungen column can continue it as plan lines.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 400 260" role="img" aria-label="Silhouette eines ginstergelben PantoSwing-Schulstuhls von VS">
  <path
    fill="#E2A300"
    fill-rule="evenodd"
    d="M60 16
       C140 22 260 22 340 16
       C356 15 366 22 366 36
       L364 100
       C362 140 332 160 302 176
       C274 190 264 206 270 222
       C278 238 330 244 400 248
       L400 260 L0 260 L0 248
       C70 244 122 238 130 222
       C136 206 126 190 98 176
       C68 160 38 140 36 100
       L34 36
       C34 22 44 15 60 16 Z
       M222 84 A22 22 0 1 0 178 84 A22 22 0 1 0 222 84 Z"
  />
</svg>
