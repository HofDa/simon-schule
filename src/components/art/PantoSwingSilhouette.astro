---
/**
 * Flat front view of the VS PantoSwing in ginstergelb: wide shell with the
 * round grip hole, narrow waist, seat with a curved front edge, and the two
 * tubular legs bending out from under the seat (no crossbar). The legs end
 * vertically at the bottom edge of the viewBox (centred on x = 5 and x = 395,
 * 10 units wide) so the Leistungen column can continue them as lines.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 400 330" role="img" aria-label="Ginstergelber PantoSwing-Schulstuhl von VS, Vorderansicht">
