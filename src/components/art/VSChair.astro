---
/**
 * Schematic ginstergelb VS school chair (cantilever shell with grip slot).
 * Stand-in until a cut-out product photo (vs-pantoswing-ginstergelb.webp) exists.
 */
interface Props {
  id: string;
  class?: string;
  shadow?: boolean;
}
const { id, class: className = '', shadow = true } = Astro.props;
---

<svg class={className} viewBox="0 0 400 720" role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>Ginstergelber Schulstuhl von VS (schematische Darstellung)</title>
  <defs>
    <linearGradient id={`${id}-face`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EDB21C" />
      <stop offset="0.55" stop-color="#E2A300" />
      <stop offset="1" stop-color="#D49800" />
    </linearGradient>
    <radialGradient id={`${id}-hollow`} cx="0.5" cy="0.62" r="0.55">
      <stop offset="0" stop-color="#C98F00" stop-opacity="0.45" />
      <stop offset="1" stop-color="#C98F00" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-seat`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D59A00" />
      <stop offset="1" stop-color="#F0B82A" />
    </linearGradient>
    <linearGradient id={`${id}-tube`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#6F6E69" />
      <stop offset="0.45" stop-color="#C9C8C2" />
      <stop offset="1" stop-color="#7C7B76" />
    </linearGradient>
    <linearGradient id={`${id}-side`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#FFE39A" stop-opacity="0.45" />
      <stop offset="0.22" stop-color="#FFE39A" stop-opacity="0" />
      <stop offset="0.7" stop-color="#8A6000" stop-opacity="0" />
      <stop offset="1" stop-color="#8A6000" stop-opacity="0.28" />
    </linearGradient>
    <filter id={`${id}-blur`} x="-20%" y="-200%" width="140%" height="500%">
      <feGaussianBlur stdDeviation="7" />
    </filter>
  </defs>

  {shadow && (
    <g class="chair-shadow">
      <ellipse cx="200" cy="700" rx="175" ry="13" fill="#20201D" opacity="0.14" filter={`url(#${id}-blur)`} />
      <ellipse cx="200" cy="699" rx="120" ry="5" fill="#20201D" opacity="0.12" filter={`url(#${id}-blur)`} />
    </g>
  )}

  <!-- cantilever frame, rear runners first -->
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M128 648 L150 626" stroke="#8B8A85" stroke-width="9" />
    <path d="M272 648 L250 626" stroke="#8B8A85" stroke-width="9" />
    <path d="M150 626 L250 626" stroke="#7B7A75" stroke-width="8" />
    <path d="M120 500 L280 500" stroke="#6F6E69" stroke-width="10" />
    <path d="M104 494 C92 560 84 630 80 684 L128 648" stroke={`url(#${id}-tube)`} stroke-width="12" />
    <path d="M296 494 C308 560 316 630 320 684 L272 648" stroke={`url(#${id}-tube)`} stroke-width="12" />
    <path d="M100 520 C92 580 86 640 83 680" stroke="#EDEDEA" stroke-width="2" opacity="0.7" />
    <path d="M300 520 C308 580 314 640 317 680" stroke="#EDEDEA" stroke-width="2" opacity="0.5" />
    <!-- floor glides -->
    <path d="M74 686 L88 686" stroke="#20201D" stroke-width="7" />
    <path d="M312 686 L326 686" stroke="#20201D" stroke-width="7" />
  </g>

  <!-- shell thickness (edge) -->
  <path
    d="M64 86 C64 44 104 26 200 26 C296 26 336 44 336 86 L336 206 C332 268 308 314 294 362 C322 384 346 410 350 444 C354 472 330 494 284 498 L116 498 C70 494 46 472 50 444 C54 410 78 384 108 362 C92 314 68 268 64 206 Z"
    fill="#B88400"
  />

  <!-- backrest face with grip slot -->
  <path
    fill-rule="evenodd"
    fill={`url(#${id}-face)`}
    d="M60 80 C60 40 100 20 200 20 C300 20 340 40 340 80 L334 200 C330 262 306 310 292 356 L108 356 C94 310 70 262 66 200 Z
       M170 64 L230 64 A14 14 0 0 1 230 92 L170 92 A14 14 0 0 1 170 64 Z"
  />
  <path d="M60 80 C60 40 100 20 200 20 C300 20 340 40 340 80 L334 200 C330 262 306 310 292 356 L108 356 C94 310 70 262 66 200 Z" fill={`url(#${id}-hollow)`} />
  <path d="M60 80 C60 40 100 20 200 20 C300 20 340 40 340 80 L334 200 C330 262 306 310 292 356 L108 356 C94 310 70 262 66 200 Z" fill={`url(#${id}-side)`} />
  <!-- inner edge of grip slot -->
  <path d="M170 92 L230 92 A14 14 0 0 0 243 84" fill="none" stroke="#B88400" stroke-width="3" stroke-linecap="round" />
  <!-- top rim highlight -->
  <path d="M84 52 C112 34 160 28 200 28 C240 28 288 34 316 52" fill="none" stroke="#F6CC55" stroke-width="3" stroke-linecap="round" opacity="0.8" />

  <!-- seat -->
  <path
    fill={`url(#${id}-seat)`}
    d="M108 352 C80 376 58 406 54 436 C52 458 70 472 112 476 L288 476 C330 472 348 458 346 436 C342 406 320 376 292 352 Z"
  />
  <!-- front roll -->
  <path
    fill="#C88F00"
    d="M54 436 C50 468 78 492 120 494 L280 494 C322 492 350 468 346 436 C348 460 330 474 288 478 L112 478 C70 474 52 460 54 436 Z"
  />
  <path d="M112 477 L288 477" stroke="#F6CC55" stroke-width="2" opacity="0.6" />
</svg>
