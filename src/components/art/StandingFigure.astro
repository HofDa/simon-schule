---
/** Standing scale figure used as a portrait stand-in until photos exist. */
interface Props {
  class?: string;
  label: string;
}
const { class: className = '', label } = Astro.props;
---

<svg class={className} viewBox="0 0 200 520" role="img" aria-label={label}>
  <g fill="none" stroke="currentColor" stroke-linecap="round">
    <circle cx="100" cy="40" r="30" fill="currentColor" stroke="none" />
    <path d="M100 112 L100 262" stroke-width="62" />
    <path d="M86 276 L80 492" stroke-width="32" />
    <path d="M114 276 L120 492" stroke-width="32" />
    <path d="M62 120 L50 214 L58 300" stroke-width="22" stroke-linejoin="round" />
    <path d="M138 120 L150 214 L142 300" stroke-width="22" stroke-linejoin="round" />
    <path d="M70 506 L88 506" stroke-width="18" />
    <path d="M112 506 L130 506" stroke-width="18" />
  </g>
</svg>
